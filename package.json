{
  "name": "elysia-blog-theme",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "check": "astro check",
    "new:post": "node scripts/new-post.mjs",
    "preview": "astro preview",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "pnpm check && pnpm build && pnpm verify:build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ma-shan-zheng": "^5.3.0",
    "@lucide/astro": "^1.27.0",
    "astro": "^7.1.5",
    "katex": "^0.16.22",
    "photoswipe": "5.4.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "1.5.2",
    "parse5": "7.3.0",
    "typescript": "^5.9.3"
  }
}
