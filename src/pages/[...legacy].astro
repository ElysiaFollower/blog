---
import { legacyRoutes } from "../config/legacy-routes";

export function getStaticPaths() {
  return legacyRoutes.map((route) => ({
    params: { legacy: route.source },
    props: { destination: route.destination },
  }));
}

const { destination } = Astro.props;
const canonicalUrl = new URL(destination, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={canonicalUrl} />
    <title>页面已搬家</title>
  </head>
  <body>
    <main>
      <p>这篇内容换了地址。</p>
      <a href={destination}>继续阅读</a>
    </main>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    display: grid;
    min-height: 100vh;
    margin: 0;
    place-items: center;
    background: #fafafd;
    color: #202027;
    font-family:
      ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI",
      "PingFang SC", sans-serif;
  }

  main {
    padding: 28px;
    border-left: 4px solid #df4d7d;
  }

  p {
    margin: 0 0 12px;
    font-size: 1.1rem;
  }

  a {
    color: inherit;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
</style>
