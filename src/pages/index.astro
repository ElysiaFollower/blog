---
import { Image } from "astro:assets";
import { ArrowUpRight, BookOpenText } from "@lucide/astro";
import atmosphereImage from "../assets/demo/hero-day.png";
import graphicImage from "../assets/demo/elysia-logo.png";
import hybridImage from "../assets/demo/hero-night.jpg";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const concepts = [
  {
    key: "A",
    title: "氛围型",
    subtitle: "Atmosphere",
    href: "/concepts/atmosphere/",
    image: atmosphereImage,
    position: "center",
  },
  {
    key: "B",
    title: "图形型",
    subtitle: "Graphic",
    href: "/concepts/graphic/",
    image: graphicImage,
    position: "center 42%",
  },
  {
    key: "C",
    title: "混合型",
    subtitle: "Hybrid",
    href: "/concepts/hybrid/",
    image: hybridImage,
    position: "center",
  },
] as const;
---

<BaseLayout
  title="设计方向"
  description="博客主题的三个首页设计方向与文章阅读原型。"
  bodyClass="design-lab-page"
  noIndex
>
  <SiteHeader variant="reading" />
  <main id="main-content">
    <header class="design-lab__header page-width">
      <p>DESIGN STUDY // 01</p>
      <h1>首页方向</h1>
      <span>同一组内容，三种导演方式。</span>
    </header>

    <section class="design-lab__concepts page-width" aria-label="首页设计方向">
      {
        concepts.map((concept) => (
          <a class="design-lab__concept" href={concept.href}>
            <div class="design-lab__image">
              <Image
                src={concept.image}
                alt=""
                widths={[540, 810, 1080]}
                sizes="(max-width: 760px) 100vw, 40vw"
                loading="eager"
                style={`object-position: ${concept.position}`}
              />
            </div>
            <div class="design-lab__label">
              <span>{concept.key}</span>
              <div>
                <strong>{concept.title}</strong>
                <small>{concept.subtitle}</small>
              </div>
              <ArrowUpRight aria-hidden="true" size={22} stroke-width={1.8} />
            </div>
          </a>
        ))
      }
    </section>

    <section class="design-lab__reading">
      <div class="page-width">
        <BookOpenText aria-hidden="true" size={28} stroke-width={1.6} />
        <div>
          <span>READING PROTOTYPE</span>
          <h2>文章页独立于展示方向</h2>
        </div>
        <a href="/posts/image-format-parsing/">
          打开文章
          <ArrowUpRight aria-hidden="true" size={19} stroke-width={1.8} />
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .design-lab-page {
    background: var(--color-bg);
  }

  .design-lab__header {
    display: grid;
    padding-block: clamp(58px, 9vw, 110px);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 12px 32px;
  }

  .design-lab__header p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .design-lab__header h1 {
    margin: 0;
    font-family: var(--font-reading);
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    line-height: 0.9;
  }

  .design-lab__header > span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .design-lab__concepts {
    display: grid;
    padding-bottom: clamp(70px, 10vw, 130px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .design-lab__concept {
    min-width: 0;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .design-lab__concept:hover {
    box-shadow: 8px 8px 0 var(--color-rose);
    transform: translate(-3px, -3px);
  }

  .design-lab__image {
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .design-lab__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .design-lab__concept:hover .design-lab__image :global(img) {
    transform: scale(1.035);
  }

  .design-lab__label {
    display: grid;
    min-height: 86px;
    padding: 16px;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    border-top: 1px solid var(--color-line);
  }

  .design-lab__label > span {
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 850;
  }

  .design-lab__label > div {
    display: grid;
  }

  .design-lab__label strong {
    font-size: 1rem;
  }

  .design-lab__label small {
    color: var(--color-muted);
    font-size: 0.7rem;
  }

  .design-lab__reading {
    padding-block: clamp(50px, 8vw, 86px);
    border-block: 1px solid var(--color-line);
    background: var(--color-surface-soft);
  }

  .design-lab__reading > div {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 22px;
  }

  .design-lab__reading span {
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 850;
  }

  .design-lab__reading h2 {
    margin: 4px 0 0;
    font-family: var(--font-reading);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
  }

  .design-lab__reading a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .design-lab__concepts {
      grid-template-columns: 1fr;
    }

    .design-lab__image {
      aspect-ratio: 16 / 9;
    }

    .design-lab__header {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .design-lab__reading > div {
      grid-template-columns: auto 1fr;
    }

    .design-lab__reading a {
      grid-column: 2;
    }
  }
</style>
