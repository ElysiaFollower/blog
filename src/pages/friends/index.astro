---
import { ArrowUpRight } from "@lucide/astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const links = [
  {
    title: "ElysiaFollower",
    description: "开源项目与实验代码。",
    href: "https://github.com/ElysiaFollower",
    label: "GitHub",
  },
  {
    title: "Academic",
    description: "研究经历、发表与学术信息。",
    href: "/Academic/",
    label: "Academic page",
  },
  {
    title: "旧航行日志",
    description: "主题重构前的博客现场。",
    href: "https://elysiafollower.github.io/",
    label: "Archive",
  },
];
---

<BaseLayout
  title="友链"
  description="沿途遇见的人与站点。"
  bodyClass="friends-page"
>
  <SiteHeader variant="reading" />
  <main id="main-content">
    <header class="friends-header page-width">
      <p>LINKS // SIGNALS</p>
      <h1>友链</h1>
      <span>沿途遇见的人与站点。</span>
    </header>

    <section class="friends-list page-width" aria-label="友链列表">
      {
        links.map((link, index) => (
          <a href={link.href}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <small>{link.label}</small>
              <h2>{link.title}</h2>
              <p>{link.description}</p>
            </div>
            <ArrowUpRight aria-hidden="true" size={24} stroke-width={1.7} />
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .friends-header {
    display: grid;
    padding-block: clamp(58px, 9vw, 110px);
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 12px 32px;
    border-bottom: 1px solid var(--color-line);
  }

  .friends-header p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .friends-header h1 {
    margin: 0;
    font-family: var(--font-reading);
    font-size: clamp(3.7rem, 10vw, 8rem);
    line-height: 0.9;
  }

  .friends-header span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .friends-list {
    padding-block: clamp(34px, 7vw, 84px) 120px;
  }

  .friends-list > a {
    display: grid;
    min-height: 150px;
    padding: 26px 0;
    grid-template-columns: 60px minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
  }

  .friends-list > a > span {
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 850;
  }

  .friends-list small {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.67rem;
  }

  .friends-list h2 {
    margin: 4px 0;
    font-family: var(--font-reading);
    font-size: clamp(1.45rem, 3vw, 2.2rem);
  }

  .friends-list p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .friends-list > a:hover h2 {
    color: var(--color-rose);
  }

  @media (max-width: 600px) {
    .friends-header {
      grid-template-columns: 1fr;
    }

    .friends-list > a {
      grid-template-columns: 34px minmax(0, 1fr) auto;
      gap: 12px;
    }
  }
</style>
