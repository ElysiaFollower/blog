---
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import DirectedPointer from "../../components/DirectedPointer.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { friendLinks } from "../../config/friends";
import BaseLayout from "../../layouts/BaseLayout.astro";

const linkCount = String(friendLinks.length);
---

<BaseLayout
  title="友链"
  description="沿着这些链接，可以抵达一些很有意思的人"
  bodyClass="friends-page"
  directedPointer
>
  <SiteHeader variant="reading" />
  <main id="main-content">
    <header class="friends-introduction page-width">
      <div><p>BLOGROLL / {linkCount.padStart(2,"0")}</p><h1 id="friends-title">互联网上的<br /><span>邻居们。</span></h1></div>
      <div class="friends-introduction__note"><span>{linkCount.padStart(2,"0")}</span><div><small>PERSONAL WEBSITES</small><p>一些常去的小站，<br />和认真写作的人。<br />路过时，不妨进去坐坐。</p></div></div>
    </header>
    <section id="received-signals" class="friends-signals">
      <div class="page-width">
        <div class="friends-list" aria-label="友链列表">
          {
            friendLinks.map((link, index) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                data-reveal
                data-reveal-delay={String(Math.min(index, 2))}
              >
                <span class="friends-list__index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <figure class="friends-list__avatar" aria-hidden="true">
                  {
                    link.avatar ? (
                      <Image
                        src={link.avatar}
                        alt=""
                        widths={[128, 256]}
                        sizes="(max-width: 600px) 72px, (max-width: 900px) 108px, 148px"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span>{link.title.slice(0, 1).toUpperCase()}</span>
                    )
                  }
                </figure>
                <div class="friends-list__identity">
                  <small>{link.label}</small>
                  <h3>{link.title}</h3>
                </div>
                <div class="friends-list__note">
                  <p>{link.description}</p>
                  <small>{new URL(link.href).host}</small>
                </div>
                <ArrowUpRight aria-hidden="true" size={28} stroke-width={1.6} />
              </a>
            ))
          }
        </div>

        <footer class="friends-signals__footer" data-reveal>
          <span>MORE FRIENDS MAY JOIN</span>
          <p>期待下一次偶然的邂逅。</p>
        </footer>
      </div>
    </section>
  </main>

  <SiteFooter />
  <DirectedPointer />
  <ScrollReveal />
</BaseLayout>

<style>
  .friends-introduction {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 70px;
    align-items: end;
    padding-block: 80px 90px;
  }

  .friends-introduction > div > p {
    color: var(--color-rose);
    margin: 0 0 28px;
    font: .65rem var(--font-mono);
    letter-spacing: .14em;
  }

  h1 {
    margin: 0;
    font: 400 clamp(3rem,6vw,6rem)/1.25 var(--font-reading);
    letter-spacing: -.04em;
  }

  h1 span {
    margin-left: 1em;
  }

  .friends-introduction > p {
    max-width: 400px;
    margin: 0 0 12px;
    color: var(--color-muted);
    line-height: 2;
    font-size: .9rem;
  }

  .friends-signals {
    padding-bottom: 110px;
  }

  .friends-list {
    border-top: 1px solid var(--color-line);
  }

  .friends-list > a {
    display: grid;
    grid-template-columns: 40px 140px minmax(0,.8fr) minmax(0,1fr) 28px;
    align-items: center;
    gap: 34px;
    padding: 44px 8px;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    transition: background 240ms;
  }

  .friends-list > a:hover {
    background: var(--art-paper);
  }

  .friends-list__index {
    color: var(--color-rose);
    font: italic 1rem var(--font-reading);
  }

  .friends-list__avatar {
    margin: 0;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-surface-soft);
    overflow: hidden;
  }

  .friends-list__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms var(--ease-art);
  }

  .friends-list > a:hover img {
    transform: scale(1.06);
  }

  .friends-list__avatar > span {
    display: grid;
    height: 100%;
    place-items: center;
    font: 3rem var(--font-reading);
  }

  .friends-list small {
    font: .62rem var(--font-mono);
    color: var(--color-muted);
  }

  .friends-list__identity h3 {
    margin: 12px 0 0;
    font: 400 clamp(2.4rem,4vw,4rem)/1.2 var(--font-reading);
    overflow-wrap: anywhere;
  }

  .friends-list__note p {
    margin: 0 0 16px;
    font-size: .9rem;
    line-height: 1.9;
  }

  .friends-signals__footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 28px;
    color: var(--color-muted);
    font: .65rem/1.8 var(--font-mono);
  }

  .friends-signals__footer p {
    margin: 0;
  }

  @media (max-width:900px) {
    .friends-list > a {
      grid-template-columns: 28px 100px minmax(0,1fr) minmax(0,1fr) 24px;
      gap: 20px;
    }

  }

  @media (max-width:620px) {
    .friends-introduction {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 50px;
    }

    h1 {
      font-size: clamp(2.7rem,12vw,4rem);
    }

    .friends-introduction > p {
      font-size: .8rem;
    }

    .friends-list > a {
      grid-template-columns: 70px minmax(0,1fr) 24px;
      align-items: start;
      gap: 18px;
      padding-block: 30px;
    }

    .friends-list__index {
      display: none;
    }

    .friends-list__identity h3 {
      font-size: 2.3rem;
    }

    .friends-list__note {
      grid-column: 2/-1;
    }

    .friends-list > a > :global(svg) {
      grid-row: 1;
      grid-column: 3;
    }

    .friends-signals__footer {
      display: block;
    }

    .friends-signals__footer p {
      margin-top: 12px;
    }

  }
  .friends-introduction__note { display: flex; align-items: center; gap: 26px; }
  .friends-introduction__note > span { font: italic 5rem/1 var(--font-reading); color: var(--color-cyan); }
  .friends-introduction__note small { font: .65rem var(--font-mono); color: var(--color-cyan); letter-spacing: .1em; }
  .friends-introduction__note p { margin: 14px 0 0; color: var(--color-muted); font: 1rem/1.95 var(--font-reading); }
  @media (min-width: 1024px) {
    :global(.friends-page) {
      background: var(--paper-cyan);
    }

    .friends-introduction {
      grid-template-columns: 1.2fr 1fr;
      gap: 140px;
      padding-block: 68px 70px;
      align-items: center;
    }

    .friends-introduction h1 {
      font-size: var(--type-page-title);
      line-height: 1.22;
      letter-spacing: -.04em;
    }

    .friends-introduction h1 > span {
      margin-left: 1em;
      color: var(--color-cyan);
    }

    .friends-introduction > div > p {
      color: var(--color-cyan);
      font-size: .7rem;
      letter-spacing: .1em;
    }

    .friends-introduction__note {
      position: relative;
      align-items: start;
      gap: 28px;
      padding: 34px;
      background: var(--paper-white);
      border: 1px solid color-mix(in srgb,var(--color-cyan) 20%,transparent);
      transform: rotate(3deg);
      box-shadow: 10px 12px 0 color-mix(in srgb,var(--color-cyan) 6%,transparent);
    }

    .friends-introduction__note::before {
      content: "";
      position: absolute;
      width: 64px;
      height: 18px;
      background: color-mix(in srgb,var(--color-gold) 20%,transparent);
      top: -8px;
      left: 42%;
      transform: rotate(-5deg);
    }

    .friends-introduction__note > span {
      font-size: 4.5rem;
    }

    .friends-signals {
      padding-block: 10px 70px;
    }

    .friends-list {
      border-top: 0;
    }

    .friends-list > a {
      grid-template-columns: 40px 130px 1fr 1.15fr 40px;
      gap: 35px;
      padding: 38px 42px;
      background: var(--paper-white);
      border: 1px solid color-mix(in srgb,var(--color-cyan) 25%,transparent);
      border-left: 4px solid var(--color-cyan);
      box-shadow: 0 8px 30px #29423a07;
    }

    .friends-list > a + a {
      margin-top: 20px;
    }

    .friends-list > a:hover {
      background: color-mix(in srgb,var(--paper-white) 85%,var(--paper-cyan));
    }

    .friends-list__index {
      color: var(--color-cyan);
      font-size: 1.3rem;
    }

    .friends-list__avatar {
      border: 6px solid var(--paper-cyan);
      outline: 1px solid color-mix(in srgb,var(--color-cyan) 25%,transparent);
    }

    .friends-list__identity h3 {
      font-size: 2.9rem;
      margin-top: 12px;
    }

    .friends-list__note p {
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .friends-list small {
      font-size: .72rem;
      color: var(--color-cyan);
    }

    .friends-list > a > svg {
      color: var(--color-cyan);
      transition: transform 250ms;
    }

    .friends-list > a:hover > svg {
      transform: translate(4px,-4px);
    }

    .friends-signals__footer {
      padding-top: 32px;
      border: 0;
      color: var(--color-cyan);
    }

  }
</style>
