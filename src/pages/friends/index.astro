---
import { ArrowDownRight, ArrowUpRight, Radio, Sparkles } from "@lucide/astro";
import DirectedPointer from "../../components/DirectedPointer.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { friendLinks } from "../../config/friends";
import BaseLayout from "../../layouts/BaseLayout.astro";

const linkCount = String(friendLinks.length).padStart(2, "0");
---

<BaseLayout
  title="友链"
  description="沿途遇见的人与站点。"
  bodyClass="friends-page"
  directedPointer
>
  <SiteHeader variant="overlay" />
  <main id="main-content">
    <section class="friends-hero" aria-labelledby="friends-title">
      <div class="friends-hero__frame" aria-hidden="true"></div>
      <div class="friends-hero__inner page-width">
        <div class="friends-hero__copy">
          <p>
            <Radio aria-hidden="true" size={17} stroke-width={1.8} />
            EXTERNAL CHANNELS // {linkCount}
          </p>
          <h1 id="friends-title">
            <span>LINKS</span>
            <strong>&amp; SIGNALS</strong>
          </h1>
          <p class="friends-hero__intro">
            沿途遇见的人，以及他们认真维护的小小世界。
          </p>
          <a href="#received-signals">
            <span>读取外部信号</span>
            <ArrowDownRight aria-hidden="true" size={20} stroke-width={2} />
          </a>
        </div>

        <div class="friends-hero__signal" aria-hidden="true">
          <Sparkles size={30} stroke-width={1.4} />
          <span>RECEIVING</span>
          <strong>{linkCount}</strong>
          <small>KNOWN FREQUENCIES</small>
        </div>
      </div>
      <div class="friends-hero__footer">
        <span>CONNECTION IS A FORM OF MEMORY</span>
        <span>LOG 17 / RELAY</span>
      </div>
    </section>

    <section id="received-signals" class="friends-signals">
      <div class="page-width">
        <header class="friends-signals__header" data-reveal>
          <span>01 / RECEIVED SIGNALS</span>
          <h2>保持连接的<br />小小世界</h2>
          <p>
            名单不必很长。友链记录的不是数量，而是互联网中那些愿意持续表达、也值得再次造访的坐标。
          </p>
        </header>

        <div class="friends-list" aria-label="友链列表">
          {
            friendLinks.map((link, index) => (
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer"
                data-reveal
                data-reveal-delay={String(Math.min(index, 2))}
              >
                <span class="friends-list__index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="friends-list__identity">
                  <small>{link.label}</small>
                  <h3>{link.title}</h3>
                </div>
                <div class="friends-list__note">
                  <p>{link.description}</p>
                  <small>{new URL(link.href).host}</small>
                </div>
                <ArrowUpRight aria-hidden="true" size={28} stroke-width={1.6} />
              </a>
            ))
          }
        </div>

        <footer class="friends-signals__footer" data-reveal>
          <span>MORE SIGNALS MAY ARRIVE</span>
          <p>这份列表会随着真正的相遇慢慢生长。</p>
        </footer>
      </div>
    </section>
  </main>

  <SiteFooter />
  <DirectedPointer />
  <ScrollReveal />
</BaseLayout>

<style>
  .friends-page {
    background: var(--color-bg);
  }

  .friends-hero {
    position: relative;
    display: grid;
    height: min(78svh, 780px);
    min-height: 620px;
    overflow: hidden;
    background: #17151a;
    color: #fff;
    isolation: isolate;
  }

  .friends-hero::before,
  .friends-hero::after {
    position: absolute;
    z-index: -1;
    content: "";
  }

  .friends-hero::before {
    top: 20%;
    right: -7vw;
    width: min(44vw, 640px);
    aspect-ratio: 1;
    border: 1px solid #ffffff29;
    border-radius: 50%;
    box-shadow:
      0 0 0 64px #ffffff0a,
      0 0 0 128px #ffffff08;
  }

  .friends-hero::after {
    top: 0;
    left: 61%;
    width: 1px;
    height: 100%;
    background: #ffffff21;
  }

  .friends-hero__frame {
    position: absolute;
    inset: 86px var(--page-inline) 54px;
    border: 1px solid #ffffff63;
    pointer-events: none;
  }

  .friends-hero__frame::before,
  .friends-hero__frame::after {
    position: absolute;
    height: 8px;
    content: "";
  }

  .friends-hero__frame::before {
    top: -4px;
    left: 11%;
    width: 72px;
    background: #75d4d2;
  }

  .friends-hero__frame::after {
    right: 14%;
    bottom: -4px;
    width: 48px;
    background: #ff78a5;
  }

  .friends-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    padding: 118px 44px 90px;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.42fr);
    align-items: center;
    gap: 48px;
  }

  .friends-hero__copy > p:first-child {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 9px;
    margin: 0;
    color: #75d4d2;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 850;
  }

  .friends-hero h1 {
    margin: 24px 0 0;
    line-height: 0.82;
  }

  .friends-hero h1 span,
  .friends-hero h1 strong {
    display: block;
    letter-spacing: 0;
  }

  .friends-hero h1 span {
    font-family: var(--font-reading);
    font-size: clamp(4.2rem, 10vw, 9rem);
    font-weight: 500;
  }

  .friends-hero h1 strong {
    width: max-content;
    padding: 10px 16px 13px;
    margin-top: 16px;
    background: #efbd43;
    box-shadow: 9px 9px 0 #ff78a5;
    color: #17151a;
    font-size: clamp(2.2rem, 5vw, 4.8rem);
    line-height: 0.9;
  }

  .friends-hero__intro {
    max-width: 460px;
    margin: 34px 0 0;
    color: #d8cfd4;
    line-height: 1.8;
  }

  .friends-hero__copy > a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0 7px;
    margin-top: 22px;
    border-bottom: 2px solid currentColor;
    font-weight: 800;
    text-decoration: none;
  }

  .friends-hero__signal {
    display: grid;
    width: 210px;
    height: 210px;
    justify-self: center;
    place-content: center;
    border: 1px solid #ffffff59;
    border-radius: 50%;
    text-align: center;
  }

  .friends-hero__signal :global(svg) {
    margin: 0 auto 10px;
    color: #ff78a5;
  }

  .friends-hero__signal span,
  .friends-hero__signal small {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 800;
  }

  .friends-hero__signal strong {
    margin-block: 3px;
    font-size: 3.8rem;
    line-height: 1;
  }

  .friends-hero__signal small {
    color: #aaa0a6;
  }

  .friends-hero__footer {
    position: absolute;
    z-index: 2;
    right: calc(var(--page-inline) + 16px);
    bottom: 29px;
    left: calc(var(--page-inline) + 16px);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 800;
  }

  .friends-signals {
    padding-block: clamp(88px, 12vw, 156px) 120px;
  }

  .friends-signals__header {
    display: grid;
    margin-bottom: clamp(56px, 8vw, 96px);
    grid-template-columns: minmax(300px, 0.88fr) minmax(360px, 1.12fr);
    align-items: end;
    gap: 18px clamp(54px, 8vw, 120px);
  }

  .friends-signals__header > span {
    grid-column: 1 / -1;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .friends-signals__header h2 {
    margin: 0;
    font-family: var(--font-reading);
    font-size: clamp(3.2rem, 6.5vw, 6rem);
    line-height: 1;
  }

  .friends-signals__header p {
    max-width: 550px;
    margin: 0 0 8px;
    color: var(--color-muted);
    line-height: 1.9;
  }

  .friends-list {
    border-top: 1px solid var(--color-line);
  }

  .friends-list > a {
    position: relative;
    display: grid;
    min-height: 270px;
    padding: 42px 12px;
    grid-template-columns: 70px minmax(260px, 0.9fr) minmax(300px, 1.1fr) auto;
    align-items: center;
    gap: 34px;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
    transition:
      padding 220ms ease,
      background 220ms ease,
      color 220ms ease;
  }

  .friends-list > a:hover {
    padding-inline: 30px;
    background: #ff78a5;
    color: #17151a;
  }

  .friends-list__index,
  .friends-list small {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .friends-list__index {
    color: var(--color-rose);
  }

  .friends-list > a:hover .friends-list__index {
    color: #5c1b32;
  }

  .friends-list__identity h3 {
    margin: 8px 0 0;
    font-family: var(--font-reading);
    font-size: clamp(3.6rem, 7vw, 6.8rem);
    line-height: 0.9;
  }

  .friends-list__identity small,
  .friends-list__note small {
    color: var(--color-muted);
  }

  .friends-list > a:hover small {
    color: #4c2d38;
  }

  .friends-list__note p {
    margin: 0 0 16px;
    font-size: 1.05rem;
  }

  .friends-signals__footer {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    padding-top: 36px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .friends-signals__footer p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .friends-hero__inner {
      grid-template-columns: 1fr;
    }

    .friends-hero__signal {
      display: none;
    }

    .friends-signals__header {
      grid-template-columns: 1fr;
    }

    .friends-list > a {
      grid-template-columns: 48px minmax(200px, 0.8fr) minmax(220px, 1.2fr) auto;
      gap: 20px;
    }
  }

  @media (max-width: 600px) {
    .friends-hero {
      height: 82svh;
      min-height: 610px;
    }

    .friends-hero::after {
      left: 72%;
    }

    .friends-hero__frame {
      inset: 74px 14px 42px;
    }

    .friends-hero__inner {
      padding: 108px 0 74px;
    }

    .friends-hero h1 span {
      font-size: clamp(3.6rem, 19vw, 5.6rem);
    }

    .friends-hero h1 strong {
      padding: 8px 10px 10px;
      font-size: clamp(1.65rem, 9vw, 2.5rem);
    }

    .friends-hero__footer {
      right: 26px;
      bottom: 23px;
      left: 26px;
    }

    .friends-hero__footer span:last-child {
      display: none;
    }

    .friends-signals__header {
      margin-bottom: 44px;
    }

    .friends-signals__header h2 {
      font-size: 3rem;
    }

    .friends-list > a {
      min-height: 230px;
      padding: 30px 4px;
      grid-template-columns: 36px minmax(0, 1fr) auto;
      align-items: start;
      gap: 12px;
    }

    .friends-list > a:hover {
      padding-inline: 12px;
    }

    .friends-list__identity h3 {
      font-size: 3.7rem;
    }

    .friends-list__note {
      grid-column: 2 / -1;
    }

    .friends-signals__footer {
      display: grid;
    }
  }
</style>
