---
import { Image } from "astro:assets";
import { ArrowDownRight, ArrowUpRight, Radio } from "@lucide/astro";
import DirectedPointer from "../../components/DirectedPointer.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { friendLinks } from "../../config/friends";
import OrbitSculpture from "../../components/art/OrbitSculpture.astro";
import ArtDirection from "../../components/art/ArtDirection.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const linkCount = String(friendLinks.length);
---

<BaseLayout
  title="友链"
  description="沿着这些链接，可以抵达一些很有意思的人"
  bodyClass="friends-page"
  directedPointer
>
  <SiteHeader variant="overlay" />
  <main id="main-content">
    <section class="friends-hero" aria-labelledby="friends-title" data-art-scene>
      <div class="friends-hero__sculpture"><OrbitSculpture id="friends-orbit" /></div>
      <div class="friends-hero__inner page-width">
        <div class="friends-hero__copy">
          <p>
            <Radio aria-hidden="true" size={17} stroke-width={1.8} />
            BLOGROLL · {linkCount}
          </p>
          <h1 id="friends-title">
            <span>沿着链接，</span>
            <strong>遇见同路的人。</strong>
          </h1>
          <p class="friends-hero__intro">
            一些常去的小站，和认真写作的人。
          </p>
          <a href="#received-signals">
            <span>查看友链</span>
            <ArrowDownRight aria-hidden="true" size={20} stroke-width={2} />
          </a>
        </div>


      </div>
      <div class="friends-hero__footer">
        <span>PEOPLE I MET ON THE WORLD</span>
        <span>LOG 0017 / BLOGROLL</span>
      </div>
    </section>

    <section id="received-signals" class="friends-signals">
      <div class="page-width">
        <header class="friends-signals__header" data-reveal>
          <span>01 / WEB NEIGHBORHOOD</span>
          <h2>互联网上的<br />邻居们</h2>
          <p>
            路过时，不妨进去坐坐。
          </p>
        </header>

        <div class="friends-list" aria-label="友链列表">
          {
            friendLinks.map((link, index) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                data-reveal
                data-reveal-delay={String(Math.min(index, 2))}
              >
                <span class="friends-list__index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <figure class="friends-list__avatar" aria-hidden="true">
                  {
                    link.avatar ? (
                      <Image
                        src={link.avatar}
                        alt=""
                        widths={[128, 256]}
                        sizes="(max-width: 600px) 72px, (max-width: 900px) 108px, 148px"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span>{link.title.slice(0, 1).toUpperCase()}</span>
                    )
                  }
                </figure>
                <div class="friends-list__identity">
                  <small>{link.label}</small>
                  <h3>{link.title}</h3>
                </div>
                <div class="friends-list__note">
                  <p>{link.description}</p>
                  <small>{new URL(link.href).host}</small>
                </div>
                <ArrowUpRight aria-hidden="true" size={28} stroke-width={1.6} />
              </a>
            ))
          }
        </div>

        <footer class="friends-signals__footer" data-reveal>
          <span>MORE FRIENDS MAY JOIN</span>
          <p>期待下一次偶然的邂逅。</p>
        </footer>
      </div>
    </section>
  </main>

  <SiteFooter />
  <DirectedPointer />
  <ScrollReveal />
  <ArtDirection />
</BaseLayout>

<style>
  .friends-page {
    background: var(--color-bg);
  }

  .friends-hero {
    position: relative;
    display: grid;
    height: min(76svh, 820px);
    min-height: 620px;
    overflow: hidden;
    background: var(--art-night);
    color: #fff;
    isolation: isolate;
  }

  .friends-hero__sculpture {
    position:absolute; width:min(60vw,760px); right:-2%; top:50%;
    color:#e9d9ee; transform:translateY(-50%) rotate(calc(var(--scene-x, 0) * 8deg));
  }
  .friends-hero__sculpture :global(.orbit-sculpture) { color:#e9d9ee; }

  .friends-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    padding: 118px 44px 90px;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 48px;
  }

  .friends-hero__copy > p:first-child {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 9px;
    margin: 0;
    color: #c9bad5;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 850;
  }

  .friends-hero h1 {
    margin: 24px 0 0;
    line-height: 1.3;
    font-family: var(--font-reading);
  }

  .friends-hero h1 span,
  .friends-hero h1 strong {
    display: block;
    letter-spacing: 0;
  }

  .friends-hero h1 span { font-size:clamp(2rem,4vw,3.5rem); font-weight:400; color:#d7c4df; }
  .friends-hero h1 strong { margin-top:14px; font-size:clamp(2.7rem,5.5vw,5rem); font-weight:500; }

  .friends-hero__intro {
    max-width: 460px;
    margin: 34px 0 0;
    color: #d8cfd4;
    line-height: 1.8;
  }

  .friends-hero__copy > a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0 7px;
    margin-top: 22px;
    border-bottom: 2px solid currentColor;
    font-weight: 800;
    text-decoration: none;
  }

  .friends-hero__footer {
    position: absolute;
    z-index: 2;
    right: calc(var(--page-inline) + 16px);
    bottom: 29px;
    left: calc(var(--page-inline) + 16px);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 800;
  }

  .friends-signals {
    padding-block: clamp(88px, 12vw, 156px) 120px;
  }

  .friends-signals__header {
    display: grid;
    margin-bottom: clamp(56px, 8vw, 96px);
    grid-template-columns: minmax(300px, 0.88fr) minmax(360px, 1.12fr);
    align-items: end;
    gap: 18px clamp(54px, 8vw, 120px);
  }

  .friends-signals__header > span {
    grid-column: 1 / -1;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .friends-signals__header h2 {
    margin: 0;
    font-family: var(--font-reading);
    font-size: clamp(3.2rem, 6.5vw, 6rem);
    line-height: 1;
  }

  .friends-signals__header p {
    max-width: 550px;
    margin: 0 0 8px;
    color: var(--color-muted);
    line-height: 1.9;
  }

  .friends-list {
    border-top: 1px solid var(--color-line);
  }

  .friends-list > a {
    position: relative;
    display: grid;
    min-height: 230px;
    padding: 42px 12px;
    grid-template-columns:
      54px
      clamp(118px, 12vw, 148px)
      minmax(210px, 0.78fr)
      minmax(280px, 1.22fr)
      auto;
    align-items: center;
    gap: 34px;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
    transition:
      padding 220ms ease,
      background 220ms ease,
      color 220ms ease;
  }

  .friends-list > a:hover {
    padding-inline: 30px;
    background: var(--art-paper);
    color: var(--color-ink);
  }

  .friends-list__index,
  .friends-list small {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .friends-list__index {
    color: var(--color-rose);
  }

  .friends-list__avatar {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    margin: 0;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-surface-soft);
    isolation: isolate;
    transition:
      border-color 220ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .friends-list__avatar::after {
    position: absolute;
    z-index: -1;
    inset: 8px -8px -8px 8px;
    border: 1px solid var(--color-cyan);
    border-radius: 50%;
    content: "";
    opacity: 0.72;
    transition:
      border-color 220ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .friends-list__avatar :global(img),
  .friends-list__avatar > span {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow: hidden;
    border-radius: inherit;
  }

  .friends-list__avatar :global(img) {
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .friends-list__avatar > span {
    color: var(--color-muted);
    font-family: var(--font-reading);
    font-size: clamp(2.5rem, 5vw, 4.8rem);
  }

  .friends-list > a:hover .friends-list__avatar {
    border-color: #17151a;
    transform: translate(-3px, -3px);
  }

  .friends-list > a:hover .friends-list__avatar::after {
    border-color: #17151a;
    transform: translate(6px, 6px);
  }

  .friends-list > a:hover .friends-list__avatar :global(img) {
    transform: scale(1.045);
  }

  .friends-list > a:hover .friends-list__index {
    color: var(--color-rose);
  }

  .friends-list__identity h3 {
    margin: 8px 0 0;
    font-family: var(--font-reading);
    font-size: clamp(2.2rem, 4.2vw, 4rem);
    font-weight: 500;
    line-height: 0.9;
  }

  .friends-list__identity small,
  .friends-list__note small {
    color: var(--color-muted);
  }

  .friends-list > a:hover small {
    color: var(--color-muted);
  }

  .friends-list__note p {
    margin: 0 0 16px;
    font-size: 1.05rem;
  }

  .friends-signals__footer {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    padding-top: 36px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .friends-signals__footer p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .friends-hero__inner {
      grid-template-columns: 1fr;
    }


    .friends-signals__header {
      grid-template-columns: 1fr;
    }

    .friends-list > a {
      grid-template-columns:
        40px
        108px
        minmax(180px, 0.8fr)
        minmax(220px, 1.2fr)
        auto;
      gap: 20px;
    }
  }

  @media (max-width: 600px) {
    .friends-hero {
      height: 82svh;
      min-height: 610px;
    }



    .friends-hero__inner {
      padding: 108px 0 74px;
    }

    .friends-hero h1 span { font-size: 1.8rem; }

    .friends-hero h1 strong { font-size:clamp(2rem,8.5vw,3.3rem); }
    .friends-hero__sculpture { width:110vw; top:20%; right:-38%; opacity:.5; }

    .friends-hero__footer {
      right: 26px;
      bottom: 23px;
      left: 26px;
    }

    .friends-hero__footer span:last-child {
      display: none;
    }

    .friends-signals__header {
      margin-bottom: 44px;
    }

    .friends-signals__header h2 {
      font-size: 3rem;
    }

    .friends-list > a {
      min-height: 230px;
      padding: 30px 4px;
      grid-template-columns:
        20px
        clamp(64px, 18vw, 72px)
        minmax(0, 1fr)
        28px;
      align-items: start;
      gap: 8px;
    }

    .friends-list > a:hover {
      padding-inline: 12px;
    }

    .friends-list__identity h3 {
      overflow-wrap: anywhere;
      font-size: clamp(2rem, 10vw, 3.2rem);
    }

    .friends-list__note {
      grid-column: 2 / -1;
      padding-top: 8px;
    }

    .friends-list > a > :global(svg) {
      grid-column: 4;
      grid-row: 1;
      align-self: center;
      justify-self: end;
    }

    .friends-signals__footer {
      display: grid;
    }
  }
</style>
