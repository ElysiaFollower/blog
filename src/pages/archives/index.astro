---
import ContentDirectory from "../../components/content/ContentDirectory.astro";
import ContentPageHeader from "../../components/content/ContentPageHeader.astro";
import PostList from "../../components/content/PostList.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import {
  getPublishedPosts,
  getTaxonomy,
  groupPostsByYear,
} from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getPublishedPosts();
const categories = getTaxonomy(posts, "categories");
const tags = getTaxonomy(posts, "tags");
const yearGroups = groupPostsByYear(posts);
const yearLabel = yearGroups.length === 1 ? "YEAR" : "YEARS";
---

<BaseLayout
  title="归档"
  description="按时间回看已经抵达的文章与笔记。"
  bodyClass="archives-page"
>
  <SiteHeader variant="reading" />
  <main id="main-content">
    <ContentPageHeader
      kicker={`ARCHIVES // ${String(posts.length).padStart(2, "0")}`}
      title="归档"
      description="按时间回看已经抵达的文章与笔记。"
      note={`${yearGroups.length} ${yearLabel} RECORDED`}
    />
    <ContentDirectory
      current="archives"
      postCount={posts.length}
      categoryCount={categories.length}
      tagCount={tags.length}
    />

    <div class="archives page-width">
      {
        yearGroups.map((group) => {
          const articleLabel = group.posts.length === 1 ? "ARTICLE" : "ARTICLES";

          return (
            <section aria-labelledby={`year-${group.year}`}>
              <header>
                <h2 id={`year-${group.year}`}>{group.year}</h2>
                <span>
                  {String(group.posts.length).padStart(2, "0")} {articleLabel}
                </span>
              </header>
              <PostList posts={group.posts} />
            </section>
          );
        })
      }
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .archives-page {
    background: var(--color-bg);
  }

  .archives {
    padding-block: 76px 120px;
  }

  .archives section + section {
    margin-top: 86px;
  }

  .archives section > header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .archives h2 {
    margin: 0;
    font-family: var(--font-reading);
    font-size: 4.8rem;
    line-height: 1;
  }

  .archives header span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.67rem;
  }

  @media (max-width: 620px) {
    .archives {
      padding-block: 54px 88px;
    }

    .archives h2 {
      font-size: 3.4rem;
    }
  }
</style>
