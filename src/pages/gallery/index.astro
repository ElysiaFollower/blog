---
import GalleryBrowse from "../../components/gallery/GalleryBrowse.astro";
import GalleryLightbox from "../../components/gallery/GalleryLightbox.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getGalleryEntries } from "../../lib/gallery";
import BaseLayout from "../../layouts/BaseLayout.astro";
const items = await getGalleryEntries();
---
<BaseLayout title="画廊" description="收藏那些曾让目光停留的瞬间" bodyClass="gallery-page">
  <SiteHeader variant="reading" />
  <main id="main-content">
    <header class="gallery-header page-width">
      <p class="gallery-kicker">COLLECTION <span aria-hidden="true">/</span> {String(items.length).padStart(3, "0")}</p>
      <h1>画廊<span aria-hidden="true">.</span></h1>
      <p class="gallery-description">收藏那些<br />曾让目光停留的瞬间。</p>
    </header>
    <GalleryBrowse items={items} />
  </main>
  <GalleryLightbox />
  <SiteFooter />
</BaseLayout>
<style>
  .gallery-header { position:relative; display:grid; grid-template-columns:1fr auto; align-items:end; gap:24px; padding-block:clamp(50px,6vw,84px) clamp(32px,4vw,54px); border-bottom:1px solid var(--color-line); }
  .gallery-kicker { grid-column:1 / -1; margin:0; color:var(--color-muted); font-family:var(--font-mono); font-size:.66rem; letter-spacing:.14em; }
  .gallery-kicker span { padding:0 12px; color:var(--color-rose); }
  h1 { margin:0; font-family:var(--font-reading); font-size:clamp(4.7rem,9vw,8rem); font-weight:600; line-height:1; letter-spacing:-.06em; }
  h1 span { color:var(--color-rose); font-family:var(--font-reading); margin-left:.06em; }
  .gallery-description { margin:0 0 5px; color:var(--color-muted); font-size:.85rem; line-height:1.9; letter-spacing:.08em; }
  @media (max-width:620px) {
    .gallery-header { padding-top:46px; gap:24px 12px; }
    .gallery-description { font-size:.7rem; letter-spacing:0; }
    h1 { font-size:4.6rem; }
  }
</style>
