---
import { Image } from "astro:assets";
import GalleryLightbox from "../../components/gallery/GalleryLightbox.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { galleryImages } from "../../config/gallery";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="相册"
  description="角色、构图与偶然遇见的视觉片段。"
  bodyClass="gallery-page"
>
  <SiteHeader variant="reading" />
  <main id="main-content">
    <header class="gallery-header page-width">
      <p>COLLECTION // {String(galleryImages.length).padStart(2, "0")}</p>
      <h1>相册</h1>
      <span>角色、构图与偶然遇见的视觉片段。</span>
    </header>

    <section class="gallery-grid page-width" aria-label="图片收藏">
      {
        galleryImages.map((image, index) => (
          <a
            class="gallery-item"
            href={image.src.src}
            data-gallery-item
            data-full-src={image.src.src}
            data-alt={image.alt}
            data-index={index}
            aria-label={`查看大图：${image.alt}`}
          >
            <Image
              src={image.src}
              alt={image.alt}
              widths={[360, 540, 720]}
              sizes="(max-width: 620px) 50vw, (max-width: 980px) 33vw, 25vw"
              loading={index < 4 ? "eager" : "lazy"}
              decoding="async"
            />
            <span class="gallery-item__index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
          </a>
        ))
      }
    </section>
  </main>

  <GalleryLightbox />
  <SiteFooter />
</BaseLayout>

<style>
  .gallery-page {
    background: var(--color-bg);
  }

  .gallery-header {
    display: grid;
    padding-block: clamp(58px, 9vw, 110px);
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 12px 32px;
    border-bottom: 1px solid var(--color-line);
  }

  .gallery-header p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .gallery-header h1 {
    margin: 0;
    font-family: var(--font-reading);
    font-size: clamp(3.7rem, 10vw, 8rem);
    line-height: 0.9;
  }

  .gallery-header span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .gallery-grid {
    padding-block: clamp(42px, 7vw, 92px) 120px;
    columns: 4 240px;
    column-gap: 16px;
  }

  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    margin: 0 0 16px;
    break-inside: avoid;
    overflow: hidden;
    background: var(--color-surface-soft);
    cursor: zoom-in;
  }

  .gallery-item :global(img) {
    width: 100%;
    height: auto;
    transition:
      transform 360ms ease,
      filter 360ms ease;
  }

  .gallery-item:hover :global(img) {
    filter: saturate(1.06);
    transform: scale(1.025);
  }

  .gallery-item__index {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 3px 7px;
    background: rgb(15 13 16 / 72%);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .gallery-item:hover .gallery-item__index,
  .gallery-item:focus-visible .gallery-item__index {
    opacity: 1;
  }

  @media (max-width: 620px) {
    .gallery-header {
      grid-template-columns: 1fr;
    }

    .gallery-grid {
      width: calc(100% - 20px);
      columns: 2;
      column-gap: 10px;
    }

    .gallery-item {
      margin-bottom: 10px;
    }

    .gallery-item__index {
      opacity: 1;
    }
  }
</style>
