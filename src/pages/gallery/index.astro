---
import GalleryExhibition from "../../components/gallery/GalleryExhibition.astro";
import GalleryBrowse from "../../components/gallery/GalleryBrowse.astro";
import GalleryLightbox from "../../components/gallery/GalleryLightbox.astro";
import GalleryPassage from "../../components/art/GalleryPassage.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getGalleryEntries } from "../../lib/gallery";
import BaseLayout from "../../layouts/BaseLayout.astro";
const items = await getGalleryEntries();
---
<BaseLayout title="画廊" description="收藏那些曾让目光停留的瞬间" bodyClass="gallery-page">
  <SiteHeader variant="scene" />
  <main id="main-content">
    <GalleryPassage items={items} />
    <div id="gallery-collection">
      <div class="gallery-browse-sheet" data-gallery-browse-panel>
        <div class="gallery-mode-toolbar page-width"><span>COLLECTION / BROWSE</span><button data-gallery-enter-exhibition>走进光的回廊 <span aria-hidden="true">↗</span></button></div>
        <GalleryBrowse items={items} />
      </div>
      <GalleryExhibition />
    </div>
  </main>
  <GalleryLightbox />
  <SiteFooter />
</BaseLayout>
<script>
  import { mountGalleryModes } from "../../components/gallery/modes";
  mountGalleryModes();
</script>
<style>
  #gallery-collection { scroll-margin-top: 0; }
  .gallery-mode-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-top: 25px; }
  .gallery-mode-toolbar > span { font: .6rem var(--font-mono); letter-spacing: .12em; color: var(--color-muted); }
  .gallery-mode-toolbar button { background: none; border: none; min-height: 44px; padding: 0; cursor: pointer; color: var(--color-rose); font-size: .75rem; }
  .gallery-mode-toolbar button > span { margin-left: 12px; }
  .gallery-browse-sheet[hidden] { display: none; }
  :global(body[data-gallery-mode="exhibition"]) #gallery-collection { position: relative; z-index: 3; }

  .gallery-browse-sheet {
    position: relative;
    z-index: 3;
    margin-top: -24px;
    border-radius: 24px 24px 0 0;
    background: var(--color-bg);
    padding-top: 18px;
  }

  :global(body[data-gallery-direct]) .gallery-browse-sheet {
    margin-top: 0;
    border-radius: 0;
  }
</style>
