---
import GalleryBrowse from "../../components/gallery/GalleryBrowse.astro";
import GalleryLightbox from "../../components/gallery/GalleryLightbox.astro";
import GalleryPassage from "../../components/art/GalleryPassage.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getGalleryEntries } from "../../lib/gallery";
import BaseLayout from "../../layouts/BaseLayout.astro";
const items = await getGalleryEntries();
---
<BaseLayout title="画廊" description="收藏那些曾让目光停留的瞬间" bodyClass="gallery-page">
  <SiteHeader variant="scene" />
  <main id="main-content">
    <GalleryPassage items={items} />
    <div class="gallery-browse-sheet" id="gallery-collection"><GalleryBrowse items={items} /></div>
  </main>
  <GalleryLightbox />
  <SiteFooter />
</BaseLayout>
<style>
  .gallery-browse-sheet {
    position: relative;
    z-index: 3;
    margin-top: -24px;
    border-radius: 24px 24px 0 0;
    background: var(--color-bg);
    padding-top: 18px;
  }

  :global(body[data-gallery-direct]) .gallery-browse-sheet {
    margin-top: 0;
    border-radius: 0;
  }
</style>
