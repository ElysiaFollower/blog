---
import { Image } from "astro:assets";
import { ArrowLeft, BookOpenText, RadioTower } from "@lucide/astro";
import heroNight from "../assets/demo/hero-night.jpg";
import DirectedPointer from "../components/DirectedPointer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="信号未抵达"
  description="这个地址没有对应的页面。"
  bodyClass="not-found-page"
  directedPointer
  noIndex
>
  <SiteHeader variant="overlay" />
  <main id="main-content" class="not-found">
    <Image
      class="not-found__art"
      src={heroNight}
      alt=""
      widths={[960, 1440, 1942]}
      sizes="100vw"
      loading="eager"
    />
    <div class="not-found__shade" aria-hidden="true"></div>
    <div class="not-found__frame" aria-hidden="true"></div>
    <div class="not-found__content page-width">
      <div>
        <span>
          <RadioTower aria-hidden="true" size={17} stroke-width={1.8} />
          SIGNAL LOST // 404
        </span>
        <h1>这段信号<br />还没有抵达。</h1>
        <p>可能是地址发生了变化，也可能这里从来没有建立过航线。</p>
        <nav aria-label="离开错误页面">
          <a href="/">
            <ArrowLeft aria-hidden="true" size={18} stroke-width={1.8} />
            返回首页
          </a>
          <a href="/posts/">
            <BookOpenText aria-hidden="true" size={18} stroke-width={1.8} />
            浏览文章
          </a>
        </nav>
      </div>
      <strong aria-hidden="true">404</strong>
    </div>
  </main>
  <DirectedPointer />
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
    color: #fff;
    isolation: isolate;
  }

  .not-found__art,
  .not-found__shade,
  .not-found__frame {
    position: absolute;
    inset: 0;
  }

  .not-found__art {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .not-found__shade {
    z-index: -2;
    background: rgb(8 7 13 / 48%);
    box-shadow: inset 55vw 0 180px rgb(8 7 13 / 46%);
  }

  .not-found__frame {
    z-index: -1;
    inset: 86px var(--page-inline) 44px;
    border: 1px solid #ffffff70;
  }

  .not-found__content {
    display: grid;
    padding: 134px 42px 82px;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 50px;
  }

  .not-found__content > div {
    max-width: 720px;
  }

  .not-found__content > div > span {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #75d4d2;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .not-found h1 {
    margin: 20px 0 0;
    font-family: var(--font-reading);
    font-size: 5.8rem;
    line-height: 1.02;
  }

  .not-found p {
    max-width: 560px;
    margin: 26px 0 0;
    line-height: 1.85;
  }

  .not-found nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 34px;
  }

  .not-found nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 9px;
    border-bottom: 2px solid currentColor;
    font-weight: 750;
    text-decoration: none;
  }

  .not-found__content > strong {
    color: #ffffff24;
    font-family: var(--font-mono);
    font-size: 10rem;
    line-height: 0.75;
  }

  @media (max-width: 820px) {
    .not-found__shade {
      background: rgb(8 7 13 / 56%);
      box-shadow: inset 0 -260px 180px rgb(8 7 13 / 42%);
    }

    .not-found__content {
      padding-inline: 0;
      grid-template-columns: 1fr;
    }

    .not-found h1 {
      font-size: 3.8rem;
    }

    .not-found__content > strong {
      display: none;
    }
  }
</style>
