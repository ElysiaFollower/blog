---
import { Image } from "astro:assets";
import {
  ArrowDownRight,
  ArrowUpRight,
  Copy,
  GitFork,
  GraduationCap,
  Mail,
  Microscope,
  Sparkles,
} from "@lucide/astro";
import aboutPortrait from "../../assets/demo/elysia-portrait.png";
import playPortrait from "../../assets/demo/sparkle-portrait.png";
import DirectedPointer from "../../components/DirectedPointer.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { profileConfig } from "../../config/profile";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="关于"
  description={`关于 ${profileConfig.handle}：研究、好奇心与那些纯粹为了好玩的创作。`}
  bodyClass="about-page"
  directedPointer
>
  <SiteHeader variant="overlay" />

  <main id="main-content">
    <section class="about-hero" aria-labelledby="about-title">
      <Image
        class="about-hero__art"
        src={aboutPortrait}
        alt=""
        widths={[960, 1440, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div class="about-hero__shade" aria-hidden="true"></div>
      <div class="about-hero__frame" aria-hidden="true"></div>

      <div class="about-hero__content page-width">
        <div class="about-hero__copy">
          <p>PERSONAL TRANSMISSION // 017</p>
          <h1 id="about-title">
            <span>Hello, this is</span>
            <strong>{profileConfig.handle}.</strong>
          </h1>
          <p class="about-hero__alias">
            也可以叫我 <b>{profileConfig.alias}</b>。
          </p>
          <p class="about-hero__intro">{profileConfig.introduction}</p>
          <a href="#research">
            <span>继续读取</span>
            <ArrowDownRight aria-hidden="true" size={20} stroke-width={2} />
          </a>
        </div>

        <div class="about-hero__status" aria-label="当前状态">
          <span>
            <GraduationCap aria-hidden="true" size={18} stroke-width={1.8} />
            {profileConfig.education}
          </span>
          <span>
            <Microscope aria-hidden="true" size={18} stroke-width={1.8} />
            {profileConfig.nextStage}
          </span>
        </div>
      </div>
    </section>

    <section id="research" class="about-research">
      <div class="page-width">
        <header data-about-reveal>
          <span>01 / RESEARCH TRANSMISSION</span>
          <h2>正在认真追问的事情</h2>
          <p>
            研究方向有明确的主线：从声音与对话开始，逐渐靠近更自然、更有表达力，也更理解人的智能系统。
          </p>
        </header>

        <div class="about-research__list">
          {
            profileConfig.research.map((item) => (
              <article data-about-reveal>
                <span>{item.index}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>

        <blockquote data-about-reveal>
          <Sparkles aria-hidden="true" size={24} stroke-width={1.6} />
          <p>
            长期想做的，是能够倾听、理解并陪伴人的 AI；现在从音频对话开始。
          </p>
        </blockquote>
      </div>
    </section>

    <section class="about-curiosity">
      <div class="page-width">
        <header data-about-reveal>
          <span>02 / CURIOSITY MAP</span>
          <h2>主线之外，<br />好奇心没有边界。</h2>
        </header>

        <div class="about-curiosity__list">
          {
            profileConfig.curiosities.map((item, index) => (
              <div data-about-reveal>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.note}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about-play" aria-labelledby="play-title">
      <div class="about-play__image" data-about-reveal>
        <Image
          src={playPortrait}
          alt="带有戏剧化构图的角色插画"
          widths={[720, 1080, 1440]}
          sizes="(max-width: 820px) 100vw, 52vw"
          loading="lazy"
        />
      </div>
      <div class="about-play__copy" data-about-reveal>
        <span>03 / AFTER HOURS</span>
        <h2 id="play-title">另一条航线，<br />纯粹为了好玩。</h2>
        <p>
          我会笨手笨脚地做些游戏，折腾图形学与 MMD，也会在动画和二游里暂时离开现实世界。它们不一定通向论文，但经常通向新的问题。
        </p>
        <ul>
          {profileConfig.play.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="about-contact">
      <div class="page-width">
        <div data-about-reveal>
          <span>04 / OPEN CHANNEL</span>
          <h2>看到这里，<br />就算接上频道了。</h2>
        </div>
        <div class="about-contact__body" data-about-reveal>
          <p>
            研究、开源项目、生成媒体，或者只是某个突然变得很有趣的问题，都欢迎来聊。
          </p>
          <p class="about-contact__invitation">Feel free to reach out.</p>
          <nav aria-label="个人链接">
            <a href={profileConfig.links.github}>
              <GitFork aria-hidden="true" size={19} stroke-width={1.8} />
              <span>GitHub</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <a href={profileConfig.links.academic}>
              <GraduationCap aria-hidden="true" size={19} stroke-width={1.8} />
              <span>Academic</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <button
              type="button"
              data-copy-email
              data-email={profileConfig.links.email}
              aria-label="复制联系邮箱"
              title="复制联系邮箱"
            >
              <Mail aria-hidden="true" size={19} stroke-width={1.8} />
              <span data-email-label>{profileConfig.links.email}</span>
              <Copy aria-hidden="true" size={17} stroke-width={1.8} />
            </button>
          </nav>
          <p class="about-contact__feedback" aria-live="polite" data-copy-feedback>
          </p>
        </div>
      </div>
      <footer class="page-width">
        <span>ELYSIAFOLLOWER © 2026</span>
        <span>END OF PERSONAL TRANSMISSION</span>
      </footer>
    </section>
  </main>

  <DirectedPointer />
</BaseLayout>

<script>
  const revealItems = document.querySelectorAll<HTMLElement>(
    "[data-about-reveal]",
  );
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    },
    { rootMargin: "0px 0px -10% 0px", threshold: 0.08 },
  );

  revealItems.forEach((item) => observer.observe(item));

  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyFeedback = document.querySelector<HTMLElement>(
    "[data-copy-feedback]",
  );

  copyButton?.addEventListener("click", async () => {
    const obfuscated = copyButton.dataset.email;
    if (!obfuscated) return;

    const address = obfuscated.replace("#", "@");
    try {
      await navigator.clipboard.writeText(address);
      if (copyFeedback) copyFeedback.textContent = "邮箱已复制。";
    } catch {
      if (copyFeedback) {
        copyFeedback.textContent = `复制失败，请手动输入 ${obfuscated}`;
      }
    }
  });
</script>

<style>
  .about-page {
    background: var(--color-bg);
  }

  .about-hero {
    position: relative;
    display: grid;
    height: min(86svh, 880px);
    min-height: 660px;
    overflow: hidden;
    color: #fff;
    isolation: isolate;
  }

  .about-hero__art,
  .about-hero__shade,
  .about-hero__frame {
    position: absolute;
    inset: 0;
  }

  .about-hero__art {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 29%;
    transform: scale(1.02);
  }

  .about-hero__shade {
    z-index: -2;
    background: rgb(7 13 18 / 42%);
    box-shadow:
      inset 46vw 0 190px rgb(7 12 17 / 50%),
      inset 0 -160px 130px rgb(8 12 16 / 36%);
  }

  .about-hero__frame {
    z-index: 1;
    inset: 86px var(--page-inline) 56px;
    border: 1px solid #ffffff73;
    pointer-events: none;
  }

  .about-hero__frame::before,
  .about-hero__frame::after {
    position: absolute;
    width: 70px;
    height: 8px;
    content: "";
  }

  .about-hero__frame::before {
    top: -4px;
    left: 9%;
    background: #75d4d2;
  }

  .about-hero__frame::after {
    right: 9%;
    bottom: -4px;
    background: #ff78a5;
  }

  .about-hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    padding: 120px 42px 88px;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 44px;
  }

  .about-hero__copy {
    max-width: 760px;
  }

  .about-hero__copy > p:first-child,
  .about-research header > span,
  .about-curiosity header > span,
  .about-play__copy > span,
  .about-contact h2 + span,
  .about-contact [data-about-reveal] > span {
    color: #75d4d2;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .about-hero h1 {
    margin: 14px 0 0;
    line-height: 0.88;
  }

  .about-hero h1 span {
    display: block;
    font-family: var(--font-reading);
    font-size: 3.6rem;
    font-weight: 500;
  }

  .about-hero h1 strong {
    display: block;
    font-size: 7.6rem;
    font-weight: 900;
  }

  .about-hero__alias {
    margin: 26px 0 0;
    font-family: var(--font-reading);
    font-size: 1.1rem;
  }

  .about-hero__alias b {
    color: #ff9fbd;
  }

  .about-hero__intro {
    max-width: 620px;
    margin: 14px 0 0;
    line-height: 1.85;
    text-shadow: 0 2px 20px rgb(0 0 0 / 52%);
  }

  .about-hero__copy > a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0 7px;
    margin-top: 24px;
    border-bottom: 2px solid currentColor;
    font-weight: 800;
    text-decoration: none;
  }

  .about-hero__status {
    display: grid;
    padding-bottom: 10px;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .about-hero__status span {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .about-research {
    padding-block: clamp(82px, 11vw, 150px);
    background: var(--color-bg);
  }

  .about-research header {
    display: grid;
    margin-bottom: 68px;
    grid-template-columns: minmax(0, 0.85fr) minmax(440px, 1.15fr);
    gap: 12px 54px;
    align-items: end;
  }

  .about-research header > span {
    grid-column: 1 / -1;
    color: var(--color-cyan);
  }

  .about-research h2,
  .about-curiosity h2,
  .about-play h2,
  .about-contact h2 {
    margin: 0;
    letter-spacing: 0;
  }

  .about-research h2 {
    font-family: var(--font-reading);
    font-size: 5.2rem;
    line-height: 1.06;
  }

  .about-research header > p {
    max-width: 560px;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.85;
  }

  .about-research__list {
    border-top: 1px solid var(--color-line);
  }

  .about-research__list article {
    display: grid;
    min-height: 170px;
    padding-block: 30px;
    grid-template-columns: 80px minmax(260px, 0.75fr) minmax(360px, 1.25fr);
    align-items: center;
    gap: 28px;
    border-bottom: 1px solid var(--color-line);
  }

  .about-research__list article > span {
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 850;
  }

  .about-research__list h3 {
    margin: 0;
    font-size: 2rem;
  }

  .about-research__list p {
    max-width: 600px;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .about-research blockquote {
    display: grid;
    max-width: 920px;
    padding: 58px 0 0;
    margin: 72px 0 0 auto;
    grid-template-columns: auto 1fr;
    gap: 22px;
    border-top: 4px solid var(--color-cyan);
  }

  .about-research blockquote :global(svg) {
    color: var(--color-rose);
  }

  .about-research blockquote p {
    margin: 0;
    font-family: var(--font-reading);
    font-size: 3rem;
    line-height: 1.45;
  }

  .about-curiosity {
    padding-block: clamp(82px, 11vw, 150px);
    background: #17151a;
    color: #fff;
  }

  .about-curiosity > div {
    display: grid;
    grid-template-columns: minmax(330px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(54px, 8vw, 120px);
  }

  .about-curiosity header > span {
    color: #75d4d2;
  }

  .about-curiosity h2 {
    margin-top: 20px;
    font-size: 5.4rem;
    line-height: 0.96;
  }

  .about-curiosity__list {
    border-top: 1px solid #ffffff3d;
  }

  .about-curiosity__list > div {
    display: grid;
    min-height: 126px;
    padding-block: 22px;
    grid-template-columns: 58px minmax(220px, 1fr) minmax(180px, 0.8fr);
    align-items: center;
    gap: 18px;
    border-bottom: 1px solid #ffffff3d;
  }

  .about-curiosity__list span {
    color: #ff88ae;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 850;
  }

  .about-curiosity__list h3 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
  }

  .about-curiosity__list p {
    margin: 0;
    color: #bcb3b9;
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .about-play {
    display: grid;
    min-height: 720px;
    grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);
    background: var(--color-bg);
  }

  .about-play__image {
    min-height: 720px;
    overflow: hidden;
  }

  .about-play__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% center;
  }

  .about-play__copy {
    display: flex;
    max-width: 680px;
    padding: clamp(64px, 8vw, 116px);
    flex-direction: column;
    justify-content: center;
  }

  .about-play__copy > span {
    color: var(--color-rose);
  }

  .about-play h2 {
    margin-top: 20px;
    font-family: var(--font-reading);
    font-size: 5.2rem;
    line-height: 1.02;
  }

  .about-play__copy > p {
    max-width: 530px;
    margin: 30px 0 0;
    color: var(--color-muted);
    line-height: 1.9;
  }

  .about-play ul {
    display: grid;
    padding: 0;
    margin: 42px 0 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .about-play li {
    padding: 14px 4px;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .about-play li:nth-child(odd) {
    border-right: 1px solid var(--color-line);
  }

  .about-play li:nth-child(even) {
    padding-left: 18px;
  }

  .about-contact {
    padding: clamp(84px, 11vw, 150px) 0 34px;
    background: #efbd43;
    color: #17151a;
  }

  .about-contact > div {
    display: grid;
    grid-template-columns: minmax(360px, 0.9fr) minmax(420px, 1.1fr);
    gap: clamp(58px, 9vw, 140px);
  }

  .about-contact [data-about-reveal] > span {
    color: #4f3a0a;
  }

  .about-contact h2 {
    margin-top: 18px;
    font-size: 5.4rem;
    line-height: 0.98;
  }

  .about-contact__body > p:first-child {
    max-width: 560px;
    margin: 6px 0 0;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .about-contact__invitation {
    margin: 24px 0 34px;
    font-family: var(--font-reading);
    font-size: 1.4rem;
  }

  .about-contact nav {
    display: grid;
    border-top: 2px solid #17151a;
  }

  .about-contact nav a,
  .about-contact nav button {
    display: grid;
    min-height: 66px;
    padding: 12px 4px;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid #17151a80;
    background: transparent;
    color: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .about-contact nav a:hover,
  .about-contact nav button:hover {
    padding-inline: 12px;
    background: #17151a;
    color: #fff;
  }

  .about-contact__feedback {
    min-height: 1.5em;
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .about-contact footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 96px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  :global(.js) [data-about-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 620ms ease,
      transform 620ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global(.js) [data-about-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 980px) {
    .about-hero h1 span {
      font-size: 2.8rem;
    }

    .about-hero h1 strong {
      font-size: 5.4rem;
    }

    .about-hero__status {
      display: none;
    }

    .about-hero__content,
    .about-research header,
    .about-curiosity > div,
    .about-play,
    .about-contact > div {
      grid-template-columns: 1fr;
    }

    .about-research__list article {
      grid-template-columns: 54px minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .about-research h2 {
      font-size: 3.6rem;
    }

    .about-research__list h3 {
      font-size: 1.65rem;
    }

    .about-research blockquote p {
      font-size: 2.2rem;
    }

    .about-curiosity h2,
    .about-contact h2 {
      font-size: 4.2rem;
    }

    .about-play h2 {
      font-size: 4rem;
    }

    .about-play__image {
      min-height: 560px;
      aspect-ratio: 16 / 10;
    }

    .about-play__copy {
      max-width: none;
    }
  }

  @media (max-width: 620px) {
    .about-hero {
      height: 88svh;
      min-height: 640px;
    }

    .about-hero__art {
      object-position: 54% 28%;
    }

    .about-hero__shade {
      background: rgb(7 13 18 / 50%);
      box-shadow: inset 0 -240px 160px rgb(7 12 17 / 48%);
    }

    .about-hero__frame {
      inset: 74px 14px 38px;
    }

    .about-hero__content {
      padding: 112px 0 72px;
    }

    .about-hero h1 strong {
      overflow-wrap: normal;
      font-size: 2.75rem;
    }

    .about-hero h1 span {
      font-size: 1.8rem;
    }

    .about-research header {
      margin-bottom: 42px;
    }

    .about-research h2 {
      font-size: 2.6rem;
    }

    .about-research__list article {
      padding-block: 24px;
      grid-template-columns: 40px 1fr;
      gap: 8px 14px;
    }

    .about-research__list article p {
      grid-column: 2;
    }

    .about-research blockquote {
      padding-top: 36px;
      margin-top: 52px;
    }

    .about-research__list h3 {
      font-size: 1.35rem;
    }

    .about-research blockquote p {
      font-size: 1.65rem;
    }

    .about-curiosity h2,
    .about-contact h2 {
      font-size: 3.1rem;
    }

    .about-play h2 {
      font-size: 2.8rem;
    }

    .about-curiosity__list > div {
      grid-template-columns: 42px 1fr;
      gap: 7px 12px;
    }

    .about-curiosity__list p {
      grid-column: 2;
    }

    .about-play__image {
      width: 100%;
      height: 430px;
      min-height: 0;
      aspect-ratio: auto;
    }

    .about-play__copy {
      padding: 54px var(--page-inline) 76px;
    }

    .about-contact > div {
      gap: 54px;
    }

    .about-contact footer {
      display: grid;
      padding-top: 72px;
    }
  }

  @media (max-width: 350px) {
    .about-hero h1 strong {
      font-size: 2.25rem;
    }
  }
</style>
