---
import { Image } from "astro:assets";
import {
  ArrowDownRight,
  ArrowUpRight,
  Copy,
  GitFork,
  GraduationCap,
  Mail,
  Microscope,
  Tv,
} from "@lucide/astro";
import aboutPortrait from "../../assets/demo/elysia-portrait.webp";
import playPortrait from "../../assets/demo/sparkle-portrait.webp";
import DirectedPointer from "../../components/DirectedPointer.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { profileConfig } from "../../config/profile";
import ArtDirection from "../../components/art/ArtDirection.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="关于"
  description={`${profileConfig.handle} 的研究方向、技术兴趣与联系方式。`}
  bodyClass="about-page"
  directedPointer
>
  <SiteHeader variant="overlay" />

  <main id="main-content">
    <section class="about-hero" aria-labelledby="about-title" data-art-scene>
      <Image
        class="about-hero__art"
        src={aboutPortrait}
        alt=""
        widths={[960, 1440, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div class="about-hero__shade" aria-hidden="true"></div>
      <div class="about-hero__frame" aria-hidden="true"></div>

      <div class="about-hero__content page-width">
        <div class="about-hero__copy">
          <p>PERSONAL INFORMATION // 0017</p>
          <h1 id="about-title">
            <span>你好，我是</span>
            <strong>{profileConfig.handle}</strong>
          </h1>
          <p class="about-hero__alias">
            也使用网名 <b>{profileConfig.alias}</b>
          </p>
          <p class="about-hero__intro">{profileConfig.introduction}</p>
          <a href="#research">
            <span>继续向下</span>
            <ArrowDownRight aria-hidden="true" size={20} stroke-width={2} />
          </a>
        </div>

        <div class="about-hero__status" aria-label="当前状态">
          <span>
            <GraduationCap aria-hidden="true" size={18} stroke-width={1.8} />
            {profileConfig.education}
          </span>
          <span>
            <Microscope aria-hidden="true" size={18} stroke-width={1.8} />
            {profileConfig.nextStage}
          </span>
        </div>
      </div>
    </section>

    <section id="research" class="about-research">
      <div class="page-width">
        <header data-reveal>
          <span>01 / RESEARCH DIRECTIONS</span>
          <h2>关注的方向</h2>
          <p>
            我关心模型怎样听懂话语，也怎样理解说话的人。
          </p>
        </header>

        <div class="about-research__list">
          {
            profileConfig.research.map((item) => (
              <article data-reveal>
                <span>{item.index}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about-play" aria-labelledby="play-title">
      <div class="about-play__image" data-reveal="left">
        <Image
          src={playPortrait}
          alt="带有戏剧化构图的角色插画"
          widths={[720, 1080, 1440]}
          sizes="(max-width: 820px) 100vw, 52vw"
          loading="lazy"
        />
      </div>
      <div class="about-play__copy" data-reveal="right">
        <span>02 / AFTER HOURS</span>
        <h2 id="play-title">主线之外，<br />总有兔子洞</h2>
        <p>
          研究之外，也认真玩耍。<br />好奇心把我带到了这些地方。
        </p>
        <ul>
          {profileConfig.curiosities.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="about-contact">
      <div class="page-width">
        <div data-reveal>
          <span>03 / CONTACT</span>
          <h2>在其他地方<br>找到我</h2>
          <p class="about-contact__invitation">
            如果有任何想法 <br>
            Feel free to reach out. (｡･ω･｡)ﾉ
          </p>
        </div>
        <div class="about-contact__body" data-reveal data-reveal-delay="1">
          <p>
            代码、研究和偶尔的创作，散落在这些地方。
          </p>
          <nav aria-label="个人链接">
            <a href={profileConfig.links.github}>
              <GitFork aria-hidden="true" size={19} stroke-width={1.8} />
              <span>GitHub</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <a href={profileConfig.links.academic} target="_blank" rel="noopener noreferrer">
              <GraduationCap aria-hidden="true" size={19} stroke-width={1.8} />
              <span>Academic</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <a href={profileConfig.links.bilibili} target="_blank" rel="noopener noreferrer">
              <Tv aria-hidden="true" size={19} stroke-width={1.8} />
              <span>Bilibili</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <button
              type="button"
              data-copy-email
              data-email={profileConfig.links.email}
              aria-label="复制联系邮箱"
              title="复制联系邮箱"
            >
              <Mail aria-hidden="true" size={19} stroke-width={1.8} />
              <span data-email-label>{profileConfig.links.email}</span>
              <Copy aria-hidden="true" size={17} stroke-width={1.8} />
            </button>
          </nav>
          <p class="about-contact__feedback" aria-live="polite" data-copy-feedback>
          </p>
        </div>
      </div>
      <footer class="page-width">
        <span>PROMETHEUS © 2026</span>
        <span>END OF TRANSMISSION</span>
      </footer>
    </section>
  </main>

  <DirectedPointer />
  <ScrollReveal />
  <ArtDirection />
</BaseLayout>

<script>
  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyFeedback = document.querySelector<HTMLElement>(
    "[data-copy-feedback]",
  );

  copyButton?.addEventListener("click", async () => {
    const obfuscated = copyButton.dataset.email;
    if (!obfuscated) return;

    const address = obfuscated.replace("#", "@");
    try {
      await navigator.clipboard.writeText(address);
      if (copyFeedback) copyFeedback.textContent = "邮箱已复制。";
    } catch {
      if (copyFeedback) {
        copyFeedback.textContent = `复制失败，请手动输入 ${obfuscated}`;
      }
    }
  });
</script>

<style>
  .about-page {
    background: var(--color-bg);
  }

  .about-hero {
    position: relative;
    display: grid;
    height: min(90svh, 980px);
    min-height: 660px;
    overflow: hidden;
    color: #fff;
    isolation: isolate;
  }

  .about-hero__art,
  .about-hero__shade,
  .about-hero__frame {
    position: absolute;
    inset: 0;
  }

  .about-hero__art {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 29%;
    transform: translateY(calc(var(--scene-scroll, 0) * 70px)) scale(1.03);
  }

  .about-hero__shade {
    z-index: -2;
    background: linear-gradient(90deg, #1c1a31b8, #24203720 80%);
    box-shadow:
      inset 46vw 0 190px rgb(7 12 17 / 50%),
      inset 0 -160px 130px rgb(8 12 16 / 36%);
  }

  .about-hero__frame {
    z-index: 1;
    inset: 112px var(--page-inline) 54px;
    border: 0;
    border-bottom: 1px solid #ffffff40;
    pointer-events: none;
  }

  .about-hero__frame::before,
  .about-hero__frame::after {
    position: absolute;
    width: 48px;
    height: 1px;
    content: "";
  }

  .about-hero__frame::before {
    top: -4px;
    left: 9%;
    background: #bdcfda;
  }

  .about-hero__frame::after {
    right: 9%;
    bottom: -4px;
    background: #dfb3d1;
  }

  .about-hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    padding: 120px 42px 88px;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 44px;
  }

  .about-hero__copy {
    max-width: 760px;
  }

  .about-hero__copy > p:first-child,
  .about-research header > span,
  .about-play__copy > span,
  .about-contact h2 + span,
  .about-contact [data-reveal] > span {
    color: #c6c8df;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .about-hero h1 {
    margin: 14px 0 0;
    line-height: 1.2;
  }

  .about-hero h1 span {
    display: block;
    font-family: var(--font-reading);
    font-size: clamp(1.5rem, 2.5vw, 2.4rem);
    font-weight: 500;
  }

  .about-hero h1 strong {
    display: block;
    font-family: var(--font-reading);
    font-size: clamp(3.2rem, 6.1vw, 6rem);
    overflow-wrap: anywhere;
    font-weight: 500;
  }

  .about-hero__alias {
    margin: 26px 0 0;
    font-family: var(--font-reading);
    font-size: 1.1rem;
  }

  .about-hero__alias b {
    color: #eec5dc;
  }

  .about-hero__intro {
    max-width: 620px;
    margin: 14px 0 0;
    line-height: 1.85;
    text-shadow: 0 2px 20px rgb(0 0 0 / 52%);
  }

  .about-hero__copy > a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0 7px;
    margin-top: 24px;
    border-bottom: 2px solid currentColor;
    font-weight: 800;
    text-decoration: none;
  }

  .about-hero__status {
    display: grid;
    padding-bottom: 10px;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .about-hero__status span {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .about-research {
    padding-block: clamp(82px, 11vw, 150px);
    background: var(--color-bg);
  }

  .about-research header {
    display: grid;
    margin-bottom: 68px;
    grid-template-columns: minmax(0, 0.85fr) minmax(440px, 1.15fr);
    gap: 12px 54px;
    align-items: end;
  }

  .about-research header > span {
    grid-column: 1 / -1;
    color: var(--color-cyan);
  }

  .about-research h2,
  .about-play h2,
  .about-contact h2 {
    margin: 0;
    letter-spacing: 0;
  }

  .about-research h2 {
    font-family: var(--font-reading);
    font-size: clamp(2.7rem, 4.5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.06;
  }

  .about-research header > p {
    max-width: 560px;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.85;
  }

  .about-research__list {
    border-top: 1px solid var(--color-line);
  }

  .about-research__list article {
    display: grid;
    min-height: 170px;
    padding-block: 30px;
    grid-template-columns: 80px minmax(260px, 0.75fr) minmax(360px, 1.25fr);
    align-items: center;
    gap: 28px;
    border-bottom: 1px solid var(--color-line);
  }

  .about-research__list article > span {
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 850;
  }

  .about-research__list h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    overflow-wrap: anywhere;
    line-height: 1.4;
  }

  .about-research__list p {
    max-width: 600px;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .about-research blockquote {
    display: grid;
    max-width: 920px;
    padding: 58px 0 0;
    margin: 72px 0 0 auto;
    grid-template-columns: auto 1fr;
    gap: 22px;
    border-top: 4px solid var(--color-cyan);
  }

  .about-research blockquote :global(svg) {
    color: var(--color-rose);
  }

  .about-research blockquote p {
    margin: 0;
    font-family: var(--font-reading);
    font-size: 3rem;
    line-height: 1.45;
  }

  .about-play {
    display: grid;
    min-height: 720px;
    grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);
    background: var(--color-bg);
  }

  .about-play__image {
    min-height: 720px;
    overflow: hidden;
  }

  .about-play__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% center;
  }

  .about-play__copy {
    display: flex;
    max-width: 680px;
    padding: clamp(64px, 8vw, 116px);
    flex-direction: column;
    justify-content: center;
  }

  .about-play__copy > span {
    color: var(--color-rose);
  }

  .about-play h2 {
    margin-top: 20px;
    font-family: var(--font-reading);
    font-size: clamp(2.6rem, 4.5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .about-play__copy > p {
    max-width: 530px;
    margin: 30px 0 0;
    color: var(--color-muted);
    line-height: 1.9;
  }

  .about-play ul {
    display: grid;
    padding: 0;
    margin: 42px 0 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .about-play li {
    padding: 14px 4px;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .about-play li:nth-child(odd) {
    border-right: 1px solid var(--color-line);
  }

  .about-play li:nth-child(even) {
    padding-left: 18px;
  }

  .about-contact {
    padding: clamp(84px, 11vw, 150px) 0 34px;
    background: var(--art-paper);
    color: var(--color-ink);
  }

  .about-contact > div {
    display: grid;
    grid-template-columns: minmax(360px, 0.9fr) minmax(420px, 1.1fr);
    gap: clamp(58px, 9vw, 140px);
  }

  .about-contact [data-reveal] > span {
    color: var(--color-rose);
  }

  .about-contact h2 {
    margin-top: 18px;
    font-family: var(--font-reading);
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
  }

  .about-contact__body > p:first-child {
    max-width: 560px;
    margin: 12px 0 36px;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .about-contact__invitation {
    max-width: 340px;
    margin-top: 36px;
    margin-left: 10px;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .about-contact nav {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .about-contact nav a,
  .about-contact nav button {
    display: grid;
    min-height: 66px;
    padding: 12px 4px;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    color: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .about-contact nav a:hover,
  .about-contact nav button:hover {
    padding-inline: 12px;
    background: #17151a;
    color: #fff;
  }

  .about-contact__feedback {
    min-height: 1.5em;
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .about-contact footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 96px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  @media (max-width: 980px) {
    .about-hero h1 span {
      font-size: 2.8rem;
    }

    .about-hero h1 strong {
      font-size: clamp(2.75rem, 6vw, 5rem);
    }

    .about-hero__status {
      display: none;
    }

    .about-hero__content,
    .about-research header,
    .about-play,
    .about-contact > div {
      grid-template-columns: 1fr;
    }

    .about-research__list article {
      grid-template-columns: 54px minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .about-research h2 {
      font-size: clamp(1.5rem, 2.5vw, 2.4rem);
    }

    .about-research__list h3 {
      font-size: 1.65rem;
    }

    .about-research blockquote p {
      font-size: 2.2rem;
    }

      .about-contact h2 {
      font-size: 4.2rem;
    }

    .about-play h2 {
      font-size: 4rem;
    }

    .about-play__image {
      min-height: 560px;
      aspect-ratio: 16 / 10;
    }

    .about-play__copy {
      max-width: none;
    }
  }

  @media (max-width: 620px) {
    .about-hero {
      height: 88svh;
      min-height: 640px;
    }

    .about-hero__art {
      object-position: 54% 28%;
    }

    .about-hero__shade {
      background: rgb(7 13 18 / 50%);
      box-shadow: inset 0 -240px 160px rgb(7 12 17 / 48%);
    }

    .about-hero__frame {
      inset: 74px 14px 38px;
    }

    .about-hero__content {
      padding: 112px 0 72px;
    }

    .about-hero h1 strong {
      overflow-wrap: anywhere;
      font-size: clamp(2rem, 8.8vw, 3rem);
    }

    .about-hero h1 span {
      font-size: 1.8rem;
    }

    .about-research header {
      margin-bottom: 42px;
    }

    .about-research h2 {
      font-size: 2.6rem;
    }

    .about-research__list article {
      padding-block: 24px;
      grid-template-columns: 40px 1fr;
      gap: 8px 14px;
    }

    .about-research__list article p {
      grid-column: 2;
    }

    .about-research blockquote {
      padding-top: 36px;
      margin-top: 52px;
    }

    .about-research__list h3 {
      font-size: 1.35rem;
    }

    .about-research blockquote p {
      font-size: 1.65rem;
    }

      .about-contact h2 {
      font-size: 2.7rem;
    }

    .about-play h2 {
      font-size: 2.8rem;
    }



    .about-play__image {
      width: 100%;
      height: 430px;
      min-height: 0;
      aspect-ratio: auto;
    }

    .about-play__copy {
      padding: 54px var(--page-inline) 76px;
    }

    .about-contact > div {
      gap: 54px;
    }

    .about-contact footer {
      display: grid;
      padding-top: 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) { .about-hero__art { transform: none; } }

  @media (max-width: 350px) {
    .about-hero h1 strong {
      font-size: 2rem;
    }
  }
</style>
