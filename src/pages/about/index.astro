---
import { Image } from "astro:assets";
import {
  ArrowUpRight,
  Copy,
  GitFork,
  GraduationCap,
  Mail,
  Tv,
} from "@lucide/astro";
import AboutPrologue from "../../components/art/AboutPrologue.astro";
import playPortrait from "../../assets/demo/sparkle-portrait.webp";
import DirectedPointer from "../../components/DirectedPointer.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { profileConfig } from "../../config/profile";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="关于"
  description={`${profileConfig.handle} 的研究方向、技术兴趣与联系方式。`}
  bodyClass="about-page"
  directedPointer
>
  <SiteHeader variant="reading" />

  <main id="main-content">
    <AboutPrologue />

    <section id="research" class="about-research" data-about-research>
      <div class="page-width">
        <header>
          <div><span>01 / RESEARCH DIRECTIONS</span><h2>关注的<br />方向<span>。</span></h2></div>
          <p>
            我关心模型怎样听懂话语，<br />也怎样理解说话的人。
          </p>
          <div class="about-research__position" aria-hidden="true"><span data-direction-current>01</span><i></i><span>{String(profileConfig.research.length).padStart(2,"0")}</span></div>
        </header>

        <div class="about-research__list">
          {
            profileConfig.research.map((item) => (
              <article data-direction data-direction-index={item.index}>
                <span>{item.index}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about-play" id="after-hours" aria-labelledby="play-title" data-about-play>
      <div class="about-play__stage">
      <div class="about-play__image">
        <Image
          src={playPortrait}
          alt="带有戏剧化构图的角色插画"
          widths={[720, 1080, 1440]}
          sizes="(max-width: 820px) 100vw, 52vw"
          loading="lazy"
        />
      </div>
      <div class="about-play__copy">
        <span>02 / AFTER HOURS</span>
        <h2 id="play-title">主线之外，<br />总有兔子洞</h2>
        <p>
          研究之外，也认真玩耍。<br />好奇心把我带到了这些地方。
        </p>
        <ul>
          {profileConfig.curiosities.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <span class="about-play__cue" aria-hidden="true">向下，跟着好奇心走走 ↓</span>
      </div>
    </section>

    <section class="about-contact" data-about-contact id="contact" aria-labelledby="contact-title">
      <div class="page-width">
        <div>
          <span>03 / CONTACT</span>
          <h2 id="contact-title">在其他地方<br>找到我</h2>
          <p class="about-contact__invitation">
            如果有任何想法 <br>
            Feel free to reach out. (｡･ω･｡)ﾉ
          </p>
        </div>
        <div class="about-contact__body">
          <p>
            代码、研究和偶尔的创作，散落在这些地方。
          </p>
          <nav aria-label="个人链接">
            <a href={profileConfig.links.github}>
              <GitFork aria-hidden="true" size={19} stroke-width={1.8} />
              <span><b>GitHub</b><small>代码与项目</small></span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <a href={profileConfig.links.academic} target="_blank" rel="noopener noreferrer">
              <GraduationCap aria-hidden="true" size={19} stroke-width={1.8} />
              <span><b>Academic</b><small>论文与研究</small></span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <a href={profileConfig.links.bilibili} target="_blank" rel="noopener noreferrer">
              <Tv aria-hidden="true" size={19} stroke-width={1.8} />
              <span><b>Bilibili</b><small>在画面与声音里</small></span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <button
              type="button"
              data-copy-email
              data-email={profileConfig.links.email}
              aria-label="复制联系邮箱"
              title="复制联系邮箱"
            >
              <Mail aria-hidden="true" size={19} stroke-width={1.8} />
              <span><b data-email-label>{profileConfig.links.email}</b><small>写封邮件</small></span>
              <Copy aria-hidden="true" size={17} stroke-width={1.8} />
            </button>
          </nav>
          <p class="about-contact__feedback" aria-live="polite" data-copy-feedback>
          </p>
        </div>
      </div>
      <footer class="page-width">
        <span>PROMETHEUS © 2026</span>
        <span>谢谢你看到这里。</span>
      </footer>
    </section>
  </main>

  <DirectedPointer />

</BaseLayout>

<script>
  import { mountAboutStory } from "../../components/art/about-story";
  mountAboutStory();
  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyFeedback = document.querySelector<HTMLElement>(
    "[data-copy-feedback]",
  );

  copyButton?.addEventListener("click", async () => {
    const obfuscated = copyButton.dataset.email;
    if (!obfuscated) return;

    const address = obfuscated.replace("#", "@");
    try {
      await navigator.clipboard.writeText(address);
      if (copyFeedback) copyFeedback.textContent = "邮箱已复制。";
    } catch {
      if (copyFeedback) {
        copyFeedback.textContent = `复制失败，请手动输入 ${obfuscated}`;
      }
    }
  });
</script>

<style>
  .about-research {
    position: relative;
    background: var(--paper-cyan,var(--color-bg));
    padding-block: 90px;
  }

  .about-research > .page-width {
    display: grid;
    grid-template-columns: .76fr 1.24fr;
    align-items: start;
    gap: 100px;
  }

  .about-research header {
    position: sticky;
    top: 110px;
    padding-top: 35px;
  }

  .about-research header > div > span {
    color: var(--color-cyan);
    font: .7rem var(--font-mono);
    letter-spacing: .1em;
  }

  .about-research h2 {
    margin: 28px 0;
    font: 400 var(--type-section-title,3rem)/1.3 var(--font-reading);
  }

  .about-research header > p {
    max-width: 28ch;
    color: var(--color-muted);
    font: 1.2rem/1.9 var(--font-reading);
  }

  .about-research__list {
    border-top: 1px solid color-mix(in srgb,var(--color-cyan) 35%,transparent);
  }

  .about-research__list article {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 20px;
    padding: 48px 0 48px 18px;
    min-height: 240px;
    position: relative;
    border-bottom: 1px solid color-mix(in srgb,var(--color-cyan) 25%,transparent);
  }

  .about-research__list article > span {
    grid-row: 1/3;
    padding-top: 5px;
    color: var(--color-cyan);
    font: italic 3.8rem/1 var(--font-reading);
    opacity: .5;
  }

  .about-research__list h3 {
    margin: 0;
    font: 400 1.9rem/1.4 var(--font-reading);
  }

  .about-research__list p {
    grid-column: 2;
    margin: 0;
    color: var(--color-muted);
    font-size: .95rem;
    line-height: 1.95;
  }

  [data-direction][data-scene-ready] {
    opacity: var(--direction-opacity,1);
    transform: translateX(var(--direction-x,0px));
  }

  .about-play {
    position: relative;
    background: #211d2d;
    color: #f5edf5;
  }

  .about-play__stage {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    min-height: 720px;
  }

  .about-play__image {
    overflow: hidden;
  }

  .about-play__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 20% center;
  }

  .about-play__copy {
    align-self: center;
    padding: 70px 80px;
  }

  .about-play__copy > span {
    display: block;
    margin-bottom: 24px;
    color: #dba9c7;
    font: .7rem var(--font-mono);
    letter-spacing: .1em;
  }

  .about-play h2 {
    margin: 0 0 28px;
    font: 400 var(--type-section-title,3rem)/1.3 var(--font-reading);
  }

  .about-play__copy > p {
    margin: 0;
    color: #c6b9cd;
    font-size: .95rem;
    line-height: 1.95;
  }

  .about-play ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  .about-play li {
    padding: 12px 14px;
    border: 1px solid #b499bc47;
    background: #e1c6e60a;
    color: #e0d1e8;
    font: .8125rem/1.6 var(--font-mono);
  }

  .about-play__cue {
    display: none;
  }

  .about-play[data-scene-ready] {
    height: 165svh;
  }

  [data-scene-ready] .about-play__stage {
    position: sticky;
    top: 0;
    translate: 0 var(--scene-offset,0px);
    z-index: var(--scene-layer,auto);
    height: 100svh;
    min-height: 650px;
    overflow: hidden;
    isolation: isolate;
  }

  [data-scene-ready] .about-play__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    clip-path: inset(0 var(--play-clip,0%) 0 0);
  }

  [data-scene-ready] .about-play__image :global(img) {
    width: 100%;
    height: 100%;
    object-position: 20% center;
    transform: translateX(var(--play-image-x,0px)) scale(var(--play-image-scale,1));
  }

  [data-scene-ready] .about-play__stage::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background: linear-gradient(90deg,transparent 20%,#211d2dcc 63%,#211d2df5);
    opacity: var(--play-shade,1);
  }

  [data-scene-ready] .about-play__copy {
    position: absolute;
    left: 55%;
    top: 20%;
    width: 39%;
    padding: 0;
    transform: translateY(var(--play-copy-y,130px));
  }

  [data-scene-ready].about-play h2 {
    transform: scale(var(--play-title-scale,1));
    transform-origin: left center;
  }

  [data-scene-ready] .about-play__copy > p, [data-scene-ready].about-play ul {
    opacity: var(--play-details,0);
    transform: translateX(var(--play-details-x,60px));
  }

  [data-scene-ready] .about-play__cue {
    display: block;
    position: absolute;
    bottom: 35px;
    right: 6%;
    color: #d3c3d7;
    font-size: .7rem;
  }

  .about-contact {
    background: var(--paper-gold,var(--art-paper));
    padding: 90px 0 30px;
  }

  .about-contact > .page-width {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 90px;
    align-items: start;
  }

  .about-contact > div > div > span {
    color: var(--color-gold);
    font: .7rem var(--font-mono);
  }

  .about-contact h2 {
    margin: 28px 0 35px;
    font: 400 var(--type-section-title,3rem)/1.3 var(--font-reading);
  }

  .about-contact__invitation {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.9;
  }

  .about-contact__body > p {
    margin: 0 0 30px;
    font-size: 1rem;
    line-height: 1.9;
  }

  .about-contact nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .about-contact nav a, .about-contact nav button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-width: 0;
    min-height: 95px;
    padding: 20px 4px;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb,var(--color-gold) 28%,transparent);
    background: transparent;
    font-size: .8rem;
    text-decoration: none;
    cursor: pointer;
  }

  .about-contact nav svg:first-child {
    color: var(--color-gold);
  }

  .about-contact nav span {
    flex: 1;
    overflow-wrap: anywhere;
  }

  .about-contact nav a:hover, .about-contact nav button:hover {
    border-color: var(--color-gold);
  }

  .about-contact__feedback {
    min-height: 24px;
    margin: 14px 0 0!important;
    color: var(--color-muted);
    font-size: .8rem!important;
  }

  .about-contact footer {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    padding-top: 64px;
    color: var(--color-muted);
    font: .65rem var(--font-mono);
  }

  [data-about-contact][data-scene-ready] .about-contact__body {
    transform: translateY(var(--contact-y,0px));
    opacity: var(--contact-opacity,1);
  }

  .about-research h2 {
    font-size: clamp(3rem,4.5vw,4.5rem);
    line-height: 1.4;
  }

  .about-research h2 > span {
    color: var(--color-cyan);
  }

  .about-research__position {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 45px;
    max-width: 230px;
    color: var(--color-cyan);
    font: .8rem var(--font-mono);
  }

  .about-research__position i {
    position: relative;
    width: 100%;
    height: 1px;
    background: color-mix(in srgb,var(--color-cyan) 22%,transparent);
  }

  .about-research__position i::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: scaleX(var(--research-progress,0));
    transform-origin: left;
    background: var(--color-cyan);
  }

  .about-research__list article::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg,color-mix(in srgb,var(--paper-white) 65%,transparent),transparent);
    opacity: var(--direction-emphasis,0);
  }

  .about-research__list article > * {
    position: relative;
    z-index: 1;
  }

  .about-contact {
    position: relative;
  }

  .about-contact h2 {
    font-size: clamp(3rem,4.3vw,4.2rem);
    line-height: 1.4;
  }

  .about-contact nav {
    border-top: 1px solid color-mix(in srgb,var(--color-gold) 28%,transparent);
  }

  .about-contact nav b {
    font: 400 1.5rem var(--font-reading);
  }

  .about-contact nav small {
    display: block;
    margin-top: 8px;
    font: .75rem var(--font-ui);
    color: var(--color-muted);
  }

  .about-contact nav button {
    text-align: left;
  }

  .about-contact nav button b {
    font-size: 1.12rem;
  }

  .about-contact nav a:hover, .about-contact nav button:hover {
    color: var(--color-gold);
    background: color-mix(in srgb,var(--paper-white) 35%,transparent);
  }

  .about-contact__invitation {
    max-width: 350px;
  }

  @media (max-width:1023px) {
    .about-research > .page-width, .about-play__stage, .about-contact > .page-width {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about-research header {
      position: static;
    }

    .about-play__image {
      height: 500px;
    }

    .about-play__copy {
      padding: 50px var(--page-inline);
    }

  }
</style>
