---
import { Image } from "astro:assets";
import {
  ArrowDownRight,
  ArrowUpRight,
  Copy,
  GitFork,
  GraduationCap,
  Mail,
  Microscope,
  Tv,
} from "@lucide/astro";
import aboutPortrait from "../../assets/demo/elysia-portrait.webp";
import playPortrait from "../../assets/demo/sparkle-portrait.webp";
import ResearchSketch from "../../components/art/ResearchSketch.astro";
import DirectedPointer from "../../components/DirectedPointer.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { profileConfig } from "../../config/profile";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="关于"
  description={`${profileConfig.handle} 的研究方向、技术兴趣与联系方式。`}
  bodyClass="about-page"
  directedPointer
>
  <SiteHeader variant="reading" />

  <main id="main-content">
    <div class="about-introduction-shell"><section class="about-introduction page-width" aria-labelledby="about-title">
      <div class="about-introduction__copy">
        <p class="about-introduction__eyebrow">ABOUT / 0017</p>
        <h1 id="about-title"><span>你好，我是</span><strong>{profileConfig.handle}</strong></h1>
        <p class="about-introduction__alias">也使用网名 <b>{profileConfig.alias}</b></p>
        <p class="about-introduction__intro">{profileConfig.introduction}。</p>
        <div class="about-introduction__status" aria-label="当前状态">
          <span><GraduationCap size={17} aria-hidden="true" />{profileConfig.education}</span>
          <span><Microscope size={17} aria-hidden="true" />{profileConfig.nextStage}</span>
        </div>
        <a href="#research">关注的方向 <ArrowDownRight size={18} aria-hidden="true" /></a>
      </div>
      <figure class="about-introduction__portrait">
        <Image src={aboutPortrait} alt="花园茶会中的爱莉希雅" widths={[600,900,1200]} sizes="(max-width:760px) 80vw, 40vw" loading="eager" />
        <figcaption>研究之外，也认真玩耍。</figcaption>
      </figure>
    </section></div>

    <section id="research" class="about-research">
      <div class="page-width">
        <header data-reveal>
          <div><span>01 / RESEARCH DIRECTIONS</span><h2>关注的方向</h2></div>
          <p>
            我关心模型怎样听懂话语，也怎样理解说话的人。
          </p>
        </header>

        <div class="about-research__list">
          {
            profileConfig.research.map((item) => (
              <article data-reveal>
                <span>{item.index}</span>
                <h3>{item.title}</h3>
                <ResearchSketch index={item.index} />
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about-play" id="after-hours" aria-labelledby="play-title">
      <div class="about-play__image" data-reveal="left">
        <Image
          src={playPortrait}
          alt="带有戏剧化构图的角色插画"
          widths={[720, 1080, 1440]}
          sizes="(max-width: 820px) 100vw, 52vw"
          loading="lazy"
        />
      </div>
      <div class="about-play__copy" data-reveal="right">
        <span>02 / AFTER HOURS</span>
        <h2 id="play-title">主线之外，<br />总有兔子洞</h2>
        <p>
          研究之外，也认真玩耍。<br />好奇心把我带到了这些地方。
        </p>
        <ul>
          {profileConfig.curiosities.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="about-contact" id="contact" aria-labelledby="contact-title">
      <div class="page-width">
        <div data-reveal>
          <span>03 / CONTACT</span>
          <h2 id="contact-title">在其他地方<br>找到我</h2>
          <p class="about-contact__invitation">
            如果有任何想法 <br>
            Feel free to reach out. (｡･ω･｡)ﾉ
          </p>
        </div>
        <div class="about-contact__body" data-reveal data-reveal-delay="1">
          <p>
            代码、研究和偶尔的创作，散落在这些地方。
          </p>
          <nav aria-label="个人链接">
            <a href={profileConfig.links.github}>
              <GitFork aria-hidden="true" size={19} stroke-width={1.8} />
              <span>GitHub</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <a href={profileConfig.links.academic} target="_blank" rel="noopener noreferrer">
              <GraduationCap aria-hidden="true" size={19} stroke-width={1.8} />
              <span>Academic</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <a href={profileConfig.links.bilibili} target="_blank" rel="noopener noreferrer">
              <Tv aria-hidden="true" size={19} stroke-width={1.8} />
              <span>Bilibili</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <button
              type="button"
              data-copy-email
              data-email={profileConfig.links.email}
              aria-label="复制联系邮箱"
              title="复制联系邮箱"
            >
              <Mail aria-hidden="true" size={19} stroke-width={1.8} />
              <span data-email-label>{profileConfig.links.email}</span>
              <Copy aria-hidden="true" size={17} stroke-width={1.8} />
            </button>
          </nav>
          <p class="about-contact__feedback" aria-live="polite" data-copy-feedback>
          </p>
        </div>
      </div>
      <footer class="page-width">
        <span>PROMETHEUS © 2026</span>
        <span>END OF TRANSMISSION</span>
      </footer>
    </section>
  </main>

  <DirectedPointer />
  <ScrollReveal />
</BaseLayout>

<script>
  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyFeedback = document.querySelector<HTMLElement>(
    "[data-copy-feedback]",
  );

  copyButton?.addEventListener("click", async () => {
    const obfuscated = copyButton.dataset.email;
    if (!obfuscated) return;

    const address = obfuscated.replace("#", "@");
    try {
      await navigator.clipboard.writeText(address);
      if (copyFeedback) copyFeedback.textContent = "邮箱已复制。";
    } catch {
      if (copyFeedback) {
        copyFeedback.textContent = `复制失败，请手动输入 ${obfuscated}`;
      }
    }
  });
</script>

<style>
  .about-page {
    background: var(--color-bg);
  }

  .about-introduction {
    display: grid;
    grid-template-columns: minmax(0,1.15fr) minmax(0,.85fr);
    gap: clamp(40px,7vw,100px);
    align-items: center;
    padding-block: 80px 100px;
  }

  .about-introduction__eyebrow {
    margin: 0 0 32px;
    color: var(--color-rose);
    font: .65rem var(--font-mono);
    letter-spacing: .14em;
  }

  .about-introduction h1 {
    margin: 0;
    font-family: var(--font-reading);
    line-height: 1.25;
    font-weight: 400;
  }

  .about-introduction h1 span {
    display: block;
    font-size: clamp(1.8rem,3vw,3rem);
    font-weight: 400;
  }

  .about-introduction h1 strong {
    display: block;
    margin-top: 16px;
    font-size: clamp(2.4rem,4.1vw,3.6rem);
    font-weight: 400;
    letter-spacing: -.04em;
    overflow-wrap: anywhere;
  }

  .about-introduction__alias {
    margin: 26px 0 0;
    font-size: .8rem;
    color: var(--color-muted);
  }

  .about-introduction__alias b {
    font-weight: 500;
    color: var(--color-rose);
  }

  .about-introduction__intro {
    max-width: 500px;
    margin-top: 24px;
    color: var(--color-muted);
    font-size: .9rem;
    line-height: 1.95;
  }

  .about-introduction__status {
    display: grid;
    gap: 12px;
    padding-top: 28px;
    margin-top: 30px;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font: .76rem var(--font-mono);
  }

  .about-introduction__status > span {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .about-introduction__copy > a {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    min-height: 46px;
    margin-top: 28px;
    border-bottom: 1px solid var(--color-line);
    font-size: .8rem;
    text-decoration: none;
  }

  .about-introduction__portrait {
    margin: 0;
    padding-inline: 12px;
  }

  .about-introduction__portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: .74;
    object-fit: cover;
    border-radius: 999px 999px 0 0;
  }

  .about-introduction__portrait figcaption {
    margin-top: 20px;
    text-align: right;
    color: var(--color-muted);
    font-size: .68rem;
    letter-spacing: .06em;
  }

  @media (max-width:760px) {
    .about-introduction {
      grid-template-columns: 1fr;
      padding-block: 52px 70px;
      gap: 48px;
    }

    .about-introduction__portrait {
      grid-row: 1;
      width: 65%;
      max-width: 360px;
      margin-left: auto;
      padding: 0;
    }

    .about-introduction__copy {
      margin-top: -64px;
      position: relative;
      z-index: 1;
    }

    .about-introduction__eyebrow {
      max-width: 9ch;
      margin-bottom: 22px;
    }

    .about-introduction h1 strong {
      font-size: clamp(2rem,8.5vw,3.5rem);
    }

    .about-introduction__portrait figcaption {
      display: none;
    }

  }

  .about-research {
    padding-block: clamp(82px, 11vw, 150px);
    background: var(--paper-cyan, var(--color-bg));
  }

  .about-research header {
    display: grid;
    margin-bottom: 68px;
    grid-template-columns: minmax(0, 0.85fr) minmax(440px, 1.15fr);
    gap: 12px 54px;
    align-items: end;
  }

  .about-research header > span {
    grid-column: 1 / -1;
    color: var(--color-cyan);
  }

  .about-research h2, .about-play h2, .about-contact h2 {
    margin: 0;
    letter-spacing: 0;
  }

  .about-research h2 {
    font-family: var(--font-reading);
    font-size: clamp(2.7rem, 4.5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.06;
  }

  .about-research header > p {
    max-width: 560px;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.85;
  }

  .about-research__list {
    border-top: 1px solid var(--color-line);
  }

  .about-research__list article {
    display: grid;
    min-height: 170px;
    padding-block: 30px;
    grid-template-columns: 80px minmax(260px, 0.75fr) minmax(360px, 1.25fr);
    align-items: center;
    gap: 28px;
    border-bottom: 1px solid var(--color-line);
  }

  .about-research__list article > span {
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 850;
  }

  .about-research__list h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    overflow-wrap: anywhere;
    line-height: 1.4;
  }

  .about-research__list p {
    max-width: 600px;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .about-play {
    display: grid;
    min-height: 720px;
    grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);
    background: var(--color-bg);
  }

  .about-play__image {
    min-height: 720px;
    overflow: hidden;
  }

  .about-play__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% center;
  }

  .about-play__copy {
    display: flex;
    max-width: 680px;
    padding: clamp(64px, 8vw, 116px);
    flex-direction: column;
    justify-content: center;
  }

  .about-play__copy > span {
    color: var(--color-rose);
  }

  .about-play h2 {
    margin-top: 20px;
    font-family: var(--font-reading);
    font-size: clamp(2.6rem, 4.5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .about-play__copy > p {
    max-width: 530px;
    margin: 30px 0 0;
    color: var(--color-muted);
    line-height: 1.9;
  }

  .about-play ul {
    display: grid;
    padding: 0;
    margin: 42px 0 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .about-play li {
    padding: 14px 4px;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .about-play li:nth-child(odd) {
    border-right: 1px solid var(--color-line);
  }

  .about-play li:nth-child(even) {
    padding-left: 18px;
  }

  .about-contact {
    padding: clamp(84px, 11vw, 150px) 0 34px;
    background: var(--art-paper);
    color: var(--color-ink);
  }

  .about-contact > div {
    display: grid;
    grid-template-columns: minmax(360px, 0.9fr) minmax(420px, 1.1fr);
    gap: clamp(58px, 9vw, 140px);
  }

  .about-contact [data-reveal] > span {
    color: var(--color-rose);
  }

  .about-contact h2 {
    margin-top: 18px;
    font-family: var(--font-reading);
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
  }

  .about-contact__body > p:first-child {
    max-width: 560px;
    margin: 12px 0 36px;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .about-contact__invitation {
    max-width: 340px;
    margin-top: 36px;
    margin-left: 10px;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .about-contact nav {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .about-contact nav a, .about-contact nav button {
    display: grid;
    min-height: 66px;
    padding: 12px 4px;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    color: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .about-contact nav a:hover, .about-contact nav button:hover {
    padding-inline: 12px;
    background: #17151a;
    color: #fff;
  }

  .about-contact__feedback {
    min-height: 1.5em;
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .about-contact footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 96px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  @media (max-width: 980px) {
    .about-research header, .about-play, .about-contact > div {
      grid-template-columns: 1fr;
    }

    .about-research__list article {
      grid-template-columns: 54px minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .about-research h2 {
      font-size: 3.2rem;
    }

    .about-research__list h3 {
      font-size: 1.65rem;
    }

    .about-contact h2 {
      font-size: 4.2rem;
    }

    .about-play h2 {
      font-size: 4rem;
    }

    .about-play__image {
      min-height: 560px;
      aspect-ratio: 16 / 10;
    }

    .about-play__copy {
      max-width: none;
    }

  }

  @media (max-width: 620px) {
    .about-research header {
      margin-bottom: 42px;
    }

    .about-research h2 {
      font-size: 2.6rem;
    }

    .about-research__list article {
      padding-block: 24px;
      grid-template-columns: 40px 1fr;
      gap: 8px 14px;
    }

    .about-research__list article p {
      grid-column: 2;
    }

    .about-research__list h3 {
      font-size: 1.35rem;
    }

    .about-contact h2 {
      font-size: 2.7rem;
    }

    .about-play h2 {
      font-size: 2.8rem;
    }

    .about-play__image {
      width: 100%;
      height: 430px;
      min-height: 0;
      aspect-ratio: auto;
    }

    .about-play__copy {
      padding: 54px var(--page-inline) 76px;
    }

    .about-contact > div {
      gap: 54px;
    }

    .about-contact footer {
      display: grid;
      padding-top: 72px;
    }

  }
  @media (min-width: 1024px) {
    .about-introduction-shell {
      background: var(--paper-gold);
      border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 24%, transparent);
    }

    .about-introduction {
      padding-block: 64px 74px;
      gap: 110px;
    }

    .about-introduction__eyebrow {
      color: var(--color-gold);
      font-size: .7rem;
      margin-bottom: 28px;
    }

    .about-introduction h1 span {
      font-size: 1.8rem;
    }

    .about-introduction h1 strong {
      font-size: 3.5rem;
      line-height: 1.2;
      letter-spacing: -.05em;
    }

    .about-introduction__intro {
      font-size: 1rem;
      max-width: 500px;
    }

    .about-introduction__alias {
      margin-top: 22px;
    }

    .about-introduction__status {
      border-color: color-mix(in srgb, var(--color-gold) 28%, transparent);
      padding-top: 22px;
      margin-top: 28px;
    }

    .about-introduction__status svg {
      color: var(--color-gold);
    }

    .about-introduction__portrait {
      position: relative;
      padding: 15px 15px 0;
      border: 1px solid color-mix(in srgb, var(--color-gold) 22%, transparent);
      background: color-mix(in srgb, var(--paper-white) 60%, transparent);
      transform: rotate(2deg);
    }

    .about-introduction__portrait img {
      height: 490px;
      aspect-ratio: auto;
      border-radius: 180px 180px 2px 2px;
      object-position: center 30%;
    }

    .about-introduction__portrait figcaption {
      margin: 18px 0;
      text-align: center;
      font-family: var(--font-reading);
      font-size: .8rem;
    }

    .about-research {
      padding-block: 88px 96px;
      background: var(--paper-cyan);
    }

    .about-research header {
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: end;
      margin-bottom: 44px;
    }

    .about-research header span {
      display: block;
      color: var(--color-cyan);
      font: .7rem var(--font-mono);
      letter-spacing: .1em;
      margin-bottom: 22px;
    }

    .about-research h2, .about-play h2, .about-contact h2 {
      font-size: var(--type-section-title);
      line-height: 1.3;
    }

    .about-research header > p {
      margin: 0 0 4px;
      font-size: 1.1rem;
      line-height: 1.9;
      max-width: 30ch;
    }

    .about-research__list {
      display: grid;
      grid-template-columns: repeat(3,minmax(0,1fr));
      gap: 26px;
      border: 0;
    }

    .about-research__list article {
      display: flex;
      flex-direction: column;
      align-items: start;
      padding: 30px;
      border: 0;
      border-top: 3px solid color-mix(in srgb,var(--color-cyan) 60%,transparent);
      background: var(--paper-white);
    }

    .about-research__list article > span {
      font: italic 2rem/1 var(--font-reading);
      color: color-mix(in srgb,var(--color-cyan) 70%,transparent);
      margin-bottom: 20px;
    }

    .about-research__list h3 {
      min-height: 0;
      margin: 0 0 16px;
      font: 500 1.5rem/1.4 var(--font-reading);
    }

    .about-research__list p {
      margin: 0;
      font-size: .95rem;
      line-height: 1.95;
    }

    .about-play {
      background: #211d2d;
      color: #f5edf5;
      grid-template-columns: 1fr 1.05fr;
    }

    .about-play__image {
      min-height: 650px;
    }

    .about-play__image :global(img) {
      object-position: 20% center;
    }

    .about-play__copy {
      padding: 70px 80px;
    }

    .about-play__copy > span {
      display: block;
      margin-bottom: 24px;
      color: #dba9c7;
      font: .7rem var(--font-mono);
      letter-spacing: .1em;
    }

    .about-play h2 {
      margin: 0 0 28px;
    }

    .about-play__copy > p {
      font-size: .95rem;
      line-height: 1.95;
      color: #c6b9cd;
    }

    .about-play ul {
      border-top: 0;
      gap: 12px;
      margin-top: 32px;
    }

    .about-play li {
      border: 1px solid #b499bc47;
      background: #e1c6e60a;
      color: #e0d1e8;
      padding: 12px 14px;
      font-size: .75rem;
    }

    .about-play li:nth-child(odd), .about-play li:nth-child(even) {
      border-right: 1px solid #b499bc47;
      padding: 12px 14px;
      font-size: .8125rem;
      transform: none;
    }

    .about-contact {
      padding-top: 90px;
      background: var(--paper-gold);
    }

    .about-contact > div {
      gap: 90px;
      align-items: start;
    }

    .about-contact [data-reveal] > span {
      color: var(--color-gold);
      font-size: .7rem;
    }

    .about-contact nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .about-contact nav a, .about-contact nav button {
      min-width: 0;
      min-height: 78px;
      padding: 20px;
      border: 1px solid color-mix(in srgb,var(--color-gold) 20%,transparent);
      background: var(--paper-white);
      font-size: .8rem;
    }

    .about-contact nav a > svg:first-child, .about-contact nav button > svg:first-child {
      color: var(--color-gold);
    }

    .about-contact nav a:hover, .about-contact nav button:hover {
      border-color: var(--color-gold);
      background: var(--paper-white);
    }

  }
</style>
