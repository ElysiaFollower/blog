---
import { Image } from "astro:assets";
import {
  ArrowDownRight,
  ArrowUpRight,
  Copy,
  GitFork,
  GraduationCap,
  Mail,
  Microscope,
  Tv,
} from "@lucide/astro";
import aboutPortrait from "../../assets/demo/elysia-portrait.webp";
import playPortrait from "../../assets/demo/sparkle-portrait.webp";
import DirectedPointer from "../../components/DirectedPointer.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { profileConfig } from "../../config/profile";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="关于"
  description={`${profileConfig.handle} 的研究方向、技术兴趣与联系方式。`}
  bodyClass="about-page"
  directedPointer
>
  <SiteHeader variant="reading" />

  <main id="main-content">
    <div class="about-introduction-shell" data-about-intro><section class="about-introduction page-width" aria-labelledby="about-title">
      <div class="about-introduction__copy">
        <p class="about-introduction__eyebrow">ABOUT / 0017</p>
        <h1 id="about-title"><span>你好，我是</span><strong>{profileConfig.handle}</strong></h1>
        <p class="about-introduction__alias">也使用网名 <b>{profileConfig.alias}</b></p>
        <p class="about-introduction__intro">{profileConfig.introduction}。</p>
        <div class="about-introduction__status" aria-label="当前状态">
          <span><GraduationCap size={17} aria-hidden="true" />{profileConfig.education}</span>
          <span><Microscope size={17} aria-hidden="true" />{profileConfig.nextStage}</span>
        </div>
        <a href="#research">关注的方向 <ArrowDownRight size={18} aria-hidden="true" /></a>
      </div>
      <figure class="about-introduction__portrait">
        <Image src={aboutPortrait} alt="花园茶会中的爱莉希雅" widths={[600,900,1200]} sizes="(max-width:760px) 80vw, 40vw" loading="eager" />
        <figcaption>研究之外，也认真玩耍。</figcaption>
      </figure>
    </section></div>

    <section id="research" class="about-research" data-about-research>
      <div class="page-width">
        <header>
          <div><span>01 / RESEARCH DIRECTIONS</span><h2>关注的方向</h2></div>
          <p>
            我关心模型怎样听懂话语，<br />也怎样理解说话的人。
          </p>
        </header>

        <div class="about-research__list">
          {
            profileConfig.research.map((item) => (
              <article data-direction>
                <span>{item.index}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about-play" id="after-hours" aria-labelledby="play-title" data-about-play>
      <div class="about-play__stage">
      <div class="about-play__image">
        <Image
          src={playPortrait}
          alt="带有戏剧化构图的角色插画"
          widths={[720, 1080, 1440]}
          sizes="(max-width: 820px) 100vw, 52vw"
          loading="lazy"
        />
      </div>
      <div class="about-play__copy">
        <span>02 / AFTER HOURS</span>
        <h2 id="play-title">主线之外，<br />总有兔子洞</h2>
        <p>
          研究之外，也认真玩耍。<br />好奇心把我带到了这些地方。
        </p>
        <ul>
          {profileConfig.curiosities.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <span class="about-play__cue" aria-hidden="true">向下，跟着好奇心走走 ↓</span>
      </div>
    </section>

    <section class="about-contact" data-about-contact id="contact" aria-labelledby="contact-title">
      <div class="page-width">
        <div>
          <span>03 / CONTACT</span>
          <h2 id="contact-title">在其他地方<br>找到我</h2>
          <p class="about-contact__invitation">
            如果有任何想法 <br>
            Feel free to reach out. (｡･ω･｡)ﾉ
          </p>
        </div>
        <div class="about-contact__body">
          <p>
            代码、研究和偶尔的创作，散落在这些地方。
          </p>
          <nav aria-label="个人链接">
            <a href={profileConfig.links.github}>
              <GitFork aria-hidden="true" size={19} stroke-width={1.8} />
              <span>GitHub</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <a href={profileConfig.links.academic} target="_blank" rel="noopener noreferrer">
              <GraduationCap aria-hidden="true" size={19} stroke-width={1.8} />
              <span>Academic</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <a href={profileConfig.links.bilibili} target="_blank" rel="noopener noreferrer">
              <Tv aria-hidden="true" size={19} stroke-width={1.8} />
              <span>Bilibili</span>
              <ArrowUpRight aria-hidden="true" size={17} stroke-width={1.8} />
            </a>
            <button
              type="button"
              data-copy-email
              data-email={profileConfig.links.email}
              aria-label="复制联系邮箱"
              title="复制联系邮箱"
            >
              <Mail aria-hidden="true" size={19} stroke-width={1.8} />
              <span data-email-label>{profileConfig.links.email}</span>
              <Copy aria-hidden="true" size={17} stroke-width={1.8} />
            </button>
          </nav>
          <p class="about-contact__feedback" aria-live="polite" data-copy-feedback>
          </p>
        </div>
      </div>
      <footer class="page-width">
        <span>PROMETHEUS © 2026</span>
        <span>END OF TRANSMISSION</span>
      </footer>
    </section>
  </main>

  <DirectedPointer />

</BaseLayout>

<script>
  import { mountAboutStory } from "../../components/art/about-story";
  mountAboutStory();
  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyFeedback = document.querySelector<HTMLElement>(
    "[data-copy-feedback]",
  );

  copyButton?.addEventListener("click", async () => {
    const obfuscated = copyButton.dataset.email;
    if (!obfuscated) return;

    const address = obfuscated.replace("#", "@");
    try {
      await navigator.clipboard.writeText(address);
      if (copyFeedback) copyFeedback.textContent = "邮箱已复制。";
    } catch {
      if (copyFeedback) {
        copyFeedback.textContent = `复制失败，请手动输入 ${obfuscated}`;
      }
    }
  });
</script>

<style>
  .about-introduction-shell {
    background: var(--paper-gold,var(--color-bg));
    overflow: hidden;
  }

  .about-introduction {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    align-items: center;
    gap: 100px;
    padding-block: 64px 74px;
  }

  .about-introduction__eyebrow {
    margin: 0 0 28px;
    color: var(--color-gold);
    font: .7rem var(--font-mono);
    letter-spacing: .1em;
  }

  .about-introduction h1 {
    margin: 0;
    font: 400 1.8rem/1.3 var(--font-reading);
  }

  .about-introduction h1 > span, .about-introduction h1 > strong {
    display: block;
    font-weight: 400;
  }

  .about-introduction h1 > strong {
    margin-top: 20px;
    font-size: clamp(2.4rem,4vw,3.6rem);
    letter-spacing: -.05em;
    overflow-wrap: anywhere;
  }

  .about-introduction__alias {
    margin: 25px 0;
    font-size: .8rem;
    color: var(--color-muted);
  }

  .about-introduction__alias b {
    color: var(--color-rose);
    font-weight: 500;
  }

  .about-introduction__intro {
    max-width: 500px;
    font-size: 1rem;
    line-height: 1.95;
    color: var(--color-muted);
  }

  .about-introduction__status {
    display: grid;
    gap: 12px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb,var(--color-gold) 28%,transparent);
    color: var(--color-muted);
    font: .76rem var(--font-mono);
  }

  .about-introduction__status > span {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .about-introduction__status svg {
    color: var(--color-gold);
  }

  .about-introduction__copy > a {
    display: inline-flex;
    align-items: center;
    gap: 30px;
    margin-top: 26px;
    min-height: 46px;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    font-size: .8rem;
  }

  .about-introduction__portrait {
    margin: 0;
    padding: 15px 15px 0;
    border: 1px solid color-mix(in srgb,var(--color-gold) 22%,transparent);
    background: color-mix(in srgb,var(--paper-white,var(--color-surface)) 60%,transparent);
    transform: rotate(2deg);
  }

  .about-introduction__portrait :global(img) {
    width: 100%;
    height: 490px;
    object-fit: cover;
    object-position: center 30%;
    border-radius: 180px 180px 2px 2px;
  }

  .about-introduction__portrait figcaption {
    margin: 18px 0;
    color: var(--color-muted);
    text-align: center;
    font: .8rem var(--font-reading);
  }

  [data-about-intro][data-scene-ready] .about-introduction__copy {
    transform: translateY(var(--intro-copy-y,0px));
    opacity: var(--intro-opacity,1);
  }

  [data-about-intro][data-scene-ready] .about-introduction__portrait {
    transform: translateX(var(--intro-image-x,0px)) rotate(var(--intro-image-angle,2deg)) scale(var(--intro-image-scale,1));
  }

  .about-research {
    position: relative;
    background: var(--paper-cyan,var(--color-bg));
    padding-block: 90px;
  }

  .about-research > .page-width {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    align-items: start;
    gap: 100px;
  }

  .about-research header {
    position: sticky;
    top: 110px;
    padding-top: 35px;
  }

  .about-research header span {
    color: var(--color-cyan);
    font: .7rem var(--font-mono);
    letter-spacing: .1em;
  }

  .about-research h2 {
    margin: 28px 0;
    font: 400 var(--type-section-title,3rem)/1.3 var(--font-reading);
  }

  .about-research header > p {
    max-width: 28ch;
    color: var(--color-muted);
    font: 1.2rem/1.9 var(--font-reading);
  }

  .about-research__list {
    border-top: 1px solid color-mix(in srgb,var(--color-cyan) 35%,transparent);
  }

  .about-research__list article {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 20px;
    padding: 48px 0;
    border-bottom: 1px solid color-mix(in srgb,var(--color-cyan) 25%,transparent);
  }

  .about-research__list article > span {
    grid-row: 1/3;
    padding-top: 5px;
    color: var(--color-cyan);
    font: italic 1.2rem var(--font-reading);
  }

  .about-research__list h3 {
    margin: 0;
    font: 400 1.9rem/1.4 var(--font-reading);
  }

  .about-research__list p {
    grid-column: 2;
    margin: 0;
    color: var(--color-muted);
    font-size: .95rem;
    line-height: 1.95;
  }

  [data-about-research][data-scene-ready] article {
    opacity: var(--direction-opacity,1);
    transform: translateX(var(--direction-x,0px));
  }

  .about-play {
    position: relative;
    background: #211d2d;
    color: #f5edf5;
  }

  .about-play__stage {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    min-height: 720px;
  }

  .about-play__image {
    overflow: hidden;
  }

  .about-play__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 20% center;
  }

  .about-play__copy {
    align-self: center;
    padding: 70px 80px;
  }

  .about-play__copy > span {
    display: block;
    margin-bottom: 24px;
    color: #dba9c7;
    font: .7rem var(--font-mono);
    letter-spacing: .1em;
  }

  .about-play h2 {
    margin: 0 0 28px;
    font: 400 var(--type-section-title,3rem)/1.3 var(--font-reading);
  }

  .about-play__copy > p {
    margin: 0;
    color: #c6b9cd;
    font-size: .95rem;
    line-height: 1.95;
  }

  .about-play ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  .about-play li {
    padding: 12px 14px;
    border: 1px solid #b499bc47;
    background: #e1c6e60a;
    color: #e0d1e8;
    font: .8125rem/1.6 var(--font-mono);
  }

  .about-play__cue {
    display: none;
  }

  .about-play[data-scene-ready] {
    height: 165svh;
  }

  [data-scene-ready] .about-play__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 650px;
    overflow: hidden;
    isolation: isolate;
  }

  [data-scene-ready] .about-play__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    clip-path: inset(0 var(--play-clip,0%) 0 0);
  }

  [data-scene-ready] .about-play__image :global(img) {
    width: 100%;
    height: 100%;
    object-position: 20% center;
    transform: translateX(var(--play-image-x,0px)) scale(var(--play-image-scale,1));
  }

  [data-scene-ready] .about-play__stage::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background: linear-gradient(90deg,transparent 20%,#211d2dcc 63%,#211d2df5);
    opacity: var(--play-shade,1);
  }

  [data-scene-ready] .about-play__copy {
    position: absolute;
    left: 55%;
    top: 20%;
    width: 39%;
    padding: 0;
    transform: translateY(var(--play-copy-y,130px));
  }

  [data-scene-ready].about-play h2 {
    transform: scale(var(--play-title-scale,1));
    transform-origin: left center;
  }

  [data-scene-ready] .about-play__copy > p, [data-scene-ready].about-play ul {
    opacity: var(--play-details,0);
    transform: translateX(var(--play-details-x,60px));
  }

  [data-scene-ready] .about-play__cue {
    display: block;
    position: absolute;
    bottom: 35px;
    right: 6%;
    color: #d3c3d7;
    font-size: .7rem;
  }

  .about-contact {
    background: var(--paper-gold,var(--art-paper));
    padding: 90px 0 30px;
  }

  .about-contact > .page-width {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 90px;
    align-items: start;
  }

  .about-contact > div > div > span {
    color: var(--color-gold);
    font: .7rem var(--font-mono);
  }

  .about-contact h2 {
    margin: 28px 0 35px;
    font: 400 var(--type-section-title,3rem)/1.3 var(--font-reading);
  }

  .about-contact__invitation {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.9;
  }

  .about-contact__body > p {
    margin: 0 0 30px;
    font-size: 1rem;
    line-height: 1.9;
  }

  .about-contact nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .about-contact nav a, .about-contact nav button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-width: 0;
    min-height: 78px;
    padding: 20px;
    border: 1px solid color-mix(in srgb,var(--color-gold) 20%,transparent);
    background: var(--paper-white,var(--color-surface));
    font-size: .8rem;
    text-decoration: none;
    cursor: pointer;
  }

  .about-contact nav svg:first-child {
    color: var(--color-gold);
  }

  .about-contact nav span {
    flex: 1;
    overflow-wrap: anywhere;
  }

  .about-contact nav a:hover, .about-contact nav button:hover {
    border-color: var(--color-gold);
  }

  .about-contact__feedback {
    min-height: 24px;
    margin: 14px 0 0!important;
    color: var(--color-muted);
    font-size: .8rem!important;
  }

  .about-contact footer {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    padding-top: 64px;
    color: var(--color-muted);
    font: .65rem var(--font-mono);
  }

  [data-about-contact][data-scene-ready] .about-contact__body {
    transform: translateY(var(--contact-y,0px));
    opacity: var(--contact-opacity,1);
  }

  @media (max-width:1023px) {
    .about-introduction, .about-research > .page-width, .about-play__stage, .about-contact > .page-width {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about-introduction__portrait {
      max-width: 450px;
    }

    .about-research header {
      position: static;
    }

    .about-play__image {
      height: 500px;
    }

    .about-play__copy {
      padding: 50px var(--page-inline);
    }

  }
</style>
