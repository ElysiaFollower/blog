---
import {
  ArrowUpDown,
  ArrowUpRight,
  Hash,
  ListTree,
  Search,
  X,
} from "@lucide/astro";
import { Image } from "astro:assets";
import ArticleSectionNav from "../../components/content/ArticleSectionNav.astro";
import CatalogTree from "../../components/content/CatalogTree.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import {
  buildCatalogTree,
  getCatalogBreadcrumbs,
  getSourcePath,
  getTagEntries,
  getVisiblePosts,
  postHref,
  tagHref,
} from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getVisiblePosts();
const catalog = buildCatalogTree(posts);
const tags = getTagEntries(posts);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout
  title="知识目录"
  description="通过目录、Tags 与全文检索定位文章。"
  bodyClass="library-page"
>
  <SiteHeader variant="reading" />
  <main id="main-content">
    <ArticleSectionNav current="catalog" />
    <header class="library-masthead">
      <div class="page-width">
        <div class="library-masthead__title">
          <p>KNOWLEDGE CATALOG · {String(posts.length)}</p>
          <h1>知识目录</h1>
        </div>
        <p class="library-masthead__description">
          在这里检索全站馆藏吧～<br>
          寻访那些闪闪发光的文字吧～ (*'▽'*)
        </p>
      </div>
    </header>

    <section
      class="library-shell page-width"
      aria-label="文章目录与搜索"
      data-library-root
      data-index-ready={import.meta.env.PROD ? "true" : "false"}
    >
      <div class="library-search" data-library-search>
        <Search aria-hidden="true" size={23} stroke-width={1.7} />
        <label>
          <span class="visually-hidden">搜索标题、摘要、标签与正文关键词</span>
          <input
            type="search"
            placeholder="搜索标题、摘要、标签与正文关键词…"
            autocomplete="off"
            data-library-search-input
          />
        </label>
        <button
          type="button"
          aria-label="清空搜索"
          title="清空搜索"
          data-library-search-clear
          hidden
        >
          <X aria-hidden="true" size={19} stroke-width={1.8} />
        </button>
      </div>

      <div class="library-workspace">
        <aside class="library-index" aria-label="文章索引">
          <header>
            <span>INDEX</span>
            <small>{String(posts.length).padStart(2, "0")} FILES</small>
          </header>

          <div class="library-index__modes" aria-label="索引方式">
            <button
              type="button"
              data-index-mode="catalog"
              aria-pressed="true"
            >
              <ListTree aria-hidden="true" size={16} stroke-width={1.7} />
              <span>目录</span>
            </button>
            <button
              type="button"
              data-index-mode="tags"
              aria-pressed="false"
            >
              <Hash aria-hidden="true" size={16} stroke-width={1.7} />
              <span>Tags</span>
            </button>
          </div>

          <div class="library-index__panel" data-index-panel="catalog">
            <button
              class="library-index__all"
              type="button"
              data-catalog-path=""
              data-catalog-label="全部文章"
              data-selected="true"
            >
              <span>全部文章</span>
              <small>{String(posts.length).padStart(2, "0")}</small>
            </button>
            <CatalogTree nodes={catalog} />
          </div>

          <div
            class="library-index__panel library-tag-index"
            data-index-panel="tags"
            hidden
          >
            <a href="/posts/catalog/" data-tag="">
              <span>全部 Tags</span>
              <small>{String(tags.length).padStart(2, "0")}</small>
            </a>
            {
              tags.map((tag) => (
                <a href={tagHref(tag.name)} data-tag={tag.name}>
                  <span>{tag.name}</span>
                  <small>{String(tag.count).padStart(2, "0")}</small>
                </a>
              ))
            }
          </div>
        </aside>

        <section class="library-results" aria-labelledby="library-result-title">
          <header class="library-results__header">
            <div>
              <p data-library-scope>全部文章</p>
              <h2 id="library-result-title" data-library-title>全部文章</h2>
              <code data-library-path>src/content/posts/</code>
            </div>
            <label class="library-sort">
              <ArrowUpDown aria-hidden="true" size={16} stroke-width={1.7} />
              <span class="visually-hidden">排列文章</span>
              <select data-library-sort>
                <option value="relevance" disabled>相关度</option>
                <option value="date-desc" selected>最新发布</option>
                <option value="date-asc">最早发布</option>
                <option value="title-asc">标题 A–Z</option>
                <option value="title-desc">标题 Z–A</option>
              </select>
            </label>
          </header>

          <div class="library-status">
            <p aria-live="polite" data-library-status>
              当前目录共 <strong>{posts.length}</strong> 篇文章
            </p>
            <button
              type="button"
              data-library-clear-scope
              hidden
            >
              清除范围
            </button>
          </div>

          <ol class="catalog-results" data-catalog-results>
            {
              posts.map((post, index) => {
                const breadcrumbs = getCatalogBreadcrumbs(post, false);
                const breadcrumbLabel = breadcrumbs
                  .map((entry) => entry.label)
                  .join(" / ");

                return (
                  <li
                    data-post-row
                    data-path={post.id}
                    data-tags={JSON.stringify(post.data.tags)}
                    data-title={post.data.title}
                    data-date={post.data.pubDate.valueOf()}
                  >
                    <span class="catalog-result__index" data-result-index>
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <a
                      class="catalog-result__cover"
                      href={postHref(post)}
                      tabindex="-1"
                      aria-hidden="true"
                    >
                      <Image
                        src={post.data.cover}
                        alt=""
                        widths={[180, 280]}
                        sizes="(max-width: 700px) 96px, 140px"
                        loading="lazy"
                        style={`object-position: ${post.data.coverPosition}`}
                      />
                    </a>
                    <article>
                      <p class="catalog-result__path">{breadcrumbLabel}</p>
                      <h3>
                        {post.data.draft && <span>Draft</span>}
                        <a href={postHref(post)}>{post.data.title}</a>
                      </h3>
                      <p class="catalog-result__description">
                        {post.data.description}
                      </p>
                      <ul aria-label="标签">
                        {post.data.tags.map((tag) => (
                          <li>
                            <a href={tagHref(tag)}>#{tag}</a>
                          </li>
                        ))}
                      </ul>
                      <code title={getSourcePath(post)}>
                        {getSourcePath(post)}
                      </code>
                    </article>
                    <div class="catalog-result__tail">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {dateFormatter.format(post.data.pubDate)}
                      </time>
                      <a
                        href={postHref(post)}
                        aria-label={`阅读《${post.data.title}》`}
                        title="阅读文章"
                      >
                        <ArrowUpRight
                          aria-hidden="true"
                          size={18}
                          stroke-width={1.8}
                        />
                      </a>
                    </div>
                  </li>
                );
              })
            }
          </ol>

          <ol
            class="catalog-results search-results"
            data-search-results
            hidden
          ></ol>

          <p class="library-empty" data-library-empty hidden>
            当前范围内没有匹配的文章。
          </p>
          <button
            class="library-more"
            type="button"
            data-library-more
            hidden
          >
            显示更多
          </button>
        </section>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  interface SearchResultData {
    url: string;
    excerpt: string;
    meta: Record<string, string>;
    sub_results?: Array<{
      title: string;
      url: string;
      excerpt: string;
    }>;
  }

  interface SearchResultReference {
    data(): Promise<SearchResultData>;
  }

  interface PagefindApi {
    search(
      query: string,
      options?: {
        filters?: Record<string, string>;
        sort?: Record<string, "asc" | "desc">;
      },
    ): Promise<{ results: SearchResultReference[] }>;
  }

  type SortMode =
    | "relevance"
    | "date-desc"
    | "date-asc"
    | "title-asc"
    | "title-desc";

  const root = document.querySelector<HTMLElement>("[data-library-root]");
  const input = root?.querySelector<HTMLInputElement>(
    "[data-library-search-input]",
  );
  const clearSearch = root?.querySelector<HTMLButtonElement>(
    "[data-library-search-clear]",
  );
  const sortSelect = root?.querySelector<HTMLSelectElement>(
    "[data-library-sort]",
  );
  const scope = root?.querySelector<HTMLElement>("[data-library-scope]");
  const title = root?.querySelector<HTMLElement>("[data-library-title]");
  const pathLabel = root?.querySelector<HTMLElement>("[data-library-path]");
  const status = root?.querySelector<HTMLElement>("[data-library-status]");
  const clearScope = root?.querySelector<HTMLButtonElement>(
    "[data-library-clear-scope]",
  );
  const catalogResults = root?.querySelector<HTMLOListElement>(
    "[data-catalog-results]",
  );
  const searchResults = root?.querySelector<HTMLOListElement>(
    "[data-search-results]",
  );
  const empty = root?.querySelector<HTMLElement>("[data-library-empty]");
  const more = root?.querySelector<HTMLButtonElement>("[data-library-more]");
  const rows = Array.from(
    root?.querySelectorAll<HTMLElement>("[data-post-row]") ?? [],
  );
  const modeButtons = Array.from(
    root?.querySelectorAll<HTMLButtonElement>("[data-index-mode]") ?? [],
  );
  const panels = Array.from(
    root?.querySelectorAll<HTMLElement>("[data-index-panel]") ?? [],
  );
  const directoryControls = Array.from(
    root?.querySelectorAll<HTMLElement>("[data-catalog-path]") ?? [],
  );
  const tagControls = Array.from(
    root?.querySelectorAll<HTMLAnchorElement>("[data-tag]") ?? [],
  );

  const collator = new Intl.Collator("zh-CN", {
    numeric: true,
    sensitivity: "base",
  });
  const pageSize = 24;
  let selectedPath = "";
  let selectedPathLabel = "全部文章";
  let selectedTag = "";
  let searchSequence = 0;
  let debounceTimer: number | undefined;
  let pagefindPromise: Promise<PagefindApi> | undefined;
  let searchReferences: SearchResultReference[] = [];
  let renderedSearchResults = 0;
  let renderedBrowseResults = pageSize;
  let queryWasEmpty = true;

  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (character) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;",
        })[character] ?? character,
    );

  const formatSearchDate = (value: string) => {
    const date = new Date(value);
    if (Number.isNaN(date.valueOf())) return value;

    return new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(date);
  };

  const loadPagefind = () => {
    if (!pagefindPromise) {
      const modulePath = "/pagefind/pagefind.js";
      pagefindPromise = import(
        /* @vite-ignore */ modulePath
      ) as Promise<PagefindApi>;
    }
    return pagefindPromise;
  };

  const getSortMode = () =>
    (sortSelect?.value ?? "date-desc") as SortMode;

  const getPagefindSort = (): Record<string, "asc" | "desc"> | undefined => {
    const sort = getSortMode();
    if (sort === "date-desc") return { date: "desc" as const };
    if (sort === "date-asc") return { date: "asc" as const };
    if (sort === "title-asc") return { title: "asc" as const };
    if (sort === "title-desc") return { title: "desc" as const };
    return undefined;
  };

  const syncUrl = () => {
    const url = new URL(window.location.href);
    const query = input?.value.trim() ?? "";
    const sort = getSortMode();

    url.search = "";
    if (query) url.searchParams.set("q", query);
    if (selectedPath) url.searchParams.set("path", selectedPath);
    if (selectedTag) url.searchParams.set("tag", selectedTag);
    if (
      (query && sort !== "relevance") ||
      (!query && sort !== "date-desc")
    ) {
      url.searchParams.set("sort", sort);
    }

    window.history.replaceState({}, "", url);
  };

  const updateSelection = () => {
    directoryControls.forEach((control) =>
      control.setAttribute(
        "data-selected",
        String(
          !selectedTag &&
            (control.dataset.catalogPath ?? "") === selectedPath,
        ),
      ),
    );
    tagControls.forEach((control) =>
      control.setAttribute(
        "data-selected",
        String((control.dataset.tag ?? "") === selectedTag),
      ),
    );

    if (scope) {
      scope.textContent = selectedTag
        ? `TAG // ${selectedTag}`
        : selectedPath
          ? "CATALOG SCOPE"
          : "ALL ARTICLES";
    }
    if (title) {
      title.textContent = selectedTag
        ? `#${selectedTag}`
        : selectedPathLabel;
    }
    if (pathLabel) {
      pathLabel.textContent = selectedTag
        ? "跨目录关联"
        : `src/content/posts/${selectedPath ? `${selectedPath}/` : ""}`;
    }
    if (clearScope) clearScope.hidden = !selectedPath && !selectedTag;
  };

  const matchesScope = (row: HTMLElement) => {
    const path = row.dataset.path ?? "";
    const tags = JSON.parse(row.dataset.tags ?? "[]") as string[];
    const pathMatches =
      !selectedPath ||
      path === selectedPath ||
      path.startsWith(`${selectedPath}/`);
    const tagMatches = !selectedTag || tags.includes(selectedTag);
    return pathMatches && tagMatches;
  };

  const compareRows = (a: HTMLElement, b: HTMLElement) => {
    const sort = getSortMode();
    const dateA = Number(a.dataset.date);
    const dateB = Number(b.dataset.date);
    const titleA = a.dataset.title ?? "";
    const titleB = b.dataset.title ?? "";

    if (sort === "date-asc") return dateA - dateB;
    if (sort === "title-asc") return collator.compare(titleA, titleB);
    if (sort === "title-desc") return -collator.compare(titleA, titleB);
    return dateB - dateA;
  };

  const renderBrowse = (reset = true) => {
    if (!catalogResults || !searchResults) return;
    if (reset) renderedBrowseResults = pageSize;
    const visible = rows.filter(matchesScope).sort(compareRows);
    const hidden = rows.filter((row) => !matchesScope(row));

    visible.forEach((row, index) => {
      row.hidden = index >= renderedBrowseResults;
      row.querySelector<HTMLElement>("[data-result-index]")!.textContent =
        String(index + 1).padStart(2, "0");
      catalogResults.append(row);
    });
    hidden.forEach((row) => {
      row.hidden = true;
      catalogResults.append(row);
    });

    catalogResults.hidden = false;
    searchResults.hidden = true;
    if (more) more.hidden = renderedBrowseResults >= visible.length;
    if (empty) empty.hidden = visible.length > 0;
    if (status) {
      status.innerHTML = `当前范围共 <strong>${visible.length}</strong> 篇文章`;
    }
  };

  const createSearchResult = (entry: SearchResultData, index: number) => {
    const item = document.createElement("li");
    const section = entry.sub_results?.find((candidate) =>
      candidate.url.includes("#"),
    );
    const excerpt = entry.excerpt.includes("<mark>")
      ? entry.excerpt
      : escapeHtml(entry.meta.description || entry.excerpt);
    const sectionLink = section
      ? `<a class="search-result__section" href="${escapeHtml(section.url)}">
          命中小节 · ${escapeHtml(section.title)}
        </a>`
      : "";
    const cover = entry.meta.cover
      ? `<a class="catalog-result__cover" href="${escapeHtml(entry.url)}" tabindex="-1" aria-hidden="true">
          <img
            src="${escapeHtml(entry.meta.cover)}"
            alt=""
            loading="lazy"
            style="object-position: ${escapeHtml(entry.meta["cover-position"] || "50% 50%")}"
          />
        </a>`
      : "";

    item.innerHTML = `
      <span class="catalog-result__index">${String(index + 1).padStart(2, "0")}</span>
      ${cover}
      <article>
        <p class="catalog-result__path">${escapeHtml(entry.meta.catalog || "")}</p>
        <h3><a href="${escapeHtml(entry.url)}">${escapeHtml(entry.meta.title || "未命名文章")}</a></h3>
        <p class="catalog-result__description">${excerpt}</p>
        ${sectionLink}
        <code>${escapeHtml(entry.meta.source || "")}</code>
      </article>
      <div class="catalog-result__tail">
        <time datetime="${escapeHtml(entry.meta.date || "")}">
          ${escapeHtml(formatSearchDate(entry.meta.date || ""))}
        </time>
        <a href="${escapeHtml(entry.url)}" aria-label="阅读文章">
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    `;
    return item;
  };

  const renderMoreSearchResults = async () => {
    if (!searchResults) return;
    const sequence = searchSequence;
    const nextReferences = searchReferences.slice(
      renderedSearchResults,
      renderedSearchResults + pageSize,
    );
    const entries = await Promise.all(
      nextReferences.map((reference) => reference.data()),
    );
    if (sequence !== searchSequence) return;

    entries.forEach((entry, index) => {
      searchResults.append(
        createSearchResult(entry, renderedSearchResults + index),
      );
    });
    renderedSearchResults += entries.length;
    if (more) {
      more.hidden = renderedSearchResults >= searchReferences.length;
    }
  };

  const runSearch = async () => {
    if (!root || !input || !catalogResults || !searchResults) return;
    const query = input.value.trim();
    clearSearch?.toggleAttribute("hidden", !query);

    if (!query) {
      queryWasEmpty = true;
      const relevance = sortSelect?.querySelector<HTMLOptionElement>(
        'option[value="relevance"]',
      );
      if (relevance) relevance.disabled = true;
      if (sortSelect?.value === "relevance") sortSelect.value = "date-desc";
      syncUrl();
      renderBrowse();
      return;
    }

    const relevance = sortSelect?.querySelector<HTMLOptionElement>(
      'option[value="relevance"]',
    );
    if (relevance) relevance.disabled = false;
    if (queryWasEmpty && sortSelect && !new URLSearchParams(location.search).has("sort")) {
      sortSelect.value = "relevance";
    }
    queryWasEmpty = false;
    syncUrl();

    if (root.dataset.indexReady !== "true") {
      catalogResults.hidden = true;
      searchResults.hidden = false;
      searchResults.replaceChildren();
      if (status) {
        status.textContent =
          "全文索引在生产构建时生成，请使用 pnpm build 后的预览服务。";
      }
      return;
    }

    const sequence = ++searchSequence;
    if (status) status.textContent = "正在查找…";
    if (empty) empty.hidden = true;

    try {
      const pagefind = await loadPagefind();
      const filters: Record<string, string> = {};
      if (selectedPath) filters.directory = selectedPath;
      if (selectedTag) filters.tag = selectedTag;
      const response = await pagefind.search(query, {
        filters: Object.keys(filters).length > 0 ? filters : undefined,
        sort: getPagefindSort(),
      });
      if (sequence !== searchSequence) return;

      searchReferences = response.results;
      renderedSearchResults = 0;
      searchResults.replaceChildren();
      catalogResults.hidden = true;
      searchResults.hidden = false;
      if (status) {
        status.innerHTML = `找到 <strong>${searchReferences.length}</strong> 篇相关文章`;
      }
      if (empty) empty.hidden = searchReferences.length > 0;
      await renderMoreSearchResults();
    } catch (error) {
      console.error(error);
      searchResults.replaceChildren();
      if (status) status.textContent = "搜索索引加载失败，请刷新页面后重试。";
    }
  };

  const applyState = () => {
    updateSelection();
    syncUrl();
    if (input?.value.trim()) runSearch();
    else renderBrowse();
  };

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const mode = button.dataset.indexMode;
      modeButtons.forEach((candidate) =>
        candidate.setAttribute(
          "aria-pressed",
          String(candidate === button),
        ),
      );
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.indexPanel !== mode;
      });
    });
  });

  directoryControls.forEach((control) => {
    control.addEventListener("click", () => {
      selectedPath = control.dataset.catalogPath ?? "";
      selectedPathLabel = control.dataset.catalogLabel ?? "全部文章";
      selectedTag = "";
      applyState();
    });
  });

  tagControls.forEach((control) => {
    control.addEventListener("click", (event) => {
      event.preventDefault();
      selectedTag = control.dataset.tag ?? "";
      selectedPath = "";
      selectedPathLabel = "全部文章";
      applyState();
    });
  });

  clearScope?.addEventListener("click", () => {
    selectedPath = "";
    selectedPathLabel = "全部文章";
    selectedTag = "";
    applyState();
  });

  input?.addEventListener("input", () => {
    window.clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(runSearch, 120);
  });
  input?.addEventListener("focus", () => {
    if (root?.dataset.indexReady === "true") loadPagefind();
  });
  clearSearch?.addEventListener("click", () => {
    if (!input) return;
    input.value = "";
    runSearch();
    input.focus();
  });
  sortSelect?.addEventListener("change", () => {
    if (input?.value.trim()) runSearch();
    else {
      syncUrl();
      renderBrowse();
    }
  });
  more?.addEventListener("click", () => {
    if (input?.value.trim()) {
      renderMoreSearchResults();
    } else {
      renderedBrowseResults += pageSize;
      renderBrowse(false);
    }
  });

  const initialParams = new URLSearchParams(window.location.search);
  const initialQuery = initialParams.get("q") ?? "";
  const initialPath = initialParams.get("path") ?? "";
  const initialTag = initialParams.get("tag") ?? "";
  const initialSort = initialParams.get("sort");
  const initialDirectory = directoryControls.find(
    (control) => control.dataset.catalogPath === initialPath,
  );

  selectedPath = initialDirectory ? initialPath : "";
  selectedPathLabel =
    initialDirectory?.dataset.catalogLabel ?? "全部文章";
  selectedTag = initialTag;
  if (input) input.value = initialQuery;
  if (sortSelect) {
    sortSelect.value =
      initialSort ??
      (initialQuery ? "relevance" : "date-desc");
  }
  queryWasEmpty = !initialQuery;
  if (initialTag) {
    const tagsMode = modeButtons.find(
      (button) => button.dataset.indexMode === "tags",
    );
    tagsMode?.click();
  }
  updateSelection();
  if (initialQuery) runSearch();
  else renderBrowse();
</script>

<style is:global>
  .library-page {
    background: var(--color-bg);
  }

  .library-masthead {
    border-bottom: 1px solid var(--color-line);
  }

  .library-masthead > .page-width {
    display: grid;
    min-height: 230px;
    padding-block: 54px 42px;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
    align-items: end;
    gap: 60px;
  }

  .library-masthead__title > p {
    margin: 0 0 16px;
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .library-masthead h1 {
    margin: 0;
    font-family: var(--font-reading);
    font-size: clamp(3.3rem, 7vw, 6rem);
    line-height: 0.95;
  }

  .library-masthead__description {
