---
import ContentDirectory from "../../components/content/ContentDirectory.astro";
import ContentPageHeader from "../../components/content/ContentPageHeader.astro";
import TaxonomyIndex from "../../components/content/TaxonomyIndex.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getPublishedPosts, getTaxonomy } from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getPublishedPosts();
const categories = getTaxonomy(posts, "categories");
const tags = getTaxonomy(posts, "tags");
---

<BaseLayout
  title="分类"
  description="沿着文章的主题主线浏览内容。"
  bodyClass="taxonomy-index-page"
>
  <SiteHeader variant="reading" />
  <main id="main-content">
    <ContentPageHeader
      kicker={`CATEGORIES // ${String(categories.length).padStart(2, "0")}`}
      title="分类"
      description="比标签更宽的主题主线，适合从一个方向开始连续阅读。"
      note={`${posts.length} ARTICLES INDEXED`}
    />
    <ContentDirectory
      current="categories"
      postCount={posts.length}
      categoryCount={categories.length}
      tagCount={tags.length}
    />
    <section class="taxonomy-index-page__list page-width" aria-label="分类列表">
      <TaxonomyIndex entries={categories} kind="categories" />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .taxonomy-index-page__list {
    padding-block: 68px 112px;
  }

  @media (max-width: 620px) {
    .taxonomy-index-page__list {
      padding-block: 46px 84px;
    }
  }
</style>
