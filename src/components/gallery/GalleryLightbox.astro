---
import "photoswipe/style.css";
---

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const lightbox = new PhotoSwipeLightbox({
    gallery: "[data-gallery-grid]",
    children: "[data-gallery-item]",
    pswpModule: () => import("photoswipe"),
    mainClass: "gallery-viewer",
    bgOpacity: 1,
    initialZoomLevel: "fit",
    secondaryZoomLevel: 1,
    maxZoomLevel: (zoomLevel) => Math.max(2, zoomLevel.fit * 5),
    wheelToZoom: true,
    allowPanToNext: false,
    pinchToClose: false,
    closeOnVerticalDrag: false,
    imageClickAction: "zoom",
    tapAction: "toggle-controls",
    doubleTapAction: "zoom",
    bgClickAction: "close",
    showAnimationDuration: reduceMotion ? false : 260,
    hideAnimationDuration: reduceMotion ? false : 220,
    zoomAnimationDuration: reduceMotion ? false : 240,
    easing: "cubic-bezier(0.22, 1, 0.36, 1)",
    preload: [1, 2],
    counter: false,
    errorMsg: "图片加载失败",
    closeTitle: "关闭",
    zoomTitle: "切换缩放",
    arrowPrevTitle: "上一张",
    arrowNextTitle: "下一张",
    paddingFn: (viewportSize) => {
      if (viewportSize.x <= 620) {
        return { top: 58, bottom: 70, left: 10, right: 10 };
      }
      return { top: 68, bottom: 72, left: 76, right: 76 };
    },
  });

  lightbox.on("uiRegister", () => {
    const viewer = lightbox.pswp;
    if (!viewer?.ui) return;

    viewer.ui.registerElement({
      name: "gallery-caption",
      appendTo: "root",
      onInit: (element, pswp) => {
        const title = document.createElement("span");
        const position = document.createElement("small");
        element.append(title, position);

        const render = () => {
          const item = pswp.currSlide?.data;
          const source = item?.element as HTMLElement | undefined;
          title.textContent = source?.dataset.caption ?? "";
          position.textContent = `${String(pswp.currIndex + 1).padStart(2, "0")} / ${String(pswp.getNumItems()).padStart(2, "0")}`;
        };

        pswp.on("change", render);
        render();
      },
    });

  });

  lightbox.init();
</script>

<style is:global>
  .gallery-viewer {
    --pswp-bg: #0c0a0d;
    --pswp-icon-color: #f7f2f5;
    --pswp-icon-color-secondary: #0c0a0d;
    --pswp-placeholder-bg: #171419;
    --pswp-root-z-index: 1000;
    font-family: var(--font-sans);
  }

  .gallery-viewer .pswp__icn-shadow {
    display: none;
  }

  .gallery-viewer .pswp__top-bar {
    height: 62px;
    padding: 8px 12px;
  }

  .gallery-viewer .pswp__top-bar > * {
    opacity: 0.84;
    transition:
      color 160ms ease,
      opacity 160ms ease,
      transform 160ms ease;
  }

  .gallery-viewer .pswp__top-bar > *:hover,
  .gallery-viewer .pswp__top-bar > *:focus-visible {
    color: #ff8fb4;
    opacity: 1;
  }

  .gallery-viewer .pswp__button {
    width: 46px;
    height: 46px;
  }

  .gallery-viewer .pswp__button--zoom {
    margin-left: auto;
  }

  .gallery-viewer .pswp__button--arrow {
    width: 48px;
    height: 48px;
    margin-top: -24px;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 50%;
    background: rgb(18 15 19 / 82%);
    opacity: 0.72;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      opacity 160ms ease,
      transform 160ms ease;
  }

  .gallery-viewer .pswp__button--arrow:hover,
  .gallery-viewer .pswp__button--arrow:focus-visible {
    border-color: #ff8fb4;
    color: #ff8fb4;
    opacity: 1;
  }

  .gallery-viewer .pswp__button--arrow--prev {
    left: 18px;
  }

  .gallery-viewer .pswp__button--arrow--next {
    right: 18px;
  }

  .gallery-viewer .pswp__button--arrow .pswp__icn {
    top: 8px;
    width: 30px;
    height: 30px;
    margin-top: 0;
  }

  .gallery-viewer .pswp__button--arrow--prev .pswp__icn {
    left: 8px;
  }

  .gallery-viewer .pswp__button--arrow--next .pswp__icn {
    right: 8px;
  }

  .gallery-viewer .pswp__gallery-caption {
    position: absolute;
    right: clamp(22px, 5vw, 78px);
    bottom: 22px;
    left: clamp(22px, 5vw, 78px);
    z-index: 10;
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: #ddd5da;
    font-size: 0.78rem;
    line-height: 1.4;
    pointer-events: none;
  }

  .gallery-viewer .pswp__gallery-caption span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gallery-viewer .pswp__gallery-caption small {
    flex: none;
    color: #a49aa0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  @media (max-width: 620px) {
    .gallery-viewer .pswp__top-bar {
      height: 54px;
      padding: 4px 5px;
    }

    .gallery-viewer .pswp__button--arrow {
      top: auto;
      bottom: 11px;
      width: 42px;
      height: 42px;
      margin: 0;
    }

    .gallery-viewer .pswp__button--arrow--prev {
      left: 10px;
    }

    .gallery-viewer .pswp__button--arrow--next {
      right: 10px;
    }

    .gallery-viewer .pswp__button--arrow .pswp__icn {
      top: 5px;
      width: 30px;
      height: 30px;
    }

    .gallery-viewer .pswp__button--arrow--prev .pswp__icn {
      left: 5px;
    }

    .gallery-viewer .pswp__button--arrow--next .pswp__icn {
      right: 5px;
    }

    .gallery-viewer .pswp__gallery-caption {
      right: 62px;
      bottom: 15px;
      left: 62px;
      display: grid;
      justify-items: center;
      gap: 1px;
      font-size: 0.7rem;
      text-align: center;
    }

    .gallery-viewer .pswp__gallery-caption span {
      max-width: 100%;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-viewer *,
    .gallery-viewer *::before,
    .gallery-viewer *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
