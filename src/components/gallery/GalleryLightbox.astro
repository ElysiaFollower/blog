---
import "photoswipe/style.css";
---

<style is:global>
  .gallery-viewer {
    --pswp-bg: #0c0a0d;
    --pswp-icon-color: #f7f2f5;
    --pswp-icon-color-secondary: #0c0a0d;
    --pswp-placeholder-bg: #171419;
    --pswp-root-z-index: 1000;
    font-family: var(--font-sans);
    touch-action: pan-y;
  }

  .gallery-viewer .pswp__scroll-wrap {
    touch-action: none;
  }

  .gallery-viewer .pswp__icn-shadow {
    display: none;
  }

  .gallery-viewer .pswp__top-bar {
    height: 64px;
    align-items: center;
    padding: 8px max(12px, env(safe-area-inset-right)) 8px
      max(12px, env(safe-area-inset-left));
  }

  .gallery-viewer .pswp__button {
    width: 46px;
    height: 46px;
  }

  .gallery-viewer .pswp__button--zoom {
    margin-left: 6px;
  }

  .gallery-viewer .pswp__preloader {
    width: 32px;
    flex: none;
  }

  .gallery-viewer .pswp__preloader .pswp__icn {
    left: 0;
  }

  .gallery-viewer .gallery-viewer__position {
    margin: 0 16px;
    color: #bdb2ba;
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.08em;
  }

  .gallery-viewer .gallery-viewer__original {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding-inline: 14px;
    color: #d4c8d1;
    font-size: 0.76rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .gallery-viewer .gallery-viewer__copy {
    display: inline-flex;
    width: auto;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin-left: auto;
    padding-inline: 12px;
    color: #d4c8d1;
    font-size: 0.76rem;
    white-space: nowrap;
  }

  .gallery-viewer__copy-icon {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .gallery-viewer .pswp__gallery-feedback {
    position: absolute;
    top: 76px;
    left: 50%;
    z-index: 20;
    max-width: calc(100% - 40px);
    padding: 9px 16px;
    transform: translateX(-50%);
    border: 1px solid rgb(255 177 203 / 25%);
    border-radius: 6px;
    background: #211a20;
    color: #f4e6ed;
    font-size: 0.76rem;
    text-align: center;
  }

  .gallery-viewer .pswp__gallery-feedback:empty {
    display: none;
  }

  .gallery-viewer :is(button, a, summary):focus-visible {
    outline: 2px solid #ffb1cb;
    outline-offset: 3px;
  }

  .gallery-viewer :is(.pswp__button, .gallery-viewer__original):hover {
    color: #ffb1cb;
  }

  .gallery-viewer .pswp__button--arrow {
    width: 48px;
    height: 48px;
    margin-top: -24px;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 50%;
    background: rgb(18 15 19 / 80%);
    opacity: 0.8;
  }

  .gallery-viewer .pswp__button--arrow:hover {
    border-color: #ffb1cb;
  }

  .gallery-viewer .pswp__button--arrow--prev {
    left: 18px;
  }

  .gallery-viewer .pswp__button--arrow--next {
    right: 18px;
  }

  .gallery-viewer .pswp__button--arrow .pswp__icn {
    top: 8px;
    width: 30px;
    height: 30px;
    margin-top: 0;
  }

  .gallery-viewer .pswp__button--arrow--prev .pswp__icn {
    left: 8px;
  }

  .gallery-viewer .pswp__button--arrow--next .pswp__icn {
    right: 8px;
  }

  .gallery-viewer .pswp__gallery-caption {
    position: absolute;
    right: max(80px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    left: max(80px, env(safe-area-inset-left));
    z-index: 10;
    width: min(640px, calc(100% - 160px));
    margin-inline: auto;
    color: #e0d7dd;
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .gallery-viewer__details {
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 10px;
    background: rgb(12 10 13 / 88%);
  }

  .gallery-viewer__details[open] {
    border-color: rgb(255 255 255 / 16%);
    box-shadow: 0 12px 50px rgb(0 0 0 / 20%);
  }

  .gallery-viewer__details summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 20px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
  }

  .gallery-viewer__details summary::-webkit-details-marker {
    display: none;
  }

  .gallery-viewer__caption-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gallery-viewer__caption-toggle {
    flex: none;
    margin-left: auto;
    color: #b5a8b1;
    font-size: 0.69rem;
    white-space: nowrap;
  }

  .gallery-viewer__caption-toggle::after {
    content: " +";
    color: #ffb1cb;
  }

  .gallery-viewer__details[open] .gallery-viewer__caption-toggle::after {
    content: " −";
  }

  .gallery-viewer__caption-body {
    max-height: min(32vh, 260px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px 16px 18px;
    scrollbar-width: thin;
    scrollbar-color: #76626f transparent;
    touch-action: pan-y;
    overflow-wrap: anywhere;
  }

  .gallery-viewer__caption-body h2 {
    margin: 0 0 8px;
    color: #f7f2f5;
    font-family: var(--font-reading);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.65;
  }

  .gallery-viewer__caption-body p {
    margin: 0;
    color: #bdb2ba;
    white-space: pre-wrap;
  }

  .gallery-viewer__caption-body:focus-visible {
    outline: 1px solid #ffb1cb;
    outline-offset: -4px;
  }

  .gallery-viewer .pswp__error-msg {
    max-width: min(80vw, 400px);
    text-align: center;
    line-height: 1.7;
  }

  .gallery-viewer__video video {
    display: block;
    width: 100%;
    height: 100%;
    background: #000;
    object-fit: contain;
  }

  @media (max-width: 620px) {
    .gallery-viewer .pswp__top-bar {
      height: 58px;
      padding-block: 4px;
    }

    .gallery-viewer .gallery-viewer__position {
      margin-inline: 4px;
      font-size: 0.62rem;
    }

    .gallery-viewer .gallery-viewer__original {
      padding-inline: 9px;
      font-size: 0.7rem;
    }

    .gallery-viewer .gallery-viewer__copy {
      width: 42px;
      padding: 0;
    }

    .gallery-viewer__copy-label {
      display: none;
    }

    .gallery-viewer .pswp__button--arrow {
      top: auto;
      bottom: max(14px, env(safe-area-inset-bottom));
      display: block;
      width: 42px;
      height: 42px;
      margin: 0;
    }

    .gallery-viewer.pswp--one-slide .pswp__button--arrow {
      display: none;
    }

    .gallery-viewer .pswp__button--arrow--prev {
      left: max(10px, env(safe-area-inset-left));
    }

    .gallery-viewer .pswp__button--arrow--next {
      right: max(10px, env(safe-area-inset-right));
    }

    .gallery-viewer .pswp__button--arrow .pswp__icn {
      top: 5px;
    }

    .gallery-viewer .pswp__button--arrow--prev .pswp__icn {
      left: 5px;
    }

    .gallery-viewer .pswp__button--arrow--next .pswp__icn {
      right: 5px;
    }

    .gallery-viewer .pswp__gallery-caption {
      right: 60px;
      bottom: max(14px, env(safe-area-inset-bottom));
      left: 60px;
      width: auto;
      font-size: 0.75rem;
    }

    .gallery-viewer__details summary {
      gap: 8px;
      padding-inline: 8px;
    }

    .gallery-viewer__details[open] {
      position: relative;
      width: calc(100vw - 24px);
      margin-left: calc(12px - 60px);
      margin-bottom: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-viewer *,
    .gallery-viewer *::before,
    .gallery-viewer *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
