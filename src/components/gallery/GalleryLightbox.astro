---
import {
  ChevronLeft,
  ChevronRight,
  LoaderCircle,
  RotateCcw,
  X,
  ZoomIn,
  ZoomOut,
} from "@lucide/astro";
---

<dialog
  class="gallery-lightbox"
  data-gallery-lightbox
  aria-label="图片查看器"
>
  <div class="gallery-lightbox__toolbar panzoom-exclude" role="toolbar" aria-label="缩放控制">
    <button
      type="button"
      data-gallery-zoom-out
      aria-label="缩小"
      title="缩小"
    >
      <ZoomOut aria-hidden="true" size={19} stroke-width={1.8} />
    </button>
    <output data-gallery-zoom aria-live="polite">100%</output>
    <button
      type="button"
      data-gallery-zoom-in
      aria-label="放大"
      title="放大"
    >
      <ZoomIn aria-hidden="true" size={19} stroke-width={1.8} />
    </button>
    <button
      type="button"
      data-gallery-reset
      aria-label="复位图片"
      title="复位"
    >
      <RotateCcw aria-hidden="true" size={18} stroke-width={1.8} />
    </button>
  </div>

  <button
    class="gallery-lightbox__close panzoom-exclude"
    type="button"
    data-gallery-close
    aria-label="关闭大图"
    title="关闭"
  >
    <X aria-hidden="true" size={22} stroke-width={1.8} />
  </button>

  <button
    class="gallery-lightbox__previous panzoom-exclude"
    type="button"
    data-gallery-previous
    aria-label="查看上一张"
    title="上一张"
  >
    <ChevronLeft aria-hidden="true" size={27} stroke-width={1.7} />
  </button>

  <figure>
    <div class="gallery-lightbox__viewport" data-gallery-viewport data-loading="false">
      <LoaderCircle
        class="gallery-lightbox__loader"
        aria-hidden="true"
        size={30}
        stroke-width={1.7}
      />
      <img alt="" hidden draggable="false" data-gallery-image />
    </div>
    <figcaption>
      <span data-gallery-caption></span>
      <small>
        <span data-gallery-count></span>
      </small>
    </figcaption>
  </figure>

  <button
    class="gallery-lightbox__next panzoom-exclude"
    type="button"
    data-gallery-next
    aria-label="查看下一张"
    title="下一张"
  >
    <ChevronRight aria-hidden="true" size={27} stroke-width={1.7} />
  </button>
</dialog>

<script>
  import Panzoom from "@panzoom/panzoom";

  const dialog =
    document.querySelector<HTMLDialogElement>("[data-gallery-lightbox]");
  const viewport =
    dialog?.querySelector<HTMLElement>("[data-gallery-viewport]");
  const dialogImage =
    dialog?.querySelector<HTMLImageElement>("[data-gallery-image]");
  const closeButton =
    dialog?.querySelector<HTMLButtonElement>("[data-gallery-close]");
  const previousButton = dialog?.querySelector<HTMLButtonElement>(
    "[data-gallery-previous]",
  );
  const nextButton = dialog?.querySelector<HTMLButtonElement>(
    "[data-gallery-next]",
  );
  const zoomInButton = dialog?.querySelector<HTMLButtonElement>(
    "[data-gallery-zoom-in]",
  );
  const zoomOutButton = dialog?.querySelector<HTMLButtonElement>(
    "[data-gallery-zoom-out]",
  );
  const resetButton = dialog?.querySelector<HTMLButtonElement>(
    "[data-gallery-reset]",
  );
  const caption = dialog?.querySelector<HTMLElement>("[data-gallery-caption]");
  const count = dialog?.querySelector<HTMLElement>("[data-gallery-count]");
  const zoomOutput = dialog?.querySelector<HTMLOutputElement>(
    "[data-gallery-zoom]",
  );
  const galleryItems = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-gallery-item]"),
  );

  let currentIndex = 0;
  let currentScale = 1;
  let panzoom: ReturnType<typeof Panzoom> | undefined;

  const updateZoomOutput = (scale: number) => {
    currentScale = scale;
    if (zoomOutput) zoomOutput.value = `${Math.round(scale * 100)}%`;
  };

  const handlePanzoomChange = (event: Event) => {
    const detail = (event as CustomEvent<{ scale: number }>).detail;
    updateZoomOutput(detail.scale);
  };

  const disposePanzoom = () => {
    if (viewport && panzoom) {
      viewport.removeEventListener("wheel", panzoom.zoomWithWheel);
    }
    panzoom?.destroy();
    panzoom = undefined;
    updateZoomOutput(1);
  };

  const initializePanzoom = () => {
    if (!dialogImage || !viewport) return;
    disposePanzoom();
    panzoom = Panzoom(dialogImage, {
      canvas: true,
      maxScale: 6,
      minScale: 1,
      panOnlyWhenZoomed: true,
      step: 0.22,
      animate: true,
      duration: 180,
    });
    viewport.addEventListener("wheel", panzoom.zoomWithWheel, {
      passive: false,
    });
  };

  const preloadAdjacentImages = () => {
    if (galleryItems.length < 2) return;
    const indexes = [
      (currentIndex - 1 + galleryItems.length) % galleryItems.length,
      (currentIndex + 1) % galleryItems.length,
    ];
    indexes.forEach((index) => {
      const source = galleryItems[index].dataset.fullSrc;
      if (!source) return;
      const image = new Image();
      image.src = source;
    });
  };

  const showImage = (index: number) => {
    if (!dialogImage || !viewport || galleryItems.length === 0) return;
    currentIndex = (index + galleryItems.length) % galleryItems.length;
    const item = galleryItems[currentIndex];
    const alt = item.dataset.alt ?? "";
    const source = item.dataset.fullSrc ?? "";

    disposePanzoom();
    viewport.dataset.loading = "true";
    dialogImage.hidden = true;
    dialogImage.alt = alt;
    dialogImage.onload = () => {
      dialogImage.hidden = false;
      initializePanzoom();
      viewport.dataset.loading = "false";
    };
    dialogImage.onerror = () => {
      viewport.dataset.loading = "false";
    };
    dialogImage.src = source;

    if (caption) caption.textContent = alt;
    if (count) {
      count.textContent = `${String(currentIndex + 1).padStart(2, "0")} / ${String(galleryItems.length).padStart(2, "0")}`;
    }
    preloadAdjacentImages();
  };

  galleryItems.forEach((item, index) => {
    item.addEventListener("click", (event) => {
      if (!dialog || !dialogImage) return;
      event.preventDefault();
      dialog.showModal();
      showImage(index);
    });
  });

  closeButton?.addEventListener("click", () => dialog?.close());
  previousButton?.addEventListener("click", () => showImage(currentIndex - 1));
  nextButton?.addEventListener("click", () => showImage(currentIndex + 1));
  zoomInButton?.addEventListener("click", () =>
    panzoom?.zoomIn({ animate: true }),
  );
  zoomOutButton?.addEventListener("click", () =>
    panzoom?.zoomOut({ animate: true }),
  );
  resetButton?.addEventListener("click", () =>
    panzoom?.reset({ animate: true }),
  );
  dialogImage?.addEventListener("dblclick", () => {
    if (!panzoom) return;
    if (currentScale > 1.05) {
      panzoom.reset({ animate: true });
    } else {
      panzoom.zoom(2.2, { animate: true });
    }
  });
  dialogImage?.addEventListener("panzoomchange", handlePanzoomChange);

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") showImage(currentIndex - 1);
    if (event.key === "ArrowRight") showImage(currentIndex + 1);
    if (event.key === "+" || event.key === "=") {
      event.preventDefault();
      panzoom?.zoomIn({ animate: true });
    }
    if (event.key === "-") {
      event.preventDefault();
      panzoom?.zoomOut({ animate: true });
    }
    if (event.key === "0") {
      event.preventDefault();
      panzoom?.reset({ animate: true });
    }
  });
  dialog?.addEventListener("close", () => {
    if (!dialogImage || !viewport) return;
    disposePanzoom();
    dialogImage.hidden = true;
    dialogImage.removeAttribute("src");
    dialogImage.alt = "";
    viewport.dataset.loading = "false";
    if (caption) caption.textContent = "";
    if (count) count.textContent = "";
  });
</script>

<style>
  .gallery-lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: rgb(12 10 13 / 96%);
    color: #fff;
  }

  .gallery-lightbox::backdrop {
    background: rgb(12 10 13 / 82%);
  }

  .gallery-lightbox[open] {
    display: block;
  }

  .gallery-lightbox figure {
    position: fixed;
    inset: 72px 78px 26px;
    display: grid;
    margin: 0;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 12px;
  }

  .gallery-lightbox__viewport {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 0;
    place-items: center;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
  }

  .gallery-lightbox__viewport:active {
    cursor: grabbing;
  }

  .gallery-lightbox__viewport img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
    will-change: transform;
  }

  .gallery-lightbox__loader {
    position: absolute;
    color: #ff78a5;
    opacity: 0;
    animation: gallery-spin 900ms linear infinite;
    pointer-events: none;
  }

  .gallery-lightbox__viewport[data-loading="true"]
    .gallery-lightbox__loader {
    opacity: 1;
  }

  .gallery-lightbox button {
    z-index: 3;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid #fff7;
    border-radius: 50%;
    background: #17151a;
    color: #fff;
    cursor: pointer;
  }

  .gallery-lightbox button:hover {
    border-color: #ff78a5;
    color: #ff9abb;
  }

  .gallery-lightbox__close {
    position: fixed;
    top: 18px;
    right: 20px;
  }

  .gallery-lightbox__toolbar {
    position: fixed;
    z-index: 3;
    top: 16px;
    left: 50%;
    display: flex;
    min-height: 46px;
    align-items: center;
    gap: 3px;
    padding: 3px;
    border: 1px solid #ffffff42;
    background: #17151ae8;
    transform: translateX(-50%);
  }

  .gallery-lightbox__toolbar button {
    position: static;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .gallery-lightbox__toolbar output {
    min-width: 58px;
    color: #ddd4da;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-align: center;
  }

  .gallery-lightbox__previous,
  .gallery-lightbox__next {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
  }

  .gallery-lightbox__previous {
    left: 20px;
  }

  .gallery-lightbox__next {
    right: 20px;
  }

  .gallery-lightbox figcaption {
    display: flex;
    min-height: 28px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: #ddd4da;
    font-size: 0.8rem;
  }

  .gallery-lightbox figcaption small {
    display: flex;
    flex: none;
    gap: 7px;
    color: #aaa0a6;
    font-family: var(--font-mono);
    font-size: 0.64rem;
  }

  @keyframes gallery-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 620px) {
    .gallery-lightbox figure {
      inset: 68px 10px 76px;
    }

    .gallery-lightbox__close {
      top: 12px;
      right: 12px;
    }

    .gallery-lightbox__toolbar {
      top: 11px;
      left: 10px;
      transform: none;
    }

    .gallery-lightbox__previous,
    .gallery-lightbox__next {
      top: auto;
      bottom: 16px;
      transform: none;
    }

    .gallery-lightbox__previous {
      left: 16px;
    }

    .gallery-lightbox__next {
      right: 16px;
    }

    .gallery-lightbox figcaption {
      display: grid;
      gap: 2px;
    }

    .gallery-lightbox figcaption small {
      justify-content: space-between;
    }

  }
</style>
