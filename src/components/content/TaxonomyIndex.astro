---
import { ArrowUpRight } from "@lucide/astro";
import type { TaxonomyEntry, TaxonomyKind } from "../../lib/posts";

interface Props {
  entries: TaxonomyEntry[];
  kind: TaxonomyKind;
}

const { entries, kind } = Astro.props;
---

<ol class="taxonomy-index">
  {
    entries.map((entry, index) => {
      const articleLabel = entry.posts.length === 1 ? "ARTICLE" : "ARTICLES";

      return (
        <li>
          <a href={`/${kind}/${entry.slug}/`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <small>
                {String(entry.posts.length).padStart(2, "0")} {articleLabel}
              </small>
              <h2>{entry.name}</h2>
              <p>
                {entry.posts
                  .slice(0, 2)
                  .map((post) => post.data.title)
                  .join(" / ")}
              </p>
            </div>
            <ArrowUpRight aria-hidden="true" size={20} stroke-width={1.7} />
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .taxonomy-index {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .taxonomy-index a {
    display: grid;
    min-height: 144px;
    padding-block: 24px;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: center;
    gap: 26px;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .taxonomy-index a > span,
  .taxonomy-index small {
    font-family: var(--font-mono);
    font-size: 0.67rem;
  }

  .taxonomy-index a > span {
    color: var(--color-rose);
    font-weight: 800;
  }

  .taxonomy-index small,
  .taxonomy-index p {
    color: var(--color-muted);
  }

  .taxonomy-index h2 {
    margin: 4px 0 0;
    font-size: 1.75rem;
  }

  .taxonomy-index p {
    max-width: 700px;
    margin: 8px 0 0;
    font-size: 0.84rem;
  }

  .taxonomy-index a:hover h2,
  .taxonomy-index a:hover > :global(svg) {
    color: var(--color-rose);
  }

  @media (max-width: 620px) {
    .taxonomy-index a {
      min-height: 126px;
      grid-template-columns: 36px minmax(0, 1fr) auto;
      gap: 12px;
    }

    .taxonomy-index h2 {
      font-size: 1.35rem;
    }

    .taxonomy-index p {
      display: none;
    }
  }
</style>
