---
import { Archive, FolderTree, LayoutList, Tags } from "@lucide/astro";

interface Props {
  current: "latest" | "archives" | "categories" | "tags";
  postCount: number;
  categoryCount: number;
  tagCount: number;
}

const { current, postCount, categoryCount, tagCount } = Astro.props;
const entries = [
  {
    id: "latest",
    label: "最新",
    href: "/posts/",
    count: postCount,
    icon: LayoutList,
  },
  {
    id: "archives",
    label: "归档",
    href: "/archives/",
    count: postCount,
    icon: Archive,
  },
  {
    id: "categories",
    label: "分类",
    href: "/categories/",
    count: categoryCount,
    icon: FolderTree,
  },
  {
    id: "tags",
    label: "标签",
    href: "/tags/",
    count: tagCount,
    icon: Tags,
  },
] as const;
---

<nav class="content-directory page-width" aria-label="文章浏览方式">
  {
    entries.map((entry) => {
      const Icon = entry.icon;
      const active = current === entry.id;

      return (
        <a href={entry.href} aria-current={active ? "page" : undefined}>
          <Icon aria-hidden="true" size={18} stroke-width={1.7} />
          <span>{entry.label}</span>
          <small>{String(entry.count).padStart(2, "0")}</small>
        </a>
      );
    })
  }
</nav>

<style>
  .content-directory {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .content-directory a {
    display: grid;
    min-height: 68px;
    padding: 12px 18px;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    color: var(--color-muted);
    text-decoration: none;
  }

  .content-directory a + a {
    border-left: 1px solid var(--color-line);
  }

  .content-directory a:hover,
  .content-directory a[aria-current="page"] {
    background: var(--color-surface-soft);
    color: var(--color-ink);
  }

  .content-directory a[aria-current="page"] :global(svg) {
    color: var(--color-rose);
  }

  .content-directory span {
    font-weight: 750;
  }

  .content-directory small {
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  @media (max-width: 620px) {
    .content-directory {
      width: 100%;
    }

    .content-directory a {
      min-height: 62px;
      padding: 10px 6px;
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 3px;
    }

    .content-directory span {
      font-size: 0.78rem;
    }

    .content-directory small {
      display: none;
    }
  }
</style>
