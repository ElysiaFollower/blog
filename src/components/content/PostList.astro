---
import { ArrowUpRight } from "@lucide/astro";
import type { PublishedPost } from "../../lib/posts";
import { taxonomyHref } from "../../lib/posts";

interface Props {
  posts: PublishedPost[];
  showCategory?: boolean;
}

const { posts, showCategory = true } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  month: "2-digit",
  day: "2-digit",
});
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li>
        <time datetime={post.data.pubDate.toISOString()}>
          {dateFormatter.format(post.data.pubDate)}
        </time>
        <div>
          {showCategory && (
            <a
              class="post-list__category"
              href={taxonomyHref("categories", post.data.category)}
            >
              {post.data.category}
            </a>
          )}
          <h2>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
          <ul aria-label="标签">
            {post.data.tags.slice(0, 3).map((tag) => (
              <li>
                <a href={taxonomyHref("tags", tag)}>#{tag}</a>
              </li>
            ))}
          </ul>
        </div>
        <a
          class="post-list__open"
          href={`/posts/${post.id}/`}
          aria-label={`阅读《${post.data.title}》`}
          title="阅读文章"
        >
          <ArrowUpRight aria-hidden="true" size={19} stroke-width={1.8} />
        </a>
      </li>
    ))
  }
</ol>

<style>
  .post-list,
  .post-list ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .post-list {
    border-top: 1px solid var(--color-line);
  }

  .post-list > li {
    display: grid;
    min-height: 164px;
    padding-block: 28px;
    grid-template-columns: 72px minmax(0, 1fr) 42px;
    align-items: start;
    gap: 28px;
    border-bottom: 1px solid var(--color-line);
  }

  .post-list > li > time {
    padding-top: 5px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.69rem;
  }

  .post-list__category {
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
  }

  .post-list h2 {
    max-width: 32ch;
    margin: 6px 0 0;
    font-family: var(--font-reading);
    font-size: 1.55rem;
    line-height: 1.35;
  }

  .post-list h2 a,
  .post-list ul a {
    text-decoration: none;
  }

  .post-list p {
    max-width: 740px;
    margin: 8px 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .post-list ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 13px;
    color: var(--color-muted);
    font-size: 0.72rem;
  }

  .post-list ul a:hover,
  .post-list h2 a:hover {
    color: var(--color-rose);
  }

  .post-list__open {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 50%;
  }

  .post-list__open:hover {
    border-color: var(--color-rose);
    color: var(--color-rose);
  }

  @media (max-width: 620px) {
    .post-list > li {
      min-height: 0;
      grid-template-columns: 46px minmax(0, 1fr);
      gap: 14px;
    }

    .post-list h2 {
      font-size: 1.25rem;
    }

    .post-list__open {
      display: none;
    }
  }
</style>
