---
interface Props {
  kicker: string;
  title: string;
  description: string;
  note?: string;
}

const { kicker, title, description, note } = Astro.props;
const longTitle = title.length > 12;
---

<header class="content-page-header page-width">
  <p>{kicker}</p>
  <h1 class:list={{ "is-long": longTitle }}>{title}</h1>
  <div>
    <span>{description}</span>
    {note && <small>{note}</small>}
  </div>
</header>

<style>
  .content-page-header {
    display: grid;
    padding-block: 88px;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.65fr);
    align-items: end;
    gap: 36px;
  }

  .content-page-header > p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-rose);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .content-page-header h1 {
    margin: 0;
    font-family: var(--font-reading);
    font-size: 7rem;
    font-weight: 700;
    line-height: 0.9;
    text-wrap: balance;
  }

  .content-page-header h1.is-long {
    font-size: 5.4rem;
  }

  .content-page-header div {
    display: grid;
    gap: 8px;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .content-page-header small {
    font-family: var(--font-mono);
    font-size: 0.67rem;
  }

  @media (max-width: 900px) {
    .content-page-header {
      padding-block: 68px;
      grid-template-columns: 1fr;
    }

    .content-page-header h1 {
      font-size: 5rem;
    }

    .content-page-header h1.is-long {
      font-size: 4rem;
    }
  }

  @media (max-width: 520px) {
    .content-page-header {
      padding-block: 54px;
      gap: 24px;
    }

    .content-page-header h1 {
      font-size: 3.8rem;
    }

    .content-page-header h1.is-long {
      font-size: 3rem;
    }
  }

  @media (max-width: 350px) {
    .content-page-header h1.is-long {
      font-size: 2.55rem;
    }
  }
</style>
