---
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import portrait from "../../assets/demo/elysia-portrait.webp";
import { profileConfig } from "../../config/profile";
---
<section class="author-coda" id="the-author" aria-labelledby="person-title" data-author-coda>
  <div class="author-coda__inner page-width">
    <header><span>03 / A PERSONAL NOTE</span><span>写在日志的末尾</span></header>
    <div class="author-coda__spread">
      <div class="author-coda__words">
        <p>研究之外，也认真玩耍。</p>
        <h2 id="person-title"><span>一个相信童话的</span><em>妄想家。</em></h2>
        <span class="author-coda__rule" aria-hidden="true"></span>
        <p class="author-coda__name">{profileConfig.handle}<small>也使用网名 {profileConfig.alias}</small></p>
      </div>
      <figure class="author-coda__portrait">
        <Image src={portrait} alt="花园茶会中的爱莉希雅" widths={[600,900,1200]} sizes="46vw" loading="lazy" />
        <figcaption><span>日常的一角</span><span>17 / LIFE & DAYDREAM</span></figcaption>
      </figure>
      <div class="author-coda__letter">
        <p>{profileConfig.introduction}。</p>
        <p>主线之外，还有许多兔子洞。</p>
        <a href="/about/">多认识我一点 <ArrowUpRight size={24} aria-hidden="true" /></a>
      </div>
    </div>
    <footer><span>语音对话 / 情感交互 / 音频与音乐生成</span><a href="/about/">下一页，关于我 <ArrowUpRight size={16} aria-hidden="true" /></a></footer>
  </div>
</section>
<script>
  import { scrollScene, entryProgress, ease } from "./scroll-scene";
  document.querySelectorAll<HTMLElement>("[data-author-coda]").forEach(root => {
    scrollScene(root, entryProgress, progress => {
      const p = ease(progress);
      root.style.setProperty("--coda-portrait-y", `${(1-p)*95}px`);
      root.style.setProperty("--coda-portrait-angle", `${5-p*8}deg`);
      root.style.setProperty("--coda-letter-y", `${(1-p)*145}px`);
      root.style.setProperty("--coda-title-x", `${(1-p)*-55}px`);
      root.style.setProperty("--coda-rule", String(.2+p*.8));
    });
  });
</script>
<style>
  .author-coda {
    position: relative;
    background: var(--author-wash);
    overflow: hidden;
  }

  .author-coda__inner {
    padding-block: 46px 28px;
  }

  .author-coda header,.author-coda footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    color: var(--author-ink);
    font: .68rem/1.6 var(--font-mono);
  }

  .author-coda header {
    padding-bottom: 26px;
    border-bottom: 1px solid color-mix(in srgb,var(--author-ink) 28%,transparent);
  }

  .author-coda header > span:last-child {
    font-family: var(--font-reading);
    font-size: .85rem;
  }

  .author-coda__spread {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: start;
    padding-block: 58px 35px;
    min-height: 730px;
  }

  .author-coda__words {
    position: relative;
    z-index: 2;
    padding-top: 10px;
  }

  .author-coda__words > p:first-child {
    margin: 0 0 30px;
    font: .95rem var(--font-reading);
    color: var(--author-ink);
  }

  .author-coda h2 {
    margin: 0;
    font: 400 clamp(2rem,3.1vw,3rem)/1.5 var(--font-reading);
    letter-spacing: -.04em;
  }

  .author-coda h2 > span {
    display: block;
  }

  .author-coda h2 em {
    display: block;
    color: var(--author-ink);
    font-size: clamp(4rem,7.7vw,7.6rem);
    font-style: normal;
    line-height: 1.3;
    margin-top: 6px;
  }

  .author-coda__rule {
    display: block;
    margin-block: 35px 27px;
    width: 72%;
    height: 1px;
    background: color-mix(in srgb,var(--author-ink) 40%,transparent);
    transform: scaleX(var(--coda-rule,1));
    transform-origin: left;
  }

  .author-coda__name {
    margin: 0;
    font: 1.3rem var(--font-reading);
  }

  .author-coda__name small {
    display: block;
    margin-top: 12px;
    font: .75rem var(--font-ui);
    color: var(--color-muted);
  }

  .author-coda__portrait {
    position: relative;
    margin: 0 22px 50px 0;
    padding: 12px 12px 0;
    background: var(--paper-white);
    box-shadow: 0 22px 60px #402b291a;
    transform: rotate(-3deg);
  }

  .author-coda__portrait :global(img) {
    width: 100%;
    height: 465px;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .author-coda__portrait figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 4px;
    font: .7rem var(--font-reading);
    color: var(--author-ink);
  }

  .author-coda__portrait figcaption > span:last-child {
    font: .56rem var(--font-mono);
  }

  .author-coda__letter {
    position: relative;
    z-index: 3;
    grid-column: 1/-1;
    justify-self: center;
    width: 47%;
    margin: -135px 0 0 20%;
    padding: 30px 35px;
    background: var(--writing-paper);
    border-top: 2px solid color-mix(in srgb,var(--author-ink) 45%,transparent);
    box-shadow: 0 14px 35px #4c372a10;
  }

  .author-coda__letter p {
    margin: 0;
    color: var(--color-muted);
    font: .95rem/1.9 var(--font-reading);
    text-wrap: balance;
  }

  .author-coda__letter p + p {
    margin-top: 12px;
  }

  .author-coda__letter a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 22px;
    margin-top: 22px;
    min-height: 48px;
    border-top: 1px solid var(--color-line);
    color: var(--author-ink);
    text-decoration: none;
    font: .85rem var(--font-ui);
  }

  .author-coda footer {
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb,var(--author-ink) 25%,transparent);
  }

  .author-coda footer > a {
    display: flex;
    gap: 25px;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  [data-scene-ready] .author-coda__words {
    transform: translateX(var(--coda-title-x,0px));
  }

  [data-scene-ready] .author-coda__portrait {
    transform: translateY(var(--coda-portrait-y,0px)) rotate(var(--coda-portrait-angle,-3deg));
  }

  [data-scene-ready] .author-coda__letter {
    transform: translateY(var(--coda-letter-y,0px));
  }

  @media (max-width:1023px) {
    .author-coda__spread {
      display: block;
    }

    .author-coda__portrait {
      margin: 40px 12px;
    }

    .author-coda__letter {
      width: auto;
      margin: 0;
    }

    .author-coda footer > a {
      display: none;
    }

  }
</style>
