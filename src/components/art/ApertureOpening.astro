<div class="aperture-opening" data-art-opening>
  <div class="aperture-opening__orbit" aria-hidden="true"></div>
  <div class="aperture-opening__copy" aria-hidden="true">
    <span>17</span>
    <p>漫步星海，收拢记忆回响</p>
    <small>THE VOYAGE CONTINUES</small>
  </div>
  <button type="button" data-skip-opening>跳过开场 ↗</button>
</div>

<script>
  const opening = document.querySelector<HTMLElement>("[data-art-opening]");
  if (opening) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let seen = false;
    try { seen = !!sessionStorage.getItem("opening-seen"); } catch { /* Storage is optional. */ }
    if (seen || motion.matches) opening.remove();
    else {
      let closed = false;
      let timer = 0;
      const start = performance.now();
      const close = (skip = false) => {
        if (closed) return;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          closed = true;
          try { sessionStorage.setItem("opening-seen", "true"); } catch { /* The next visit can replay. */ }
          const hadFocus = opening.contains(document.activeElement);
          opening.dataset.leaving = "true";
          opening.inert = true;
          if (hadFocus) document.querySelector<HTMLAnchorElement>(".voyage__read")?.focus({ preventScroll:true });
          window.setTimeout(() => opening.remove(), 950);
        }, skip ? 0 : Math.max(0, 650 - (performance.now() - start)));
      };
      opening.querySelector("[data-skip-opening]")?.addEventListener("click", () => close(true));
      const image = document.querySelector<HTMLImageElement>(`img[data-hero-theme="${document.documentElement.dataset.theme}"]`);
      Promise.allSettled([document.fonts.ready, image?.decode()]).then(() => close());
      window.setTimeout(() => close(), 1800);
      motion.addEventListener("change", () => close(true), { once:true });
    }
  }
</script>

<style>
  .aperture-opening {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9000;
    place-content: center;
    overflow: hidden;
    background: #171625;
    color: #f6f0ec;
    clip-path: circle(150% at 71% 46%);
    transition: clip-path 900ms cubic-bezier(.76,0,.24,1), visibility 900ms;
    animation: opening-failsafe 1ms 4s forwards;
  }

  :global(.js:not(.opening-seen)) .aperture-opening {
    display: grid;
  }

  .aperture-opening[data-leaving] {
    clip-path: circle(0% at 71% 46%);
    visibility: hidden;
    pointer-events: none;
  }

  .aperture-opening__orbit {
    position: absolute;
    width: min(70vw,630px);
    aspect-ratio: 1;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    border: 1px solid #e1c5dc40;
    border-radius: 50%;
    box-shadow: 0 0 0 40px #d0b8e508,0 0 0 120px #d0b8e505;
  }

  .aperture-opening__orbit::after {
    position: absolute;
    inset: 12%;
    border: 1px solid #d9b4d5;
    border-radius: 50%;
    transform: rotate(-35deg) scaleY(.45);
    content: "";
  }

  .aperture-opening__copy {
    position: relative;
    text-align: center;
  }

  .aperture-opening__copy > span {
    font: italic clamp(7rem,18vw,13rem)/1 var(--font-reading);
    color: #e4bfd9;
  }

  p {
    margin: 24px 0 12px;
    font-family: var(--font-reading);
    letter-spacing: .15em;
  }

  small {
    font: .58rem var(--font-mono);
    letter-spacing: .25em;
    color: #c0b7cb;
  }

  button {
    position: absolute;
    right: var(--page-inline);
    bottom: 32px;
    min-height: 44px;
    padding: 12px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: .75rem;
  }

  @keyframes opening-failsafe {
    to {
      visibility: hidden;
      pointer-events: none;
    }

  }

  @media (prefers-reduced-motion:reduce) {
    .aperture-opening {
      display: none!important;
    }

  }
</style>
