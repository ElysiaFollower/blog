---
import { Image } from "astro:assets";
import { ArrowDownRight, GraduationCap, Microscope } from "@lucide/astro";
import portrait from "../../assets/demo/elysia-portrait.webp";
import { profileConfig } from "../../config/profile";
---
<section class="about-prologue" data-about-intro aria-labelledby="about-title">
  <div class="page-width">
    <header><span>ABOUT / 0017</span><span>研究，也玩耍</span></header>
    <div class="about-prologue__spread">
      <div class="about-prologue__copy">
        <p class="about-prologue__greeting">你好，</p>
        <h1 id="about-title"><span>我是</span>{profileConfig.handle}</h1>
        <p class="about-prologue__alias">也使用网名 {profileConfig.alias}</p>
        <p class="about-prologue__note">把好奇心，<br />留给值得折腾的事。</p>
        <p class="about-prologue__intro">{profileConfig.introduction}。</p>
        <div class="about-prologue__status"><span><GraduationCap size={17} aria-hidden="true" />{profileConfig.education}</span><span><Microscope size={17} aria-hidden="true" />{profileConfig.nextStage}</span></div>
        <a href="#research">从关注的方向说起 <ArrowDownRight size={20} aria-hidden="true" /></a>
      </div>
      <figure class="about-prologue__portrait">
        <div class="about-prologue__mount"><Image src={portrait} alt="花园茶会中的爱莉希雅" widths={[600,900,1200]} sizes="42vw" loading="eager" /></div>
        <span class="about-prologue__folio" aria-hidden="true">17</span>
        <figcaption><span>研究之外，也认真玩耍。</span><span>01 / A PORTRAIT</span></figcaption>
      </figure>
    </div>
    <footer><span>关于我，也关于那些让我好奇的事。</span><span aria-hidden="true">↓</span></footer>
  </div>
</section>
<style>
  .about-prologue {
    position: relative;
    overflow: hidden;
    background: var(--paper-gold);
  }

  .about-prologue > .page-width {
    padding-block: 28px 26px;
  }

  .about-prologue header,.about-prologue footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    color: var(--color-gold);
    font: .68rem var(--font-mono);
  }

  .about-prologue header {
    padding-bottom: 22px;
    border-bottom: 1px solid color-mix(in srgb,var(--color-gold) 25%,transparent);
  }

  .about-prologue header > span:last-child {
    font: .85rem var(--font-reading);
  }

  .about-prologue__spread {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 100px;
    padding-block: 44px 40px;
    align-items: center;
  }

  .about-prologue__greeting {
    margin: 0 0 10px;
    color: var(--color-gold);
    font: 1.5rem var(--font-reading);
  }

  .about-prologue h1 {
    margin: 0;
    font: 400 clamp(2rem,3.5vw,3.5rem)/1.3 var(--font-reading);
    letter-spacing: -.05em;
  }

  .about-prologue h1 > span {
    display: block;
    font-size: .45em;
    margin-bottom: 9px;
    letter-spacing: 0;
  }

  .about-prologue__alias {
    margin: 16px 0 0;
    color: var(--color-muted);
    font: .75rem var(--font-mono);
  }

  .about-prologue__note {
    margin: 32px 0 20px;
    font: 400 1.75rem/1.6 var(--font-reading);
  }

  .about-prologue__intro {
    margin: 0;
    color: var(--color-muted);
    font-size: .9rem;
    line-height: 1.95;
    max-width: 450px;
    text-wrap: balance;
  }

  .about-prologue__status {
    display: grid;
    gap: 10px;
    padding-top: 22px;
    margin-top: 26px;
    border-top: 1px solid color-mix(in srgb,var(--color-gold) 25%,transparent);
    font: .7rem var(--font-mono);
    color: var(--color-muted);
  }

  .about-prologue__status > span {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .about-prologue__status svg {
    color: var(--color-gold);
  }

  .about-prologue__copy > a {
    display: inline-flex;
    gap: 40px;
    min-height: 44px;
    align-items: center;
    margin-top: 20px;
    color: var(--color-gold);
    font-size: .8rem;
    text-decoration: none;
  }

  .about-prologue__portrait {
    position: relative;
    margin: 0 20px 0 0;
  }

  .about-prologue__portrait::before {
    content: "";
    position: absolute;
    top: 9%;
    left: -36px;
    right: 36px;
    bottom: 0;
    border: 1px solid color-mix(in srgb,var(--color-gold) 30%,transparent);
    border-radius: 240px 240px 0 0;
    transform: rotate(-5deg);
  }

  .about-prologue__mount {
    position: relative;
    height: 520px;
    overflow: hidden;
    border-radius: 240px 240px 2px 2px;
    box-shadow: 0 15px 35px #5d3a2e12;
  }

  .about-prologue__mount :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transform: scale(var(--intro-image-scale,1));
  }

  .about-prologue__folio {
    position: absolute;
    left: -54px;
    bottom: 30px;
    color: var(--paper-gold);
    font: italic 8rem/1 var(--font-reading);
    text-shadow: 1px 1px 0 var(--color-gold),-1px -1px 0 var(--color-gold);
  }

  .about-prologue figcaption {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding-top: 20px;
    color: var(--color-gold);
    font: .75rem var(--font-reading);
  }

  .about-prologue figcaption > span:last-child {
    font: .58rem var(--font-mono);
    padding-top: 3px;
  }

  .about-prologue footer {
    padding-top: 22px;
    border-top: 1px solid color-mix(in srgb,var(--color-gold) 25%,transparent);
    font: .85rem var(--font-reading);
  }

  [data-scene-ready] .about-prologue__copy {
    transform: translateY(var(--intro-copy-y,0px));
  }

  [data-scene-ready] .about-prologue__portrait {
    transform: translateX(var(--intro-image-x,0px)) rotate(var(--intro-image-angle,0deg));
  }

  @media (max-width:1023px) {
    .about-prologue__spread {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .about-prologue__portrait {
      max-width: 480px;
      margin-left: 35px;
    }

  }
</style>
