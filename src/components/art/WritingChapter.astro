---
import { Image } from "astro:assets";
import { ArrowUpRight, ArrowDown } from "@lucide/astro";
import { postHref, getCatalogBreadcrumbs, type PublishedPost } from "../../lib/posts";
interface Props { posts: PublishedPost[] }
const { posts } = Astro.props;
const date = new Intl.DateTimeFormat("zh-CN", { year:"numeric", month:"2-digit", day:"2-digit" });
---
<div class="writing-story" data-writing-story style={`--story-count:${Math.max(1,posts.length)}`}>
  {posts.map((_,index) => <span class="writing-story__stop" id={`writing-step-${index + 1}`} style={`--step:${index}`} aria-hidden="true"></span>)}
  <div class="writing-story__stage page-width">
    <header class="writing-story__heading">
      <div><p>01 / WRITING</p><h2 id="writing-title">新近落笔<span>。</span></h2></div>
      <p>沿着时间，翻开最近几页。</p>
      <a href="/posts/">全部文章 <ArrowUpRight size={19} aria-hidden="true" /></a>
    </header>
    <div class="writing-story__pages">
      {posts.map((post,index) => {
        const separator = post.data.title.search(/[:：]/);
        const lead = post.data.title.slice(0,separator+1);
        const qualifiedLead = lead.match(/^(.*?)([（(].*[）)])([：:])$/);
        return (<article class="writing-story__page" data-writing-page data-scene-content data-post-id={post.id}>
          <a class="writing-story__art" href={postHref(post)} aria-label={`阅读：${post.data.title}`}>
            <Image src={post.data.cover} alt={post.data.coverAlt} widths={[720,1080,1440]} sizes="52vw" loading="lazy" style={`object-position:${post.data.coverPosition}`} />
            <span class="writing-story__sheet-number" aria-hidden="true">0{index+1}</span>
          </a>
          <div class="writing-story__paper">
            <p class="writing-story__meta"><span>{getCatalogBreadcrumbs(post,false).map(item=>item.label).join(" / ")}</span><time datetime={post.data.pubDate.toISOString()}>{date.format(post.data.pubDate)}</time>{post.data.draft && <span>草稿预览</span>}</p>
            <h3><a href={postHref(post)}>{separator >= 0 ? <><span>{qualifiedLead ? <>{qualifiedLead[1]}<small>{qualifiedLead[2]}{qualifiedLead[3]}</small></> : lead}</span><span>{post.data.title.slice(separator+1)}</span></> : post.data.title}</a></h3>
            <p class="writing-story__description">{post.data.description}</p>
            <a class="writing-story__read" href={postHref(post)}>读这一篇 <ArrowUpRight size={20} aria-hidden="true" /></a>
            <div class="writing-story__folio"><span>{post.data.pubDate.getFullYear()}</span><span>航行手记 / {String(index+1).padStart(2,"0")}</span></div>
          </div>
        </article>);
      })}
    </div>
    <footer class="writing-story__footer">
      <span><ArrowDown size={15} aria-hidden="true" /><span data-writing-cue>向下翻页</span></span>
      <nav aria-label="新近文章页码">{posts.map((post,index) => <a href={`#writing-step-${index+1}`} data-writing-index aria-label={`第${index+1}篇：${post.data.title}`}>{String(index+1).padStart(2,"0")}<i></i></a>)}</nav>
      <a href="/posts/catalog/">按主题找文章 <ArrowUpRight size={16} aria-hidden="true" /></a>
    </footer>
  </div>
</div>
<script>
  import { mountWritingStory } from "./writing-story";
  document.querySelectorAll<HTMLElement>("[data-writing-story]").forEach(mountWritingStory);
</script>
<style>
  .writing-story {
    position: relative;
    padding: 60px 0;
  }

  .writing-story__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 36px;
    margin-bottom: 48px;
  }

  .writing-story__heading > div > p {
    margin: 0 0 18px;
    color: var(--writing-ink);
    font: .67rem var(--font-mono);
    letter-spacing: .12em;
  }

  h2 {
    margin: 0;
    font: 400 3.1rem/1.2 var(--font-reading);
    letter-spacing: -.04em;
  }

  h2 > span {
    color: var(--writing-ink);
  }

  .writing-story__heading > p {
    margin: 0 0 5px;
    color: var(--color-muted);
    font: .95rem var(--font-reading);
  }

  .writing-story__heading > a {
    display: flex;
    align-items: center;
    gap: 26px;
    min-height: 44px;
    border-bottom: 1px solid var(--writing-ink);
    color: var(--writing-ink);
    font-size: .85rem;
    text-decoration: none;
  }

  .writing-story__page {
    display: grid;
    grid-template-columns: 1.12fr 1fr;
    align-items: center;
    padding-block: 30px;
  }

  .writing-story__art {
    position: relative;
    display: block;
    height: 480px;
    overflow: hidden;
    background: var(--writing-paper);
  }

  .writing-story__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .writing-story__sheet-number {
    position: absolute;
    bottom: 22px;
    left: 22px;
    font: italic 4rem/1 var(--font-reading);
    color: #fff;
    text-shadow: 0 2px 24px #2037374d;
  }

  .writing-story__paper {
    position: relative;
    padding: 46px;
    background: var(--writing-paper);
    box-shadow: 0 16px 45px #24382e0d;
  }

  .writing-story__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: 0;
    color: var(--color-muted);
    font: .72rem/1.7 var(--font-mono);
  }

  .writing-story__meta > span:first-child {
    color: var(--writing-ink);
  }

  h3 {
    margin: 26px 0 24px;
    font: 500 clamp(1.8rem,2.35vw,2.4rem)/1.6 var(--font-reading);
    text-wrap: balance;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a > span {
    display: block;
  }

  h3 a > span + span {
    font-size: .9em;
    margin-top: 8px;
  }

  h3 small {
    display: inline-block;
    margin-left: .5em;
    font-size: .62em;
    white-space: nowrap;
  }

  h3 a:hover {
    color: var(--writing-ink);
  }

  .writing-story__description {
    margin: 0;
    color: var(--color-muted);
    font-size: .95rem;
    line-height: 1.95;
  }

  .writing-story__read {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    min-height: 46px;
    margin-top: 28px;
    border-bottom: 1px solid var(--writing-ink);
    color: var(--writing-ink);
    font-size: .875rem;
    text-decoration: none;
  }

  .writing-story__folio {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
    color: var(--writing-ink);
  }

  .writing-story__folio > span:first-child {
    font: italic 1.5rem var(--font-reading);
  }

  .writing-story__folio > span:last-child {
    font: .65rem var(--font-mono);
    letter-spacing: .08em;
  }

  .writing-story__footer, .writing-story__stop {
    display: none;
  }

  .writing-story[data-scene-ready] {
    height: calc(100svh + (var(--story-count) - 1) * 65svh);
    padding: 0;
  }

  [data-scene-ready] .writing-story__stage {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    height: 100svh;
    min-height: 650px;
    padding-block: 44px 26px;
  }

  [data-scene-ready] .writing-story__heading {
    margin-bottom: 20px;
  }

  [data-scene-ready] .writing-story__pages {
    position: relative;
    flex: 1;
    min-height: 0;
    perspective: 1800px;
  }

  [data-scene-ready] .writing-story__page {
    position: absolute;
    inset: 0;
    padding: 14px 0 20px;
    opacity: var(--page-opacity,0);
    transform: translate3d(var(--page-x,0px),var(--page-y,0px),var(--page-z,0px)) rotateY(var(--page-angle,0deg));
    pointer-events: none;
  }

  [data-scene-ready] .writing-story__page[data-current] {
    pointer-events: auto;
  }

  [data-scene-ready] .writing-story__art {
    height: clamp(380px,58svh,570px);
    width: 105%;
    transform: rotate(var(--art-tilt,0deg)) scale(var(--art-scale,1));
    clip-path: inset(var(--art-clip,0%) 0 0 0 round 5px);
    box-shadow: 0 18px 44px #24382e18;
  }

  [data-scene-ready] .writing-story__art :global(img) {
    transform: scale(var(--image-scale,1));
  }

  [data-scene-ready] .writing-story__paper {
    margin-left: 20px;
    transform: translateY(var(--paper-y,0px));
    border-left: 3px solid color-mix(in srgb,var(--writing-ink) 30%,transparent);
  }

  [data-scene-ready] .writing-story__paper > * {
    opacity: var(--paper-ink,1);
  }

  [data-scene-ready] .writing-story__stop {
    display: block;
    position: absolute;
    top: calc(var(--step) * 65svh);
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  [data-scene-ready] .writing-story__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    min-height: 44px;
    color: var(--writing-ink);
    font-size: .75rem;
  }

  .writing-story__footer > span, .writing-story__footer > a {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .writing-story__footer nav {
    display: flex;
    gap: 14px;
  }

  .writing-story__footer nav > a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    text-decoration: none;
    font: .7rem var(--font-mono);
    opacity: .45;
  }

  .writing-story__footer nav > a[aria-current] {
    opacity: 1;
  }

  .writing-story__footer i {
    width: 45px;
    height: 1px;
    background: currentColor;
    transform: scaleX(var(--index-progress,0));
    transform-origin: left;
  }
</style>
