<script>
  // A scene reacts only while visible. Native scrolling remains the source of truth.
  const motion = matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
  document.querySelectorAll<HTMLElement>("[data-art-scene]").forEach((scene) => {
    let visible = false;
    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;
    const paint = () => {
      frame = 0;
      if (!visible || motion.matches) return;
      const rect = scene.getBoundingClientRect();
      const progress = Math.max(-1, Math.min(1, -rect.top / rect.height));
      scene.style.setProperty("--scene-scroll", String(progress));
      scene.style.setProperty("--scene-x", `${pointerX.toFixed(3)}`);
      scene.style.setProperty("--scene-y", `${pointerY.toFixed(3)}`);
    };
    const request = () => { if (!frame && visible && !motion.matches) frame = requestAnimationFrame(paint); };
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) request();
    });
    observer.observe(scene);
    window.addEventListener("scroll", request, { passive: true });
    scene.addEventListener("pointermove", (event) => {
      if (!finePointer.matches) return;
      const rect = scene.getBoundingClientRect();
      pointerX = (event.clientX - rect.left) / rect.width - .5;
      pointerY = (event.clientY - rect.top) / rect.height - .5;
      request();
    }, { passive: true });
    scene.addEventListener("pointerleave", () => { pointerX = pointerY = 0; request(); });
    motion.addEventListener("change", () => {
      scene.style.setProperty("--scene-scroll", "0");
      scene.style.setProperty("--scene-x", "0");
      scene.style.setProperty("--scene-y", "0");
      request();
    });
  });
</script>
