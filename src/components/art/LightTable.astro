---
import { Image } from "astro:assets";
import { ArrowLeft, ArrowRight, ArrowUpRight } from "@lucide/astro";
import bloom from "../../assets/demo/gallery/elysia-in-bloom.webp";
import kiana from "../../assets/demo/gallery/kiana-in-light.webp";
import spring from "../../assets/demo/gallery/seele-spring.webp";
import moment from "../../assets/demo/gallery/golden-moment.webp";
import journey from "../../assets/demo/gallery/journey.webp";
import { getGalleryEntries } from "../../lib/gallery";

const collection = await getGalleryEntries();
const selection = [kiana, spring, bloom, moment, journey].map((image) => {
  const entry = collection.find((item) => item.src === image.src);
  if (!entry) throw new Error(`Selected artwork is missing from the gallery: ${image.src}`);
  return { image, entry };
});
---

<section class="light-table" id="selected-light" aria-labelledby="light-table-title" data-light-table>
  <div class="light-table__heading page-width">
    <div><p class="art-kicker">02 / IMAGES</p><h2 id="light-table-title">记忆的<br /><em>回廊。</em></h2></div>
    <p>光影停在画面里，<br />旧日的心绪也有了归处。</p>
    <a href="/gallery/">浏览全部收藏 <ArrowUpRight size={18} aria-hidden="true" /></a>
  </div>
  <div class="light-table__stage" data-light-stage role="region" aria-roledescription="轮播" aria-label="五幅精选收藏" tabindex="0">
    <div class="light-table__pool" aria-hidden="true"></div>
    <div class="light-table__track">
      {selection.map(({image, entry}, index) => (
        <a class="light-table__work" style={`--work-ratio:${image.width / image.height}`} data-light-work href={entry.src} data-gallery-href={`/gallery/#work=${encodeURIComponent(entry.id)}`} aria-label={`查看原图：${entry.title ?? entry.alt}`}>
          <figure>
            <Image src={image} alt={entry.alt} widths={[420, 680, 900]} sizes="(max-width: 620px) 70vw, 360px" loading="lazy" draggable="false" />
            <figcaption><span>{String(index + 1).padStart(2,"0")}</span><span>{entry.title ?? entry.alt}</span><ArrowUpRight size={15} aria-hidden="true" /></figcaption>
          </figure>
        </a>
      ))}
    </div>
  </div>
  <div class="light-table__footer page-width">
    <p class="light-table__hint">五幅精选 · 点开看大图</p>
    <p class="light-table__position" data-light-position aria-live="polite" aria-atomic="true">精选收藏</p>
    <div class="light-table__controls" hidden data-light-controls>
      <button type="button" data-light-prev aria-label="上一幅精选"><ArrowLeft size={19} aria-hidden="true" /></button>
      <button type="button" data-light-next aria-label="下一幅精选"><ArrowRight size={19} aria-hidden="true" /></button>
    </div>
  </div>
</section>

<script>
  import { mountLightTable } from "./light-table";
  document.querySelectorAll<HTMLElement>("[data-light-table]").forEach(mountLightTable);
</script>

<style>
  .light-table {
    position: relative;
    overflow: hidden;
    padding: 120px 0 46px;
    background: var(--art-night);
    color: var(--art-chalk);
    isolation: isolate;
  }

  .light-table::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background: radial-gradient(ellipse at 60% 56%,#66516d29,transparent 65%);
  }

  .light-table__heading {
    display: grid;
    grid-template-columns: 1.2fr 1fr auto;
    align-items: end;
    gap: 40px;
  }

  .art-kicker {
    margin: 0 0 26px;
    color: #bfb0c7;
    font: .6rem var(--font-mono);
    letter-spacing: .14em;
  }

  h2 {
    margin: 0;
    font: 400 clamp(3.1rem,6vw,5.8rem)/1.12 var(--font-reading);
    letter-spacing: -.04em;
  }

  h2 em {
    font-style: normal;
    margin-left: 1em;
    color: #dec4d8;
  }

  .light-table__heading > p {
    margin: 0 0 6px;
    color: #c1b7c8;
    font: .9rem/2 var(--font-reading);
  }

  .light-table__heading > a {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 44px;
    border-bottom: 1px solid #e6d8e34d;
    padding-bottom: 8px;
    margin-bottom: 8px;
    font-size: .875rem;
    text-decoration: none;
  }

  .light-table__stage {
    --work-height: 380px;
    position: relative;
    margin-block: 40px 12px;
    padding: 24px var(--page-inline);
  }

  .light-table__track {
    display: flex;
    gap: 50px;
    overflow: auto;
    align-items: center;
    padding: 20px 0;
  }

  .light-table__work {
    display: block;
    width: clamp(150px,calc(var(--work-height) * var(--work-ratio)),560px);
    flex-shrink: 0;
    color: inherit;
    text-decoration: none;
  }

  figure {
    margin: 0;
  }

  figure img {
    width: 100%;
    height: auto;
    max-height: var(--work-height);
    object-fit: contain;
    background: transparent;
    box-shadow: 0 25px 65px #0006;
    user-select: none;
    border: 1px solid #ffffff20;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    color: #bfb4c5;
    font-size: .75rem;
  }

  figcaption > span:first-child {
    font: .6rem var(--font-mono);
    color: #e7c5d9;
  }

  figcaption > span:nth-child(2) {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .is-ready .light-table__stage {
    height: 570px;
    perspective: 1600px;
    touch-action: pan-y;
    cursor: grab;
  }

  .is-ready .light-table__track {
    position: absolute;
    inset: 0;
    overflow: visible;
    transform-style: preserve-3d;
  }

  .is-ready .light-table__work {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%) translateX(var(--work-x)) translateZ(calc(var(--distance) * -100px)) rotateY(calc(var(--offset) * -8deg));
    filter: brightness(calc(1 - var(--distance) * .12));
    transition: transform 650ms var(--ease-art),filter 500ms;
  }

  .is-ready .light-table__work[data-active="true"] figcaption {
    color: #eee4f0;
  }

  .is-dragging .light-table__work {
    transition: none;
  }

  .is-dragging .light-table__stage {
    cursor: grabbing;
  }

  .light-table__pool {
    display: none;
    position: absolute;
    width: min(75vw,900px);
    height: 90px;
    bottom: 15px;
    left: 50%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(ellipse,#d9bddb14,transparent 68%);
    pointer-events: none;
  }

  .is-ready .light-table__pool {
    display: block;
  }

  .light-table__footer {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-top: 24px;
    border-top: 1px solid #c1b7c833;
  }

  .light-table__footer p {
    margin: 0;
    color: #bfb4c5;
    font: .78rem/1.8 var(--font-mono);
  }

  .light-table__position {
    margin-left: auto!important;
  }

  .light-table__controls:not([hidden]) {
    display: flex;
    gap: 12px;
  }

  button {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid #c1b7c85c;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background 200ms,color 200ms;
  }

  button: hover {
    background: #dec4d8;
    color: #241c2b;
  }

  button: disabled {
    opacity: .3;
    cursor: default;
  }

  @media (max-width:760px) {
    .light-table {
      padding-top: 80px;
    }

    .light-table__heading {
      grid-template-columns: 1fr auto;
      gap: 26px;
    }

    .light-table__heading > p {
      display: none;
    }

    h2 {
      font-size: clamp(2.7rem,10vw,4.5rem);
    }

    .light-table__heading > a {
      font-size: .8rem;
      gap: 8px;
    }

    .light-table__stage {
      --work-height: 330px;
    }

    .light-table__work {
      max-width: 75vw;
    }

    .is-ready .light-table__stage {
      height: 470px;
    }

    .light-table__hint {
      display: none;
    }

    .light-table__position {
      margin-left: 0!important;
      margin-right: auto!important;
    }

  }

  @media (prefers-reduced-motion:reduce) {
    .is-ready .light-table__work {
      transition: none;
    }

  }
</style>
