---
import { Image } from "astro:assets";
import { ArrowDown } from "@lucide/astro";
import room from "../../assets/art/voyage-atrium.webp";
import type { GalleryEntry } from "../../types/gallery";
interface Props { items: GalleryEntry[] }
const { items } = Astro.props;
const windows = items.filter(item => item.kind === "image").slice(0,3);
const display = [windows[0], windows[1], windows[2]].filter(Boolean);
---
<header class="gallery-passage" data-gallery-passage>
  <div class="gallery-passage__stage">
    <div class="gallery-passage__room" aria-hidden="true"><Image src={room} alt="" widths={[960,1440,1672]} sizes="100vw" loading="eager" /></div>
    <div class="gallery-passage__windows" aria-hidden="true">
      {display.map((item,index) => <figure class:list={["gallery-passage__window",`gallery-passage__window--${index}`]}><img src={item.src} width={item.width} height={item.height} alt="" loading="eager" decoding="async" /><div></div></figure>)}
    </div>
    <fieldset class="gallery-passage__modes" data-scene-content>
        <legend class="visually-hidden">选择观看方式</legend>
        <label><input type="radio" name="gallery-mode" value="browse" checked /><span><b>浏览</b><small>BROWSE</small></span></label>
        <label><input type="radio" name="gallery-mode" value="exhibition" /><span><b>展览</b><small>EXHIBITION</small></span></label>
      </fieldset>
    <div class="gallery-passage__copy page-width">
      <p>COLLECTION / {String(items.length).padStart(3,"0")}</p>
      <h1>画廊<span>。</span></h1>
      <p>收藏那些，曾让目光停留的瞬间。</p>
    </div>
    <a class="gallery-passage__continue" data-scene-content href="#gallery-collection"><span data-gallery-entry-label>向下，随目光漫游</span> <ArrowDown size={17} aria-hidden="true" /></a>
    <span class="gallery-passage__side-note" aria-hidden="true">A WALK THROUGH THE COLLECTION</span>
  </div>
</header>
<script>
  import { scrollScene, pinnedProgress, ease } from "./scroll-scene";
  document.querySelectorAll<HTMLElement>("[data-gallery-passage]").forEach(root => {
    if (location.hash.startsWith("#work=")) {
      root.hidden = true;
      document.body.dataset.galleryDirect = "true";
      const header = document.querySelector<HTMLElement>(".site-header");
      if (header) header.dataset.variant = "reading";
      return;
    }
    scrollScene(root, pinnedProgress, progress => {
      const p = ease(progress);
      root.querySelector<HTMLAnchorElement>(".gallery-passage__continue")!.inert = p > .8;
      root.querySelector<HTMLElement>(".gallery-passage__modes")!.inert = p > .8;
      root.style.setProperty("--passage-open", String(p));
      root.style.setProperty("--passage-side-x", `${p * 36}vw`);
      root.style.setProperty("--passage-side-angle", `${p * 65}deg`);
      root.style.setProperty("--passage-side-opacity", String(1 - ease((p - .55) / .45)));
      root.style.setProperty("--passage-middle-width", `${54 + p * 46}vw`);
      root.style.setProperty("--passage-middle-height", `${64 + p * 36}%`);
      root.style.setProperty("--passage-middle-top", `${20 * (1 - p)}%`);
      root.style.setProperty("--passage-copy-y", `${-p * 95}px`);
      root.style.setProperty("--passage-copy-opacity", String(1 - ease((p - .12) / .65)));
    }, root.querySelector<HTMLElement>(".gallery-passage__stage")!);
  });
</script>
<style>
  .gallery-passage {
    position: relative;
    background: var(--paper-rose,var(--color-bg));
  }

  .gallery-passage__stage {
    position: relative;
    min-height: 650px;
    height: 90svh;
    overflow: hidden;
    isolation: isolate;
  }

  .gallery-passage__room {
    position: absolute;
    z-index: -3;
    inset: 0;
  }

  .gallery-passage__room :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .72;
  }

  :global([data-theme="dark"]) .gallery-passage__room :global(img) {
    filter: brightness(.3) saturate(.8);
  }

  .gallery-passage__windows {
    position: absolute;
    inset: 0;
    perspective: 1400px;
  }

  .gallery-passage__window {
    position: absolute;
    overflow: hidden;
    margin: 0;
    box-shadow: 0 20px 50px #30233a24;
  }

  .gallery-passage__window img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-passage__window--0 {
    left: 3%;
    top: 16%;
    width: 17%;
    height: 70%;
    border-radius: 180px 180px 2px 2px;
  }

  .gallery-passage__window--1 {
    left: 50%;
    translate: -50% 0;
    top: 20%;
    width: 54%;
    height: 64%;
    border-radius: 8px;
  }

  .gallery-passage__window--2 {
    right: 3%;
    top: 16%;
    width: 17%;
    height: 70%;
    border-radius: 180px 180px 2px 2px;
  }

  .gallery-passage__window--1 > div {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,#17142110,#17142130 35%,#171421ae);
  }

  .gallery-passage__copy {
    position: absolute;
    z-index: 2;
    top: 40%;
    left: 0;
    right: 0;
    color: #fff;
    text-align: center;
  }

  .gallery-passage__copy > p:first-child {
    margin: 0 0 24px;
    font: .7rem var(--font-mono);
    letter-spacing: .18em;
  }

  h1 {
    margin: 0;
    font: 400 clamp(5rem,8vw,8rem)/1.15 var(--font-reading);
    letter-spacing: .08em;
    text-indent: .08em;
  }

  h1 > span {
    font-size: .55em;
    color: #efd4e4;
  }

  .gallery-passage__copy > p:nth-child(3) {
    margin: 24px 0 0;
    font: 1rem/1.9 var(--font-reading);
  }

  .gallery-passage__continue {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 20px;
    bottom: 28px;
    left: var(--page-inline);
    color: var(--color-ink);
    min-height: 44px;
    text-decoration: none;
    font-size: .75rem;
  }

  .gallery-passage__side-note {
    position: absolute;
    bottom: 44px;
    right: var(--page-inline);
    color: var(--color-muted);
    font: .6rem var(--font-mono);
    letter-spacing: .1em;
  }

  .gallery-passage[data-scene-ready] {
    height: calc(var(--scene-height, 100svh) + 55svh);
  }

  [data-scene-ready] .gallery-passage__stage {
    position: sticky;
    top: min(0px, calc(100svh - var(--scene-height, 100svh)));
    height: 100svh;
  }

  [data-scene-ready] .gallery-passage__window--0 {
    transform: translateX(calc(-1 * var(--passage-side-x,0vw))) rotateY(var(--passage-side-angle,0deg));
    opacity: var(--passage-side-opacity,1);
    transform-origin: left center;
  }

  [data-scene-ready] .gallery-passage__window--2 {
    transform: translateX(var(--passage-side-x,0vw)) rotateY(calc(-1 * var(--passage-side-angle,0deg)));
    opacity: var(--passage-side-opacity,1);
    transform-origin: right center;
  }

  [data-scene-ready] .gallery-passage__window--1 {
    top: var(--passage-middle-top,20svh);
    width: var(--passage-middle-width,54vw);
    height: var(--passage-middle-height,64svh);
  }

  [data-scene-ready] .gallery-passage__copy {
    transform: translateY(var(--passage-copy-y,0px));
    opacity: var(--passage-copy-opacity,1);
  }

  [data-scene-ready] .gallery-passage__continue, [data-scene-ready] .gallery-passage__side-note, [data-scene-ready] .gallery-passage__modes {
    opacity: var(--passage-copy-opacity,1);
  }

  .gallery-passage__modes {
    position: absolute;
    z-index: 4;
    top: clamp(86px, 11svh, 128px);
    left: 50%;
    translate: -50% 0;
    display: flex;
    width: max-content;
    max-width: calc(100% - 2 * var(--page-inline));
    gap: 24px;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-ink);
  }
  .gallery-passage__modes label { cursor: pointer; position: relative; }
  .gallery-passage__modes input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .gallery-passage__modes label > span { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 8px 18px; border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent); color: var(--color-muted); transition: color .2s; }
  .gallery-passage__modes label > span::after { content: ""; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: var(--color-rose); transform: scaleX(0); transition: transform .25s var(--ease-art); }
  .gallery-passage__modes b { font-size: .8rem; font-weight: 500; letter-spacing: .12em; white-space: nowrap; }
  .gallery-passage__modes small { font: .53rem var(--font-mono); letter-spacing: .08em; opacity: .75; }
  .gallery-passage__modes input:checked + span { color: var(--color-rose); }
  .gallery-passage__modes input:checked + span::after { transform: scaleX(1); }
  .gallery-passage__modes input:focus-visible + span { outline: 2px solid var(--color-focus); outline-offset: 4px; }
  :global(body[data-gallery-mode="exhibition"]) .gallery-passage__room { filter: hue-rotate(15deg); }
  :global(html:not(.js)) .gallery-passage__modes { display: none; }
  @media (max-width: 700px) {
    .gallery-passage__stage { min-height: 620px; }
    .gallery-passage__copy { top: 38%; }
    .gallery-passage__modes { gap: 16px; }
    .gallery-passage__modes label > span { gap: 10px; padding-inline: 12px; }
    .gallery-passage__window--1 { top: max(150px, 20%); height: 60%; }
    .gallery-passage__side-note { display: none; }
  }
</style>
