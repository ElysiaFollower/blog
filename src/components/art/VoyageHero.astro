---
import { Image } from "astro:assets";
import { ArrowDown, ArrowUpRight } from "@lucide/astro";
import environment from "../../assets/art/voyage-atrium.webp";
import heroDay from "../../assets/demo/hero-day.webp";
import heroNight from "../../assets/demo/hero-night.webp";
// The environment is original; collection illustrations remain independent of the stage.
---

<section class="voyage" data-voyage aria-labelledby="voyage-title">
  <div class="voyage__stage">
    <div class="voyage__environment" aria-hidden="true">
      <Image src={environment} alt="" widths={[960,1440,1672]} sizes="100vw" loading="eager" />
      <div class="voyage__ambient"></div>
    </div>
    <svg class="voyage__window-shadow" aria-hidden="true"><path data-window-shadow /></svg>
    <div class="voyage__window" aria-hidden="true">
      <Image class="voyage__day" src={heroDay} alt="" widths={[960,1440,1920,2560]} sizes="100vw" loading="eager" fetchpriority="high" data-hero-theme="light" />
      <Image class="voyage__night" src={heroNight} alt="" widths={[960,1440,1942]} sizes="100vw" loading="eager" data-hero-theme="dark" />
      <div class="voyage__glass"></div>
    </div>
    <div class="voyage__copy">
      <p class="voyage__eyebrow"><span></span> 研究 · 创作 · 日常</p>
      <h1 id="voyage-title"><small>17号的</small><span>航行</span><span class="voyage__last-line">日志</span></h1>
      <p class="voyage__intro">记录研究，收藏光影<br />也留下一些天马行空的念头</p>
      <a class="voyage__read" href="/posts/">翻阅日志 <ArrowUpRight size={18} aria-hidden="true" /></a>
    </div>
    <div class="voyage__statement" aria-hidden="true"><span>漫步星海，</span><span>收拢记忆回响。</span></div>
    <div class="voyage__caption" aria-hidden="true"><span>DAYDREAM / 0017</span><span class="voyage__day">夏日，与她们。</span><span class="voyage__night">成为这个世界的「玩家」吧！</span></div>
    <div class="voyage__footer">
      <a href="#recent-posts"><span class="voyage__prompt-start">向下，展开这一页</span><span class="voyage__prompt-end">继续，翻到文字</span><ArrowDown size={15} aria-hidden="true" /></a>
      <span class="voyage__coordinates" aria-hidden="true">RESEARCH · ART · LIFE</span>
      <div class="voyage__progress" aria-hidden="true"><span></span></div>
    </div>
  </div>
</section>
<script>
  import { mountVoyage } from "./voyage-hero";
  document.querySelectorAll<HTMLElement>("[data-voyage]").forEach(mountVoyage);
</script>
<style>
  .voyage {
    --image-inset: 30vw;
    position: relative;
    background: var(--color-bg);
  }

  .voyage[data-enhanced] {
    height: calc(var(--scene-height, 100svh) + 90svh);
  }

  .voyage__stage {
    position: sticky;
    top: min(0px, calc(100svh - var(--scene-height, 100svh)));
    height: 100svh;
    min-height: 700px;
    overflow: hidden;
    isolation: isolate;
  }

  .voyage__environment {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: radial-gradient(ellipse at 77% 35%,#d8c5da,transparent 50%),linear-gradient(155deg,#f3efea 15%,#ebe5ee 65%,#d9d2e2);
  }

  .voyage__environment :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global([data-theme="dark"]) .voyage__environment :global(img) {
    filter: brightness(.25) saturate(.8);
  }

  .voyage__ambient {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg,#f6f2ee70,transparent 80%);
  }

  :global([data-theme="dark"]) .voyage__ambient {
    background: linear-gradient(100deg,#14152175,#24132b35);
  }

  :global([data-theme="dark"]) .voyage__environment {
    background: radial-gradient(ellipse at 78% 38%,#49324b,transparent 56%),linear-gradient(155deg,#161820,#30273c);
  }

  .voyage__window-shadow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    filter: drop-shadow(12px 22px 28px #34263b38);
  }

  .voyage__window-shadow path {
    fill: #e6dce5;
    stroke: #fff8;
    stroke-width: 2;
  }

  :global([data-theme="dark"]) .voyage {
    --image-inset: 10vw;
  }

  .voyage__window {
    position: absolute;
    inset: 0;
    clip-path: inset(var(--window-top,13%) var(--window-right,6%) var(--window-bottom,15%) var(--window-left,55%) round var(--window-radius,240px) var(--window-radius,240px) 4px 4px);
    filter: drop-shadow(0 24px 35px #30253a35);
  }

  .voyage__window img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateX(calc(var(--image-inset) * var(--image-shift-progress,1))) scale(var(--image-scale,1.06));
    transform-origin: 75% 45%;
  }

  .voyage__glass {
    position: absolute;
    inset: 0;
    background: linear-gradient(130deg,#ffffff30,transparent 38%),linear-gradient(0deg,rgb(14 12 28 / var(--veil,.06)),transparent 90%);
  }

  .voyage__night {
    display: none;
  }

  :global([data-theme="dark"]) .voyage__day {
    display: none;
  }

  :global([data-theme="dark"]) .voyage__night {
    display: block;
  }

  .voyage__copy {
    position: absolute;
    z-index: 2;
    top: 19%;
    left: max(var(--page-inline),calc((100vw - 1240px)/2));
    width: 48%;
    opacity: var(--copy-opacity,1);
    transform: translateY(var(--copy-y,0px));
  }

  .voyage__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 30px;
    font-size: .72rem;
    letter-spacing: .12em;
    color: var(--color-muted);
  }

  .voyage__eyebrow > span {
    width: 23px;
    height: 1px;
    background: var(--color-rose);
  }

  h1 {
    margin: 0;
    font-family: var(--font-reading);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -.05em;
  }

  h1 small {
    display: block;
    margin: 0 0 20px 6px;
    font-size: clamp(1.2rem,2vw,1.8rem);
    font-weight: 400;
    letter-spacing: .2em;
  }

  h1 > span {
    display: block;
    font-size: clamp(5rem,9.2vw,9rem);
  }

  .voyage__last-line {
    margin-left: 1em;
  }

  .voyage__intro {
    margin: 25px 0 0 6px;
    color: var(--color-muted);
    font-size: .95rem;
    line-height: 1.95;
  }

  .voyage__read {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    min-height: 48px;
    margin: 20px 0 0 6px;
    border-bottom: 1px solid var(--color-rose);
    font-size: .875rem;
    text-decoration: none;
  }

  .voyage__read svg {
    transition: transform 250ms;
  }

  .voyage__read:hover svg {
    transform: translate(4px,-4px);
  }

  .voyage__statement {
    position: absolute;
    top: calc(42% + max(0px, var(--scene-height, 100svh) - 100svh) * .58);
    left: 9%;
    opacity: var(--statement-opacity,0);
    transform: translateY(var(--statement-y,24px));
    color: #fff;
    font: 400 clamp(2.5rem,5.5vw,5.5rem)/1.35 var(--font-reading);
    text-shadow: 0 3px 40px #211d3850;
    pointer-events: none;
  }

  .voyage__statement span {
    display: block;
  }

  .voyage__caption {
    position: absolute;
    bottom: 9%;
    right: 6%;
    display: grid;
    gap: 8px;
    opacity: var(--copy-opacity,1);
    color: var(--color-ink);
    font-size: .72rem;
    text-align: right;
  }

  .voyage__caption > span:first-child {
    font: .56rem var(--font-mono);
    letter-spacing: .17em;
  }

  .voyage__footer {
    position: absolute;
    bottom: 30px;
    left: max(var(--page-inline),100px);
    right: var(--page-inline);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: var(--color-ink);
  }

  .voyage__footer > a {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 44px;
    font-size: .67rem;
    text-decoration: none;
  }

  .voyage__prompt-end {
    display: none;
  }

  .voyage[data-progressed] .voyage__prompt-start {
    display: none;
  }

  .voyage[data-progressed] .voyage__prompt-end {
    display: inline;
  }

  .voyage__coordinates {
    font: .56rem var(--font-mono);
    letter-spacing: .14em;
  }

  .voyage__progress {
    width: 70px;
    height: 1px;
    background: var(--color-line);
  }

  .voyage__progress > span {
    display: block;
    height: 1px;
    transform: scaleX(var(--voyage-progress,0));
    transform-origin: left;
    background: var(--color-rose);
  }

  .voyage[data-progressed] .voyage__footer {
    color: #fff;
  }

  @media (max-width:760px) {
    .voyage {
      --image-inset: 58vw;
    }

    :global([data-theme="dark"]) .voyage {
      --image-inset: 0vw;
    }

    .voyage[data-enhanced] {
      height: calc(var(--scene-height, 100svh) + 65svh);
    }

    .voyage__stage {
      min-height: 740px;
    }

    .voyage__copy {
      top: 20%;
      width: 60%;
      left: var(--page-inline);
    }

    .voyage__eyebrow {
      font-size: .62rem;
      gap: 8px;
      margin-bottom: 24px;
    }

    h1 > span {
      font-size: clamp(4rem,17vw,7rem);
    }

    h1 small {
      font-size: 1.1rem;
      margin-bottom: 16px;
    }

    .voyage__last-line {
      margin-left: .55em;
    }

    .voyage__intro {
      max-width: calc(56vw - 2 * var(--page-inline));
      font-size: .875rem;
    }

    .voyage__window {
      clip-path: inset(var(--window-top,16%) var(--window-right,-12%) var(--window-bottom,18%) var(--window-left,56%) round var(--window-radius,160px) var(--window-radius,160px) 4px 4px);
    }

    .voyage__caption {
      right: 7%;
      bottom: 13%;
    }

    .voyage__footer {
      left: var(--page-inline);
      bottom: 92px;
    }

    .voyage__coordinates {
      display: none;
    }

    .voyage__statement {
      left: var(--page-inline);
      top: calc(43% + max(0px, var(--scene-height, 100svh) - 100svh) * .57);
      font-size: clamp(2rem,7vw,3.5rem);
    }

  }

  @media (prefers-reduced-motion:reduce) {
    .voyage[data-enhanced] {
      height: auto;
    }

  }
</style>
