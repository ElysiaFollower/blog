---
import { Image } from "astro:assets";
import { ArrowDownRight } from "@lucide/astro";
import { postHref, type PublishedPost } from "../../lib/posts";
interface Props { posts: PublishedPost[] }
const { posts } = Astro.props;
const recent = posts.slice(0,3);
const titleParts = (title: string) => {
  const pause = title.search(/[:：]/);
  return pause < 0 ? [title] : [title.slice(0,pause+1),title.slice(pause+1)];
};
const date = new Intl.DateTimeFormat("zh-CN",{year:"numeric",month:"2-digit",day:"2-digit"});
---
<header class="journal-books" data-journal-books>
  <div class="journal-books__inner page-width">
    <div class="journal-books__introduction">
      <p class="journal-books__eyebrow">ESSAYS & NOTES · {posts.length}</p>
      <h1>文章<span>。</span></h1>
      <p class="journal-books__description">记录研究、工程与日常见闻，<br />落笔成文，皆是老来回首的回忆。</p>
      <a class="journal-books__continue" href="#journal-timeline">沿时间翻阅 <ArrowDownRight size={21} aria-hidden="true" /></a>
    </div>
    <div class="journal-books__display" aria-label="最近三篇文章">
      {recent.map((post,index) => <article class="journal-books__volume" style={`--book-index:${index};--book-angle:${[-9,0,8][index]}deg;--book-depth:${[-13,-3,13][index]}deg;--book-rise:${[20,-20,10][index]}px`}>
        <a class="journal-books__cover" href={postHref(post)} aria-label={`阅读《${post.data.title}》`}>
          <div class="journal-books__picture"><Image src={post.data.cover} alt={post.data.coverAlt} widths={[400,600,800]} sizes="19vw" loading="eager" style={`object-position:${post.data.coverPosition}`} /></div>
        </a>
        <div class="journal-books__label">
          <p><span>{String(index+1).padStart(2,"0")}</span><time datetime={post.data.pubDate.toISOString()}>{date.format(post.data.pubDate)}</time>{post.data.draft && <span>草稿</span>}</p>
          <h2><a href={postHref(post)}>{titleParts(post.data.title).map(part => <span>{part}</span>)}</a></h2>
        </div>
      </article>)}
    </div>
  </div>
</header>
<script>
  import { scrollScene, ease } from "./scroll-scene";
  document.querySelectorAll<HTMLElement>("[data-journal-books]").forEach(root => {
    scrollScene(root, (rect,viewport) => -rect.top / Math.max(rect.height,viewport), p => {
      root.style.setProperty("--books-drift", `${ease(p) * -38}px`);
    });
  });
</script>
<style>
  .journal-books {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg,var(--color-bg),var(--paper-cyan) 62%,var(--color-bg));
  }

  .journal-books__inner {
    display: grid;
    grid-template-columns: .73fr 1.65fr;
    align-items: center;
    gap: 55px;
    padding-block: 40px 38px;
    min-height: 530px;
  }

  .journal-books__eyebrow {
    margin: 0 0 26px;
    color: var(--color-cyan);
    font: .68rem var(--font-mono);
    letter-spacing: .1em;
  }

  .journal-books h1 {
    margin: 0 0 27px;
    font: 400 clamp(4.7rem,7vw,7rem)/1.05 var(--font-reading);
    letter-spacing: -.06em;
    white-space: nowrap;
  }

  .journal-books h1 > span {
    color: var(--color-cyan);
    font-size: .5em;
  }

  .journal-books__description {
    max-width: 25em;
    margin: 0;
    color: var(--color-muted);
    font: .9rem/1.95 var(--font-reading);
  }

  .journal-books__continue {
    display: inline-flex;
    align-items: center;
    gap: 32px;
    min-height: 44px;
    margin-top: 28px;
    color: var(--color-cyan);
    text-decoration: none;
    font-size: .8rem;
  }

  .journal-books__display {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 27px;
    perspective: 1500px;
    padding: 42px 12px 0;
  }

  .journal-books__volume {
    min-width: 0;
    transform: translateY(calc(var(--book-rise) + var(--books-drift,0px) * (var(--book-index) + 1) / 3));
  }

  .journal-books__cover {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: .73;
    transform: rotate(var(--book-angle)) rotateY(var(--book-depth));
    transform-origin: 50% 90%;
    transition: transform 400ms var(--ease-art);
    box-shadow: 12px 23px 30px #233f382b;
  }

  .journal-books__cover::before {
    content: "";
    position: absolute;
    inset: 5px -6px -5px 6px;
    border: 1px solid #d5d2c5;
    background: repeating-linear-gradient(90deg,#f8f6ee 0 1px,#dcd9cc 1px 2px);
    box-shadow: 1px 2px 0 #c6c3b6;
  }

  .journal-books__picture {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 2px 3px 3px 2px;
    background: var(--paper-white);
    box-shadow: inset 4px 0 6px #0002;
  }

  .journal-books__picture::after {
    position: absolute;
    content: "";
    inset: 0;
    background: linear-gradient(90deg,#0003,#fff2 2%,transparent 5%,transparent 96%,#0002);
    pointer-events: none;
  }

  .journal-books__picture :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .journal-books__cover:hover,.journal-books__cover:focus-visible {
    transform: translateY(-16px) rotate(0deg) rotateY(0deg);
  }

  .journal-books__label {
    position: relative;
    margin-top: 32px;
    padding-top: 17px;
    border-top: 1px solid color-mix(in srgb,var(--color-cyan) 30%,transparent);
  }

  .journal-books__label p {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 10px;
    color: var(--color-cyan);
    font: .63rem var(--font-mono);
  }

  .journal-books__label h2 {
    margin: 0;
    font: 400 1rem/1.65 var(--font-reading);
  }

  .journal-books__label h2 a {
    display: block;
    text-decoration: none;
  }

  .journal-books__label h2 a > span {
    display: block;
    text-wrap: balance;
  }

  .journal-books__label h2 a > span + span {
    font-size: .95em;
  }

  .journal-books__label h2 a:hover {
    color: var(--color-cyan);
  }

  @media (max-width:1023px) {
    .journal-books__inner {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .journal-books__display {
      max-width: 760px;
    }

  }

  @media (prefers-reduced-motion:reduce) {
    .journal-books__cover {
      transition: none;
    }

  }
</style>
