---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import {
  ArrowDownRight,
  ArrowUpRight,
  BookOpenText,
  CircleUserRound,
  Images,
  Radio,
  Star,
} from "@lucide/astro";
import heroDay from "../../assets/demo/hero-day.webp";
import heroNight from "../../assets/demo/hero-night.webp";
import memoryPortrait from "../../assets/demo/elysia-portrait.webp";
import ArticleCard from "../ArticleCard.astro";
import DirectedPointer from "../DirectedPointer.astro";
import MusicDock from "../MusicDock.astro";
import OpeningSequence from "../OpeningSequence.astro";
import QuoteLoop from "../QuoteLoop.astro";
import ScrollReveal from "../ScrollReveal.astro";
import SiteHeader from "../SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

import {siteConfig} from "../../config/site.ts";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);


// =============================================================================
// 首页【03 / 内容频道入口】板块的 3 个卡片配置
// 对应页面上的：01 航行日志 | 02 珍藏画册 | 03 关于我
// =============================================================================
const channels = [
  {
    index: "01",
    label: "WRITING",
    title: "航行日志",
    description: "零散随笔、日常折腾，留下天马行空的诳语",
    href: "/posts/",
    icon: BookOpenText,
    accent: "cyan",
  },
  {
    index: "02",
    label: "GALLERY",
    title: "珍藏画册",
    description: "喜欢的角色、动人的笔触，拾掇邂逅的点滴光影",
    href: "/gallery/",
    icon: Images,
    accent: "rose",
  },
  {
    index: "03",
    label: "ABOUT ME",
    title: "关于我",
    description: "一个相信童话的妄想家",
    href: "/about/",
    icon: CircleUserRound,
    accent: "gold",
  },
] as const;
---

<BaseLayout
  description={siteConfig.description}
  bodyClass="hybrid-page"
  directedPointer
>
  <SiteHeader variant="overlay" />
  <main id="main-content">
    <section class="hybrid-hero" aria-labelledby="hybrid-title">
      <div class="hybrid-hero__art" aria-hidden="true">
        <Image
          class="hybrid-hero__day"
          src={heroDay}
          alt=""
          widths={[960, 1440, 1920, 2560]}
          sizes="100vw"
          loading="lazy"
          fetchpriority="high"
          data-hero-theme="light"
        />
        <Image
          class="hybrid-hero__night"
          src={heroNight}
          alt=""
          widths={[960, 1440, 1942]}
          sizes="100vw"
          loading="lazy"
          fetchpriority="high"
          data-hero-theme="dark"
        />
      </div>
      <div class="hybrid-hero__shade" aria-hidden="true"></div>
      <div class="hybrid-hero__frame" aria-hidden="true"></div>

      <div class="hybrid-hero__rail" aria-hidden="true">
        <span>TECH</span>
        <span>MEDIA</span>
        <span>MEMORY</span>
      </div>

      <div class="hybrid-hero__content page-width">
        <div class="hybrid-hero__copy">
          <div class="hybrid-hero__signal">
            <Radio aria-hidden="true" size={17} stroke-width={1.8} />
            <span>LOG 0017</span>
          </div>
          <h1 id="hybrid-title">
            <span>17号的</span>
            <span>航行日志</span>
          </h1>
          <p class="hybrid-hero__intro">
            漫步星海，收拢记忆回响
          </p>
          <a class="hybrid-hero__action" href="/posts/">
            <span>翻阅航行记录</span>
            <ArrowDownRight aria-hidden="true" size={20} stroke-width={2} />
          </a>
        </div>

        <div class="hybrid-hero__quote">
          <Star aria-hidden="true" size={16} fill="currentColor" />
          <QuoteLoop prefix="ARCHIVE" />
        </div>
      </div>

      <div class="hybrid-hero__footer">
        <span>SCROLL TO EXPLORE</span>
        <span>UTC+8</span>
      </div>
    </section>

    <section class="hybrid-feed">
      <div class="hybrid-feed__inner page-width">
        <header class="hybrid-feed__header" data-reveal>
          <div>
            <span class="hybrid-feed__tag">02 / RECENT POSTS</span>
            <h2 class="hybrid-feed__title">新近落笔</h2>
          </div>
          <a href="/posts/" class="hybrid-feed__more">
            <span>查看更多</span>
            <ArrowUpRight class="hybrid-feed__more-icon" aria-hidden="true" size={15} stroke-width={2} />
          </a>
        </header>

        <div class="hybrid-feed__layout" data-reveal data-reveal-delay="1">
          <ArticleCard post={posts[0]} eager />
          <div class="hybrid-feed__stack">
            {
              posts.slice(1).map((post) => (
                <ArticleCard post={post} variant="compact" />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="hybrid-channels" aria-labelledby="channels-title">
      <div class="page-width">
        <header class="hybrid-channels__header" data-reveal>
          <span>03 / CHANNEL INDEX</span>
          <h2 id="channels-title">
            <span>星光落处</span><br />皆可漫游
          </h2>
          <p>
            欢迎来到我的小天地，虽然没什么好东西可以招待，但若不嫌弃，请随意逛逛
          </p>
        </header>

        <nav class="hybrid-channels__list" aria-label="内容频道">
          {
            channels.map((channel, index) => {
              const Icon = channel.icon;
              return (
                <a
                  href={channel.href}
                  data-accent={channel.accent}
                  data-reveal
                  data-reveal-delay={String(Math.min(index, 2))}
                >
                  <span class="hybrid-channels__index">{channel.index}</span>
                  <span class="hybrid-channels__icon">
                    <Icon aria-hidden="true" size={22} stroke-width={1.6} />
                  </span>
                  <span class="hybrid-channels__copy">
                    <small>{channel.label}</small>
                    <strong>{channel.title}</strong>
                  </span>
                  <span class="hybrid-channels__description">
                    {channel.description}
                  </span>
                  <ArrowUpRight
                    class="hybrid-channels__arrow"
                    aria-hidden="true"
                    size={24}
                    stroke-width={1.7}
                  />
                </a>
              );
            })
          }
        </nav>
      </div>
    </section>

    <section class="hybrid-memory" aria-labelledby="memory-title">
      <div class="hybrid-memory__image" data-reveal="left">
        <Image
          src={memoryPortrait}
          alt="花园茶会中的爱莉希雅"
          widths={[540, 810, 1080]}
          sizes="(max-width: 760px) 100vw, 46vw"
          loading="lazy"
        />
      </div>
      <div class="hybrid-memory__copy" data-reveal="right">
        <span>04 / COLLECTION</span>
        <h2 id="memory-title">记忆的回廊</h2>
        <p>
          岁月更迭，人事散尽，过去的心境或许再难寻回；<br />
          记忆终会褪色，唯有画卷里的光影永不模糊。<br />
          于须臾人间，向永恒寻找寄托，旧日的追忆也便有了归处。
        </p>
        <a href="/gallery/">步入回廊 →</a>
      </div>
      <div class="hybrid-memory__stamp" aria-hidden="true">
        KEEP<br />THE<br />LIGHT
      </div>
    </section>
  </main>

  <footer class="hybrid-footer">
    <div class="page-width">
      <strong>17号的航行日志</strong>
      <span>PROMETHEUS © 2026</span>
    </div>
  </footer>

  <DirectedPointer />
  <MusicDock />
  <ScrollReveal />
  <OpeningSequence label="少女祈祷中..." code="BROADCAST // 017" />
</BaseLayout>

<style>
  .hybrid-page {
    background: var(--color-bg);
  }

  .hybrid-hero {
    position: relative;
    display: grid;
    height: min(88svh, 900px);
    min-height: 640px;
    overflow: hidden;
    color: #fff;
    isolation: isolate;
  }

  .hybrid-hero__art,
  .hybrid-hero__shade,
  .hybrid-hero__frame {
    position: absolute;
    inset: 0;
  }

  .hybrid-hero__art {
    z-index: -3;
  }

  .hybrid-hero__art :global(img) {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hybrid-hero__night {
    display: none;
  }

  :global([data-theme="dark"]) .hybrid-hero__day {
    display: none;
  }

  :global([data-theme="dark"]) .hybrid-hero__night {
    display: block;
  }

  .hybrid-hero__shade {
    z-index: -2;
    background: rgb(6 12 18 / 26%);
    box-shadow:
      inset 0 -180px 150px rgb(7 10 15 / 40%),
      inset 0 130px 120px rgb(7 10 15 / 22%);
  }

  :global([data-theme="dark"]) .hybrid-hero__shade {
    background: rgb(24 6 12 / 32%);
  }

  .hybrid-hero__frame {
    z-index: 2;
    inset: 86px var(--page-inline) 60px;
    border: 1px solid #ffffff85;
    pointer-events: none;
  }

  .hybrid-hero__frame::before,
  .hybrid-hero__frame::after {
    position: absolute;
    width: 58px;
    height: 10px;
    background: #ff76a4;
    content: "";
  }

  .hybrid-hero__frame::before {
    top: -5px;
    left: 18%;
  }

  .hybrid-hero__frame::after {
    right: 12%;
    bottom: -5px;
    background: #75d4d2;
  }

  .hybrid-hero__rail {
    position: absolute;
    z-index: 4;
    top: 50%;
    left: calc(var(--page-inline) - 12px);
    display: flex;
    gap: 22px;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    font-weight: 850;
    transform: translate(-50%, -50%) rotate(-90deg);
  }

  .hybrid-hero__content {
    position: relative;
    z-index: 3;
    display: grid;
    padding-top: 74px;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.52fr);
    align-items: center;
    gap: 40px;
  }

  .hybrid-hero__copy {
    justify-self: end;
    width: min(100%, 620px);
    text-align: left;
  }

  :global([data-theme="dark"]) .hybrid-hero__copy {
    justify-self: start;
  }

  .hybrid-hero__signal {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 8px;
    padding: 6px 9px;
    margin-bottom: 18px;
    background: #75d4d2;
    color: #17161a;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 850;
  }

  .hybrid-hero h1 {
    margin: 0;
    font-size: clamp(4.2rem, 8.6vw, 8.5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: 0;
    text-shadow: 0 3px 28px rgb(0 0 0 / 36%);
  }

  .hybrid-hero h1 span {
    display: table;
  }

  .hybrid-hero h1 span:last-child {
    padding: 4px 12px 9px;
    margin-top: 6px;
    background: #f7f2f4;
    box-shadow: 8px 8px 0 #ff76a4;
    color: #17161a;
    text-shadow: none;
    transform: translateX(4%);
  }

  .hybrid-hero__intro {
    max-width: 480px;
    margin: 28px 0 0;
    font-weight: 650;
    line-height: 1.7;
    text-shadow: 0 2px 18px rgb(0 0 0 / 56%);
  }

  .hybrid-hero__action {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0 7px;
    margin-top: 24px;
    border-bottom: 3px solid #fff;
    color: #fff;
    font-weight: 850;
    text-decoration: none;
    text-shadow: 0 2px 12px rgb(0 0 0 / 48%);
  }

  .hybrid-hero__action:hover {
    color: #ffb0c9;
  }

  .hybrid-hero__quote {
    align-self: end;
    padding: 20px 0 88px;
    color: #fff;
    text-shadow: 0 2px 18px rgb(0 0 0 / 62%);
  }

  .hybrid-hero__quote > :global(svg) {
    margin-bottom: 12px;
    color: #f0c15a;
  }

  .hybrid-hero__quote :global(.quote-loop__index) {
    color: #75d4d2;
  }

  .hybrid-hero__footer {
    position: absolute;
    z-index: 4;
    right: calc(var(--page-inline) + 16px);
    bottom: 36px;
    left: calc(var(--page-inline) + 16px);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 800;
  }

  .hybrid-feed {
    padding-block: clamp(78px, 11vw, 142px);
    background: color-mix(in srgb, var(--color-bg) 95%, var(--color-cyan) 5%);
  }

  .hybrid-feed__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 44px;
  }

  .hybrid-feed__tag {
    display: block;
    margin-bottom: 8px;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 850;
  }

  .hybrid-feed__title {
    margin: 0;
    font-family: var(--font-reading);
    font-size: clamp(2.15rem, 5vw, 4.3rem);
    line-height: 1.12;
  }

  .hybrid-feed__more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-muted);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hybrid-feed__more-icon {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hybrid-feed__more:hover {
    color: var(--color-foreground);
  }

  .hybrid-feed__more:hover .hybrid-feed__more-icon {
    transform: translate(3px, -3px);
  }

  .hybrid-feed__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.8fr);
    gap: 24px;
  }

  .hybrid-feed__stack {
    display: grid;
    gap: 24px;
  }

  .hybrid-channels {
    padding-block: clamp(88px, 12vw, 156px);
    background: #17151a;
    color: #fff;
  }

  .hybrid-channels__header {
    display: grid;
    margin-bottom: clamp(58px, 8vw, 92px);
    grid-template-columns: minmax(420px, 0.95fr) minmax(380px, 1.05fr);
    align-items: end;
    gap: 18px clamp(52px, 8vw, 120px);
  }

  .hybrid-channels__header > span {
    grid-column: 1 / -1;
    color: #75d4d2;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .hybrid-channels__header h2 {
    margin: 0;
    font-family: var(--font-reading);
    font-size: clamp(3.1rem, 6vw, 5.4rem);
    line-height: 1;
  }

  .hybrid-channels__header h2 span {
    white-space: nowrap;
  }

  .hybrid-channels__header p {
    max-width: 560px;
    margin: 0 0 8px;
    color: #bcb3b9;
    line-height: 1.9;
  }

  .hybrid-channels__list {
    display: grid;
    border-top: 1px solid #ffffff3d;
  }

  .hybrid-channels__list > a {
    position: relative;
    display: grid;
    min-height: 150px;
    padding: 26px 10px;
    grid-template-columns: 52px 48px minmax(210px, 0.82fr) minmax(300px, 1.18fr) auto;
    align-items: center;
    gap: 20px;
    border-bottom: 1px solid #ffffff3d;
    color: inherit;
    text-decoration: none;
  }

  .hybrid-channels__list > a::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: #75d4d2;
    content: "";
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 260ms ease;
  }

  .hybrid-channels__list > a[data-accent="rose"]::before {
    background: #ff78a5;
  }

  .hybrid-channels__list > a[data-accent="gold"]::before {
    background: #efbd43;
  }

  .hybrid-channels__list > a:hover::before {
    transform: scaleY(1);
  }

  .hybrid-channels__index,
  .hybrid-channels__copy small {
    color: #9f969c;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .hybrid-channels__icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid #ffffff57;
  }

  .hybrid-channels__copy {
    display: grid;
    gap: 5px;
  }

  .hybrid-channels__copy strong {
    font-family: var(--font-reading);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.2;
  }

  .hybrid-channels__description {
    max-width: 520px;
    color: #bcb3b9;
    font-size: 0.9rem;
    line-height: 1.75;
  }

  .hybrid-channels__arrow {
    transition: transform 200ms ease;
  }

  .hybrid-channels__list > a:hover .hybrid-channels__arrow {
    color: #ff91b4;
    transform: translate(4px, -4px);
  }

  .hybrid-memory {
    position: relative;
    display: grid;
    min-height: 680px;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    background: #17151a;
    color: #fff;
    overflow: hidden;
  }

  .hybrid-memory__image {
    min-height: 680px;
    overflow: hidden;
  }

  .hybrid-memory__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  .hybrid-memory__copy {
    display: flex;
    max-width: 640px;
    padding: clamp(54px, 8vw, 112px);
    flex-direction: column;
    justify-content: center;
  }

  .hybrid-memory__copy > span {
    color: #75d4d2;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .hybrid-memory__copy h2 {
    max-width: 9ch;
    margin: 18px 0 24px;
    font-size: clamp(2.9rem, 5.4vw, 5rem);
    line-height: 0.98;
  }

  .hybrid-memory__copy p {
    max-width: 480px;
    margin: 0;
    color: #cfc4ca;
    line-height: 1.85;
  }

  .hybrid-memory__copy a {
    width: max-content;
    margin-top: 28px;
    color: #ff8db3;
    font-weight: 800;
    text-decoration: none;
  }

  .hybrid-memory__stamp {
    position: absolute;
    right: 4vw;
    bottom: 36px;
    padding: 11px 14px;
    border: 3px solid #17161a;
    background: #f0c15a;
    color: #17161a;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 900;
    line-height: 1.05;
    transform: rotate(-7deg);
  }

  .hybrid-footer {
    padding: 32px 0 96px;
    border-top: 1px solid var(--color-line);
  }

  .hybrid-footer > div {
    display: flex;
    justify-content: space-between;
    gap: 22px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  @media (max-width: 900px) {
    .hybrid-hero__content {
      grid-template-columns: 1fr;
      align-items: end;
      padding-bottom: 92px;
    }

    .hybrid-hero__copy,
    :global([data-theme="dark"]) .hybrid-hero__copy {
      align-self: end;
      justify-self: start;
    }

    .hybrid-hero__quote {
      display: none;
    }

    .hybrid-feed__layout {
      grid-template-columns: 1fr;
    }

    .hybrid-channels__header {
      grid-template-columns: 1fr;
    }

    .hybrid-channels__list > a {
      grid-template-columns: 44px 48px minmax(180px, 0.8fr) minmax(220px, 1.2fr) auto;
      gap: 14px;
    }

    .hybrid-memory {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .hybrid-memory__image {
      min-height: 540px;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 600px) {
    .hybrid-hero {
      height: 84svh;
      min-height: 610px;
    }

    .hybrid-hero__art :global(img) {
      object-position: 43% center;
    }

    :global([data-theme="dark"]) .hybrid-hero__art :global(img) {
      object-position: 60% center;
    }

    .hybrid-hero__frame {
      inset: 74px 14px 46px;
    }

    .hybrid-hero__rail {
      display: none;
    }

    .hybrid-hero__content {
      padding-bottom: 74px;
    }

    .hybrid-hero h1 {
      font-size: clamp(3.5rem, 16vw, 5.6rem);
    }

    .hybrid-hero__intro {
      max-width: 300px;
      font-size: 0.86rem;
    }

    .hybrid-hero__footer {
      right: 26px;
      bottom: 25px;
      left: 26px;
    }

    .hybrid-hero__footer span:last-child {
      display: none;
    }

    .hybrid-feed__header {
      display: grid;
    }

    .hybrid-channels__header {
      margin-bottom: 42px;
    }

    .hybrid-channels__header h2 {
      font-size: 2.85rem;
    }

    .hybrid-channels__list > a {
      min-height: 0;
      padding-block: 24px;
      grid-template-columns: 34px minmax(0, 1fr) auto;
      gap: 12px;
    }

    .hybrid-channels__icon {
      display: none;
    }

    .hybrid-channels__description {
      grid-column: 2 / -1;
      font-size: 0.84rem;
    }

    .hybrid-channels__arrow {
      grid-column: 3;
      grid-row: 1;
    }

    .hybrid-memory__image {
      min-height: 430px;
    }

    .hybrid-memory__copy {
      padding: 48px var(--page-inline) 100px;
    }

    .hybrid-memory__stamp {
      right: 20px;
      bottom: 24px;
    }

    .hybrid-footer > div {
      display: grid;
    }
  }
</style>
