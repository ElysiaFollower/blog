---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import {
  ArrowDownRight,
  ArrowUpRight,
  BookOpenText,
  CircleUserRound,
  Images,
  Radio,
  Star,
} from "@lucide/astro";
import heroDay from "../../assets/demo/hero-day.webp";
import heroNight from "../../assets/demo/hero-night.webp";
import ArticleCard from "../ArticleCard.astro";
import DirectedPointer from "../DirectedPointer.astro";
import MusicDock from "../MusicDock.astro";
import ApertureOpening from "../art/ApertureOpening.astro";
import LightTable from "../art/LightTable.astro";
import ArtDirection from "../art/ArtDirection.astro";
import "../art/home.css";
import QuoteLoop from "../QuoteLoop.astro";
import ScrollReveal from "../ScrollReveal.astro";
import SiteHeader from "../SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

import {siteConfig} from "../../config/site.ts";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);


const channels = [
  {
    index: "01",
    label: "WRITING",
    title: "航行日志",
    description: "零散随笔、日常折腾，留下天马行空的诳语",
    href: "/posts/",
    icon: BookOpenText,
    accent: "cyan",
  },
  {
    index: "02",
    label: "GALLERY",
    title: "珍藏画册",
    description: "喜欢的角色、动人的笔触，拾掇邂逅的点滴光影",
    href: "/gallery/",
    icon: Images,
    accent: "rose",
  },
  {
    index: "03",
    label: "ABOUT ME",
    title: "关于我",
    description: "一个相信童话的妄想家",
    href: "/about/",
    icon: CircleUserRound,
    accent: "gold",
  },
] as const;
---

<BaseLayout
  description={siteConfig.description}
  bodyClass="hybrid-page"
  directedPointer
>
  <SiteHeader variant="overlay" />
  <main id="main-content">
    <section class="hybrid-hero" aria-labelledby="hybrid-title" data-art-scene>
      <div class="hybrid-hero__art" aria-hidden="true">
        <Image
          class="hybrid-hero__day"
          src={heroDay}
          alt=""
          widths={[960, 1440, 1920, 2560]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          data-hero-theme="light"
        />
        <Image
          class="hybrid-hero__night"
          src={heroNight}
          alt=""
          widths={[960, 1440, 1942]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          data-hero-theme="dark"
        />
      </div>
      <div class="hybrid-hero__shade" aria-hidden="true"></div>
      <div class="hybrid-hero__orbit" aria-hidden="true"><span>017 / A PERSONAL UNIVERSE</span></div>

      <div class="hybrid-hero__rail" aria-hidden="true">
        <span>TECH</span>
        <span>MEDIA</span>
        <span>MEMORY</span>
      </div>

      <div class="hybrid-hero__content page-width">
        <div class="hybrid-hero__copy">
          <div class="hybrid-hero__signal">
            <Radio aria-hidden="true" size={17} stroke-width={1.8} />
            <span>LOG 0017</span>
          </div>
          <h1 id="hybrid-title">
            <span>17号的</span>
            <span>航行日志</span>
          </h1>
          <p class="hybrid-hero__intro">
            漫步星海，收拢记忆回响
          </p>
          <a class="hybrid-hero__action" href="/posts/">
            <span>翻阅航行记录</span>
            <ArrowDownRight aria-hidden="true" size={20} stroke-width={2} />
          </a>
        </div>

        <div class="hybrid-hero__quote">
          <Star aria-hidden="true" size={16} fill="currentColor" />
          <QuoteLoop prefix="ARCHIVE" />
        </div>
      </div>

      <div class="hybrid-hero__footer">
        <a href="#recent-posts">向下翻阅 ↓</a>
        <span>UTC+8</span>
      </div>
    </section>

    <section class="hybrid-feed" id="recent-posts">
      <div class="hybrid-feed__inner page-width">
        <header class="hybrid-feed__header" data-reveal>
          <div>
            <span class="hybrid-feed__tag">02 / RECENT POSTS</span>
            <h2 class="hybrid-feed__title">新近落笔</h2>
          </div>
          <a href="/posts/" class="hybrid-feed__more">
            <span>查看更多</span>
            <ArrowUpRight class="hybrid-feed__more-icon" aria-hidden="true" size={15} stroke-width={2} />
          </a>
        </header>

        <div class="hybrid-feed__layout" data-reveal data-reveal-delay="1">
          <ArticleCard post={posts[0]} eager />
          <div class="hybrid-feed__stack">
            {
              posts.slice(1).map((post) => (
                <ArticleCard post={post} variant="compact" />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="hybrid-channels" aria-labelledby="channels-title">
      <div class="page-width">
        <header class="hybrid-channels__header" data-reveal>
          <span>03 / CHANNEL INDEX</span>
          <h2 id="channels-title">
            <span>星光落处</span><br />皆可漫游
          </h2>
          <p>
            写下的、喜欢的，还有正在琢磨的。随意逛逛。
          </p>
        </header>

        <nav class="hybrid-channels__list" aria-label="内容频道">
          {
            channels.map((channel, index) => {
              const Icon = channel.icon;
              return (
                <a
                  href={channel.href}
                  data-accent={channel.accent}
                  data-reveal
                  data-reveal-delay={String(Math.min(index, 2))}
                >
                  <span class="hybrid-channels__index">{channel.index}</span>
                  <span class="hybrid-channels__icon">
                    <Icon aria-hidden="true" size={22} stroke-width={1.6} />
                  </span>
                  <span class="hybrid-channels__copy">
                    <small>{channel.label}</small>
                    <strong>{channel.title}</strong>
                  </span>
                  <span class="hybrid-channels__description">
                    {channel.description}
                  </span>
                  <ArrowUpRight
                    class="hybrid-channels__arrow"
                    aria-hidden="true"
                    size={24}
                    stroke-width={1.7}
                  />
                </a>
              );
            })
          }
        </nav>
      </div>
    </section>

    <LightTable />
  </main>

  <footer class="hybrid-footer">
    <div class="page-width">
      <strong>17号的航行日志</strong>
      <span>PROMETHEUS © 2026</span>
    </div>
  </footer>

  <DirectedPointer />
  <MusicDock />
  <ScrollReveal />
  <ApertureOpening />
  <ArtDirection />
</BaseLayout>
