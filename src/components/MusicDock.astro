---
import { Music2, Pause, Play } from "@lucide/astro";

const track = {
  title: "Da Capo",
  artist: "HOYO-MiX",
  source:
    "https://pub-afcc413539f94c73959ec3d27d32e67d.r2.dev/Da%20Capo/Da%20Capo.mp3",
};
---

<div class="music-dock" data-music-dock>
  <button
    type="button"
    data-music-toggle
    aria-label={`播放 ${track.title}`}
    title={`播放 ${track.title}`}
  >
    <Play class="music-dock__play" aria-hidden="true" size={18} />
    <Pause class="music-dock__pause" aria-hidden="true" size={18} />
  </button>
  <div class="music-dock__meta">
    <Music2 aria-hidden="true" size={15} stroke-width={1.8} />
    <span>
      <strong>{track.title}</strong>
      <small>{track.artist}</small>
    </span>
  </div>
  <audio preload="none" src={track.source}></audio>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-music-dock]").forEach((dock) => {
    const audio = dock.querySelector<HTMLAudioElement>("audio");
    const button = dock.querySelector<HTMLButtonElement>("[data-music-toggle]");
    if (!audio || !button) return;

    const sync = () => {
      const playing = !audio.paused;
      dock.dataset.playing = String(playing);
      button.setAttribute(
        "aria-label",
        `${playing ? "暂停" : "播放"} Da Capo`,
      );
      button.setAttribute("title", `${playing ? "暂停" : "播放"} Da Capo`);
    };

    button.addEventListener("click", async () => {
      if (audio.paused) {
        await audio.play().catch(() => {});
      } else {
        audio.pause();
      }
      sync();
    });

    audio.addEventListener("play", sync);
    audio.addEventListener("pause", sync);
    audio.addEventListener("ended", sync);
  });
</script>

<style>
  .music-dock {
    position: fixed;
    z-index: 180;
    bottom: max(18px, env(safe-area-inset-bottom));
    left: max(18px, env(safe-area-inset-left));
    display: none;
    min-height: 50px;
    align-items: stretch;
    border: 1px solid #fff5;
    background: #17151ae8;
    box-shadow: 0 12px 30px rgb(0 0 0 / 24%);
    color: #fff;
    backdrop-filter: blur(14px);
  }

  :global(.js) .music-dock {
    display: flex;
  }

  .music-dock button {
    display: grid;
    width: 50px;
    flex: 0 0 50px;
    place-items: center;
    border-right: 1px solid #fff4;
    background: transparent;
    color: #ff8db3;
    cursor: pointer;
  }

  .music-dock button:hover {
    background: #fff1;
  }

  .music-dock__pause,
  .music-dock[data-playing="true"] .music-dock__play {
    display: none;
  }

  .music-dock[data-playing="true"] .music-dock__pause {
    display: block;
  }

  .music-dock__meta {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 13px;
  }

  .music-dock__meta > span {
    display: grid;
    min-width: 92px;
  }

  .music-dock__meta strong,
  .music-dock__meta small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .music-dock__meta strong {
    font-size: 0.75rem;
  }

  .music-dock__meta small {
    color: #c8bdc4;
    font-size: 0.64rem;
  }

  @media (max-width: 620px) {
    .music-dock {
      position: absolute;
      top: 74px;
      right: 166px;
      bottom: auto;
      left: auto;
      min-height: 46px;
    }

    .music-dock button {
      width: 46px;
      flex-basis: 46px;
    }

    .music-dock__meta {
      display: none;
    }
  }
</style>
