---
import type { ImageMetadata } from "astro";
import "../styles/global.css";
import { siteConfig } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  directedPointer?: boolean;
  noIndex?: boolean;
  image?: ImageMetadata | string;
  pageType?: "website" | "article";
}

const {
  title,
  description = siteConfig.description,
  bodyClass = "",
  directedPointer = false,
  noIndex = false,
  image,
  pageType = "website",
} = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const imagePath = typeof image === "string" ? image : image?.src;
const socialImage = imagePath ? new URL(imagePath, siteOrigin) : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fafafd" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.title} RSS`}
      href="/rss.xml"
    />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        if (sessionStorage.getItem("opening-seen")) {
          document.documentElement.classList.add("opening-seen");
        }
        const stored = localStorage.getItem("theme");
        const preferred = matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        document.documentElement.dataset.theme = stored || preferred;
      })();
    </script>
  </head>
  <body
    id="top"
    class={bodyClass}
    data-directed-pointer={directedPointer ? "true" : undefined}
  >
    <a class="skip-link" href="#main-content">跳到正文</a>
    <slot />
  </body>
</html>
