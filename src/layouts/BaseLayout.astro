---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import defaultSocialImage from "../assets/demo/hero-day.webp";
import "../styles/global.css";
import { siteConfig } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  directedPointer?: boolean;
  noIndex?: boolean;
  image?: ImageMetadata | string;
  imageAlt?: string;
  pageType?: "website" | "article";
  publishedDate?: Date;
  updatedDate?: Date;
  tags?: readonly string[];
}

const {
  title,
  description = siteConfig.description,
  bodyClass = "",
  directedPointer = false,
  noIndex = false,
  image,
  imageAlt,
  pageType = "website",
  publishedDate,
  updatedDate,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const resolvedImage = image ?? (noIndex ? undefined : defaultSocialImage);
const resolvedImageAlt =
  imageAlt ?? (resolvedImage ? `${siteConfig.title}首页插画` : undefined);
const optimizedSocialImage =
  resolvedImage && typeof resolvedImage !== "string"
    ? await getImage({
        src: resolvedImage,
        width: 1200,
        height: 630,
        fit: "cover",
        format: "webp",
        quality: 82,
      })
    : undefined;
const imagePath =
  typeof resolvedImage === "string" ? resolvedImage : optimizedSocialImage?.src;
const socialImage = imagePath ? new URL(imagePath, siteOrigin) : undefined;
const structuredData =
  pageType === "article" && publishedDate
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        datePublished: publishedDate.toISOString(),
        dateModified: (updatedDate ?? publishedDate).toISOString(),
        author: {
          "@type": "Person",
          name: siteConfig.author,
          url: new URL("/about/", siteOrigin).toString(),
        },
        mainEntityOfPage: canonicalUrl.toString(),
        image: socialImage?.toString(),
        keywords: tags,
      }
    : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fafafd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17151a" media="(prefers-color-scheme: dark)" />
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.title} RSS`}
      href="/rss.xml"
    />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {
      socialImage && resolvedImageAlt && (
        <meta property="og:image:alt" content={resolvedImageAlt} />
      )
    }
    {
      optimizedSocialImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    {
      pageType === "article" && publishedDate && (
        <meta
          property="article:published_time"
          content={publishedDate.toISOString()}
        />
      )
    }
    {
      pageType === "article" && updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
    {
      pageType === "article" &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {
      socialImage && resolvedImageAlt && (
        <meta name="twitter:image:alt" content={resolvedImageAlt} />
      )
    }
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
        />
      )
    }
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        if (sessionStorage.getItem("opening-seen")) {
          document.documentElement.classList.add("opening-seen");
        }
        const stored = localStorage.getItem("theme");
        const preferred = matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        document.documentElement.dataset.theme = stored || preferred;
      })();
    </script>
  </head>
  <body
    id="top"
    class={bodyClass}
    data-directed-pointer={directedPointer ? "true" : undefined}
  >
    <a class="skip-link" href="#main-content">跳到正文</a>
    <slot />
  </body>
</html>
